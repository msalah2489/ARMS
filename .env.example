NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Must be the classic long JWT «anon public» key from Supabase → Project Settings → API.
# It starts with eyJ and is usually 200+ characters. Short sb_publishable_* values are rejected.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-eyJ...

# Optional server-only key (also a long JWT). Not used by the GitHub Pages client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-eyJ...

# true = sample data only. false = use Supabase when URL + valid anon JWT are set.
# If unset: demo only when Supabase env is missing/invalid.
NEXT_PUBLIC_USE_DEMO=false

# CS-FEATURE — Customer Service diagnostic wizard (default on if unset). Set 0/false/off to hide.
NEXT_PUBLIC_CS_DIAGNOSTIC=1

# Web Push — PUBLIC VAPID key only (safe in the browser build).
# Generate with: npx web-push generate-vapid-keys
# Put the matching PRIVATE key only in Supabase Edge Function secrets (never here).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
