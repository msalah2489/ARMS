@page "/account"
@rendermode InteractiveServer
@using System.Security.Cryptography
@using System.Text
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
<PageTitle>حسابي</PageTitle>
<div class="page-head"><div><h1>حسابي</h1><p>إدارة بيانات المستخدم وكلمة المرور.</p></div></div>
@if(CurrentAccount is not null){
<div class="panel"><div class="section-title">بيانات الحساب</div><div class="form-grid">
<div class="field"><label>اسم المستخدم</label><input value="@CurrentAccount.Username" readonly /></div>
<div class="field"><label>الاسم *</label><input value="@CurrentAccount.FullName" readonly="@(!ArmsAuth.IsSystemAdminRole(CurrentAccount.Role))" /></div>
<div class="field"><label>البريد الإلكتروني</label><input type="email" @bind="CurrentAccount.Email" /></div>
<div class="field"><label>رقم الجوال</label><input @bind="CurrentAccount.Phone" maxlength="10" inputmode="numeric" pattern="05[0-9]{8}" placeholder="05xxxxxxxx" /></div>
<div class="field"><label>الدور</label><input value="@CurrentAccount.Role" readonly /></div>
<div class="field"><label>الفرع</label><input value="@CurrentAccount.Branch" readonly /></div>
</div><div class="small" style="margin-top:8px">@(ArmsAuth.IsSystemAdminRole(CurrentAccount.Role)?"مدير النظام (مدير IT) فقط يمكنه تعديل اسم المستخدم والاسم.":"اسم المستخدم والاسم ثابتان ولا يمكن تعديلهما من هذا الحساب.")</div><div class="account-actions"><button class="btn primary" @onclick="SaveProfile">حفظ بياناتي</button><a class="btn outline" href="/settings">الإعدادات</a></div></div>
<div class="panel"><div class="section-title">تغيير كلمة المرور</div><div class="form-grid"><div class="field"><label>كلمة المرور الحالية *</label><input type="password" @bind="CurrentPassword" /></div><div class="field"><label>كلمة المرور الجديدة *</label><input type="password" @bind="NewPassword" /></div><div class="field"><label>تأكيد كلمة المرور *</label><input type="password" @bind="ConfirmPassword" /></div></div><div class="actions-bottom"><button class="btn primary" @onclick="ChangePassword">حفظ كلمة المرور</button></div></div>
<div class="panel"><div class="section-title">الصلاحيات</div><p>صلاحية إرجاع الأجهزة: <b>@(CurrentAccount.CanReturnDevices?"مسموح":"غير مسموح")</b></p></div>}
@if(!string.IsNullOrWhiteSpace(Message)){<div class="notice @(Message.StartsWith("خطأ")?"danger-notice":"success-notice")">@Message</div>}
@code{UserAccount? CurrentAccount;string CurrentPassword="",NewPassword="",ConfirmPassword="",Message="";protected override async Task OnInitializedAsync(){var username=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentAccount=await ArmsAuth.ResolveUserAsync(db, username);}async Task SaveProfile(){if(CurrentAccount is null)return;if(string.IsNullOrWhiteSpace(CurrentAccount.FullName)){Message="خطأ: الاسم إجباري.";return;}if(!System.Text.RegularExpressions.Regex.IsMatch((CurrentAccount.Phone??"").Trim(),@"^05\d{8}$")){Message="خطأ: رقم الجوال يجب أن يبدأ بـ 05 ويتكون من 10 أرقام.";return;}await using var db=await DbFactory.CreateDbContextAsync();var u=await db.UserAccounts.FindAsync(CurrentAccount.Id);if(u is null)return;if(ArmsAuth.IsSystemAdminRole(CurrentAccount.Role)){u.FullName=CurrentAccount.FullName.Trim();u.Username=u.Username.Trim();}u.Email=CurrentAccount.Email.Trim();u.Phone=CurrentAccount.Phone.Trim();await db.SaveChangesAsync();CurrentAccount=u;Message="تم حفظ بيانات الحساب.";}async Task ChangePassword(){Message="";if(CurrentAccount is null)return;if(string.IsNullOrWhiteSpace(CurrentPassword)||string.IsNullOrWhiteSpace(NewPassword)||string.IsNullOrWhiteSpace(ConfirmPassword)){Message="خطأ: يرجى إدخال جميع بيانات كلمة المرور.";return;}if(Hash(CurrentPassword)!=CurrentAccount.PasswordHash){Message="خطأ: كلمة المرور الحالية غير صحيحة.";return;}if(NewPassword.Length<6){Message="خطأ: كلمة المرور الجديدة يجب ألا تقل عن 6 أحرف.";return;}if(NewPassword!=ConfirmPassword){Message="خطأ: تأكيد كلمة المرور غير مطابق.";return;}CurrentAccount.PasswordHash=Hash(NewPassword);CurrentAccount.PasswordChangedAt=DateTime.Now;await using var db=await DbFactory.CreateDbContextAsync();db.UserAccounts.Update(CurrentAccount);await db.SaveChangesAsync();CurrentPassword=NewPassword=ConfirmPassword="";Message="تم تغيير كلمة المرور بنجاح.";}static string Hash(string value)=>Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(value)));}
