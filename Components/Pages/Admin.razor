@page "/admin"
@using System.Security.Cryptography
@using System.Text
@using System.Text.RegularExpressions
@rendermode InteractiveServer
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
<PageTitle>إدارة النظام</PageTitle>

@if (CurrentUser is null)
{
    <div class="empty">جارٍ تحميل الحساب...</div>
}
else if (!IsAdmin)
{
    <div class="notice danger-notice">هذه الصفحة متاحة لمدير النظام (مدير IT) فقط.</div>
}
else
{
<div class="page-head"><div><h1>إدارة النظام</h1><p>إدارة الفروع وحسابات الفروع والفنيين والمشرفين.</p></div></div>
@if(!string.IsNullOrWhiteSpace(Message)){<div class="notice @(Message.StartsWith("خطأ")?"danger-notice":"success-notice")">@Message</div>}

<div class="panel">
    <div class="section-title">إضافة فرع</div>
    <div class="form-grid">
        <div class="field"><label>كود الفرع (تلقائي)</label><input value="@PreviewBranchCode" readonly /></div>
        <div class="field"><label>اسم الفرع *</label><input @bind="NewBranch.Name" placeholder="مثال: فرع الرياض" /></div>
        <div class="field"><label>المدينة *</label><input @bind="NewBranch.City" @bind:after="UpdateBranchPreview" placeholder="مثال: الرياض" /></div><div class="field"><label>نوع الفرع</label><label><input type="checkbox" @bind="NewBranch.IsMaintenanceCenter" /> هذا الفرع مركز صيانة</label></div>
    </div>
    <div class="actions-bottom"><button class="btn primary" @onclick="AddBranch">+ إضافة الفرع</button></div>
</div>

<div class="panel">
    <div class="section-title">إضافة حساب جديد</div>
    <div class="form-grid">
        <div class="field"><label>الاسم الكامل *</label><input @bind="NewUser.FullName" /></div>
        <div class="field"><label>اسم المستخدم *</label><input @bind="NewUser.Username" placeholder="English letters / numbers / . _ -" /></div>
        <div class="field"><label>كلمة المرور *</label><input type="password" @bind="NewPassword" /></div>
        <div class="field"><label>نوع الحساب *</label><select @bind="NewUser.Role"><option>مستخدم فرع</option><option>خدمة العملاء</option><option>فني صيانة</option><option>فني متنقل</option><option>مشرف صيانة</option><option>مدير عام ARMS</option><option>مدير رئيسي</option></select></div>
        @if(NewUser.Role=="مستخدم فرع")
        {
            <div class="field"><label>الفرع *</label><select @bind="NewUser.Branch"><option value="">اختر الفرع</option>@foreach(var b in Branches.Where(x=>x.IsActive)){<option value="@BranchLabel(b)">@BranchLabel(b)</option>}</select></div>
        }
        else if(NewUser.Role is "فني صيانة" or "مشرف صيانة")
        {
            <div class="field"><label>مركز الصيانة *</label><select @bind="NewUser.MaintenanceCenterId"><option value="0">اختر مركز الصيانة</option>@foreach(var b in Branches.Where(x=>x.IsActive&&x.IsMaintenanceCenter)){<option value="@b.Id">@b.Name</option>}</select></div>
        }
        else
        {
            <div class="field"><label>الفرع / نطاق العمل</label><input @bind="NewUser.Branch" placeholder="متنقل أو الإدارة" /></div>
        }
        <div class="field"><label>الجوال *</label><input @bind="NewUser.Phone" maxlength="10" inputmode="numeric" pattern="05[0-9]{8}" placeholder="05XXXXXXXX" /></div>
        <div class="field"><label>البريد الإلكتروني *</label><input type="email" @bind="NewUser.Email" /></div>
    </div>
    <div class="actions-bottom"><button class="btn green" @onclick="AddUser">+ إنشاء الحساب</button></div>
</div>

<div class="panel">
    <div class="section-title">الفروع المسجلة</div>
    <table><thead><tr><th @onclick="()=>SortBranchesBy(nameof(Branch.Code))">الكود ↕</th><th @onclick="()=>SortBranchesBy(nameof(Branch.Name))">الفرع ↕</th><th @onclick="()=>SortBranchesBy(nameof(Branch.City))">المدينة ↕</th><th>مركز صيانة</th><th @onclick="()=>SortBranchesBy(nameof(Branch.IsActive))">الحالة ↕</th><th>الحسابات</th><th>الإجراء</th></tr></thead><tbody>
    @foreach(var b in SortedBranches){<tr><td>@b.Code</td><td>@b.Name</td><td>@b.City</td><td>@(b.IsMaintenanceCenter?"نعم":"لا")</td><td><span class="pill @(b.IsActive?"green":"red")">@(b.IsActive?"نشط":"موقوف")</span></td><td>@Users.Count(x=>NormalizeBranch(x.Branch)==NormalizeBranch(BranchLabel(b)))</td><td><button class="btn small" @onclick="()=>StartEditBranch(b)">تعديل</button> <button class="btn small" @onclick="()=>ToggleBranch(b)">@(b.IsActive?"تعطيل":"تفعيل")</button></td></tr>}
    </tbody></table>
</div>

<div class="panel">
    <div class="section-title">الحسابات</div>
    <div class="field"><label>بحث</label><input @bind="UserSearch" @bind:event="oninput" placeholder="ابحث بالاسم أو المستخدم أو الدور أو الفرع أو الجوال أو البريد" /></div>
    <table><thead><tr><th @onclick="()=>SortUsersBy(nameof(UserAccount.FullName))">الاسم ↕</th><th @onclick="()=>SortUsersBy(nameof(UserAccount.Username))">اسم المستخدم ↕</th><th @onclick="()=>SortUsersBy(nameof(UserAccount.Role))">الدور ↕</th><th @onclick="()=>SortUsersBy(nameof(UserAccount.Branch))">الفرع ↕</th><th @onclick="()=>SortUsersBy(nameof(UserAccount.Phone))">الجوال ↕</th><th @onclick="()=>SortUsersBy(nameof(UserAccount.IsActive))">الحالة ↕</th><th>الإجراء</th></tr></thead><tbody>
    @foreach(var u in FilteredUsers){<tr><td>@u.FullName</td><td>@u.Username</td><td>@u.Role</td><td>@u.Branch</td><td>@u.Phone</td><td><span class="pill @(u.IsActive?"green":"red")">@(u.IsActive?"نشط":"موقوف")</span></td><td><button class="btn small" @onclick="()=>StartEditUser(u)">تعديل</button> <button class="btn small" disabled="@(u.Role is "مدير رئيسي" or "مدير عام ARMS")" title="@(u.Role is "مدير رئيسي" or "مدير عام ARMS"?"لا يمكن تعطيل حساب مدير عام ARMS":"")" @onclick="()=>ToggleUser(u)">@(u.IsActive?"تعطيل":"تفعيل")</button></td></tr>}
    </tbody></table>
</div>

@if(EditBranch is not null){<div class="panel"><div class="section-title">تعديل الفرع</div><div class="form-grid"><div class="field"><label>الكود</label><input @bind="EditBranch.Code" readonly /></div><div class="field"><label>الاسم</label><input @bind="EditBranch.Name" /></div><div class="field"><label>المدينة</label><input @bind="EditBranch.City" /></div></div><div class="actions-bottom"><button class="btn primary" @onclick="SaveBranchEdit">حفظ</button><button class="btn" @onclick="CancelBranchEdit">إلغاء</button></div></div>}
@if(EditUser is not null){<div class="panel"><div class="section-title">تعديل الحساب</div><div class="form-grid"><div class="field"><label>الاسم</label><input @bind="EditUser.FullName" /></div><div class="field"><label>اسم المستخدم</label><input @bind="EditUser.Username" /></div><div class="field"><label>الدور</label><select @bind="EditUser.Role"><option>مستخدم فرع</option><option>خدمة العملاء</option><option>فني صيانة</option><option>فني متنقل</option><option>مشرف صيانة</option><option>مدير عام ARMS</option><option>مدير رئيسي</option></select></div><div class="field">@if(EditUser.Role is "فني صيانة" or "مشرف صيانة"){<label>مركز الصيانة *</label><select @bind="EditUser.MaintenanceCenterId"><option value="0">اختر مركز الصيانة</option>@foreach(var b in Branches.Where(x=>x.IsActive&&x.IsMaintenanceCenter)){<option value="@b.Id">@b.Name</option>}</select>}else{<label>الفرع / نطاق العمل</label><input @bind="EditUser.Branch" />}</div><div class="field"><label>الجوال</label><input @bind="EditUser.Phone" maxlength="10" inputmode="numeric" pattern="05[0-9]{8}" placeholder="05xxxxxxxx" /></div><div class="field"><label>البريد الإلكتروني</label><input @bind="EditUser.Email" /></div></div><div class="actions-bottom"><button class="btn primary" @onclick="SaveUserEdit">حفظ</button><button class="btn" @onclick="CancelUserEdit">إلغاء</button></div></div>}
}

@code {
    UserAccount? CurrentUser;
    bool IsAdmin => ArmsAuth.IsSystemAdminRole(CurrentUser?.Role);
    List<Branch> Branches=new();
    List<UserAccount> Users=new();
    Branch NewBranch=new();
    UserAccount NewUser=new(){Role="مستخدم فرع",Branch="",CanReturnDevices=true,IsActive=true};
    string NewPassword="",Message="",PreviewBranchCode="";
    string UserSearch="";
    Branch? EditBranch;
    UserAccount? EditUser;
    string BranchSort="Name",UserSort="FullName";
    bool BranchSortAsc=true,UserSortAsc=true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender) return;
        var username=await JS.InvokeAsync<string>("armsTheme.getUser");
        await using var db=await DbFactory.CreateDbContextAsync();
        CurrentUser=await ArmsAuth.ResolveUserAsync(db, username);
        await Load();
        await InvokeAsync(StateHasChanged);
    }

    async Task Load()
    {
        await using var db=await DbFactory.CreateDbContextAsync();
        Branches=await db.Branches.OrderBy(x=>x.Name).ToListAsync();
        Users=await db.UserAccounts.OrderBy(x=>x.Role).ThenBy(x=>x.FullName).ToListAsync();
        UpdateBranchPreview();
    }

    void UpdateBranchPreview(){PreviewBranchCode=string.IsNullOrWhiteSpace(NewBranch.City)?"":BuildBranchCode(NewBranch.City,Branches);}

    async Task AddBranch()
    {
        Message="";
        if(string.IsNullOrWhiteSpace(NewBranch.Name)||string.IsNullOrWhiteSpace(NewBranch.City)){Message="خطأ: اسم ومدينة الفرع مطلوبة.";return;}
        var code=BuildBranchCode(NewBranch.City,Branches);
        await using var db=await DbFactory.CreateDbContextAsync();
        if(await db.Branches.AnyAsync(x=>x.Name==NewBranch.Name.Trim())){Message="خطأ: اسم الفرع موجود بالفعل.";return;}
        db.Branches.Add(new Branch{Code=code,Name=NewBranch.Name.Trim(),City=NewBranch.City.Trim(),IsActive=true,IsMaintenanceCenter=NewBranch.IsMaintenanceCenter});
        await db.SaveChangesAsync();
        Message="تمت إضافة الفرع بنجاح."; NewBranch=new Branch(); PreviewBranchCode=""; await Load();
    }

    async Task AddUser()
    {
        Message="";
        if(string.IsNullOrWhiteSpace(NewUser.FullName)||string.IsNullOrWhiteSpace(NewUser.Username)||string.IsNullOrWhiteSpace(NewPassword)||string.IsNullOrWhiteSpace(NewUser.Phone)||string.IsNullOrWhiteSpace(NewUser.Email)){Message="خطأ: جميع البيانات الأساسية مطلوبة.";return;}
        if(!Regex.IsMatch(NewUser.Username.Trim(),"^[A-Za-z][A-Za-z0-9._-]*$")){Message="خطأ: اسم المستخدم يجب أن يكون بالإنجليزية فقط ويمكن أن يحتوي على أرقام و . _ -";return;}
        if(!Regex.IsMatch(NewUser.Phone.Trim(),"^05\\d{8}$")){Message="خطأ: رقم الجوال يجب أن يبدأ بـ 05 ويتكون من 10 أرقام.";return;}
        try{_ = new System.Net.Mail.MailAddress(NewUser.Email.Trim());}catch{Message="خطأ: صيغة البريد الإلكتروني غير صحيحة.";return;}
        if(NewPassword.Length<6){Message="خطأ: كلمة المرور يجب ألا تقل عن 6 أحرف.";return;}
        if(NewUser.Role=="مستخدم فرع"&&string.IsNullOrWhiteSpace(NewUser.Branch)){Message="خطأ: يجب اختيار الفرع لحساب الفرع.";return;}
        if((NewUser.Role is "فني صيانة" or "مشرف صيانة") && (!NewUser.MaintenanceCenterId.HasValue || NewUser.MaintenanceCenterId==0)){Message="خطأ: يجب اختيار مركز الصيانة.";return;}
        await using var db=await DbFactory.CreateDbContextAsync();
        if(await db.UserAccounts.AnyAsync(x=>x.Username==NewUser.Username.Trim())){Message="خطأ: اسم المستخدم مستخدم بالفعل.";return;}
        var branch=NewUser.Role=="مستخدم فرع"?await db.Branches.FirstOrDefaultAsync(x=>NormalizeBranch(BranchLabel(x))==NormalizeBranch(NewUser.Branch)):null;
        var center=(NewUser.Role is "فني صيانة" or "مشرف صيانة")&&NewUser.MaintenanceCenterId.HasValue?await db.Branches.FindAsync(NewUser.MaintenanceCenterId.Value):null;
        db.UserAccounts.Add(new UserAccount{Username=NewUser.Username.Trim(),FullName=NewUser.FullName.Trim(),Role=NewUser.Role,Branch=NewUser.Role=="فني متنقل"?"متنقل":(center?.Name??NewUser.Branch.Trim()),Email=NewUser.Email.Trim(),Phone=NewUser.Phone.Trim(),CanReturnDevices=NewUser.Role is "مستخدم فرع" or "مشرف صيانة" or "مدير رئيسي" or "مدير عام ARMS",IsActive=true,BranchId=branch?.Id,MaintenanceCenterId=center?.Id,PasswordHash=Hash(NewPassword)});
        await db.SaveChangesAsync();
        Message="تم إنشاء الحساب بنجاح."; NewUser=new UserAccount{Role="مستخدم فرع",Branch="",CanReturnDevices=true,IsActive=true};NewPassword="";await Load();
    }

    IEnumerable<Branch> SortedBranches=>SortBranchData(Branches);
    IEnumerable<UserAccount> FilteredUsers=>SortUserData(Users.Where(u=>string.IsNullOrWhiteSpace(UserSearch)||$"{u.FullName} {u.Username} {u.Role} {u.Branch} {u.Phone} {u.Email}".Contains(UserSearch,StringComparison.OrdinalIgnoreCase)));
    IEnumerable<Branch> SortBranchData(IEnumerable<Branch> q)=>BranchSort switch {"Code"=>BranchSortAsc?q.OrderBy(x=>x.Code):q.OrderByDescending(x=>x.Code),"Name"=>BranchSortAsc?q.OrderBy(x=>x.Name):q.OrderByDescending(x=>x.Name),"City"=>BranchSortAsc?q.OrderBy(x=>x.City):q.OrderByDescending(x=>x.City),"IsActive"=>BranchSortAsc?q.OrderBy(x=>x.IsActive):q.OrderByDescending(x=>x.IsActive),_=>q};
    IEnumerable<UserAccount> SortUserData(IEnumerable<UserAccount> q)=>UserSort switch {"Username"=>UserSortAsc?q.OrderBy(x=>x.Username):q.OrderByDescending(x=>x.Username),"Role"=>UserSortAsc?q.OrderBy(x=>x.Role):q.OrderByDescending(x=>x.Role),"Branch"=>UserSortAsc?q.OrderBy(x=>x.Branch):q.OrderByDescending(x=>x.Branch),"Phone"=>UserSortAsc?q.OrderBy(x=>x.Phone):q.OrderByDescending(x=>x.Phone),"IsActive"=>UserSortAsc?q.OrderBy(x=>x.IsActive):q.OrderByDescending(x=>x.IsActive),_=>UserSortAsc?q.OrderBy(x=>x.FullName):q.OrderByDescending(x=>x.FullName)};
    void SortBranchesBy(string s){if(BranchSort==s)BranchSortAsc=!BranchSortAsc;else{BranchSort=s;BranchSortAsc=true;}}
    void SortUsersBy(string s){if(UserSort==s)UserSortAsc=!UserSortAsc;else{UserSort=s;UserSortAsc=true;}}

    void StartEditBranch(Branch b)=>EditBranch=new Branch{Id=b.Id,Code=b.Code,Name=b.Name,City=b.City,IsActive=b.IsActive};
    async Task SaveBranchEdit(){if(EditBranch is null)return;await using var db=await DbFactory.CreateDbContextAsync();var b=await db.Branches.FindAsync(EditBranch.Id);if(b is null)return;b.Name=EditBranch.Name.Trim();b.City=EditBranch.City.Trim();await db.SaveChangesAsync();Message="تم تعديل الفرع.";EditBranch=null;await Load();}
    void CancelBranchEdit()=>EditBranch=null;
    async Task ToggleBranch(Branch b){await using var db=await DbFactory.CreateDbContextAsync();var x=await db.Branches.FindAsync(b.Id);if(x is null)return;x.IsActive=!x.IsActive;await db.SaveChangesAsync();Message=x.IsActive?"تم تفعيل الفرع.":"تم تعطيل الفرع.";await Load();}

    void StartEditUser(UserAccount u)=>EditUser=new UserAccount{Id=u.Id,Username=u.Username,FullName=u.FullName,Role=u.Role,Branch=u.Branch,Email=u.Email,Phone=u.Phone,CanReturnDevices=u.CanReturnDevices,IsActive=u.IsActive,MaintenanceCenterId=u.MaintenanceCenterId};
    async Task SaveUserEdit(){if(EditUser is null)return;Message="";if(!Regex.IsMatch(EditUser.Username.Trim(),"^[A-Za-z][A-Za-z0-9._-]*$")){Message="خطأ: اسم المستخدم يجب أن يكون بالإنجليزية فقط.";return;}if(!Regex.IsMatch(EditUser.Phone.Trim(),"^05\\d{8}$")){Message="خطأ: رقم الجوال يجب أن يبدأ بـ 05 ويتكون من 10 أرقام.";return;}try{_ = new System.Net.Mail.MailAddress(EditUser.Email.Trim());}catch{Message="خطأ: صيغة البريد الإلكتروني غير صحيحة.";return;}await using var db=await DbFactory.CreateDbContextAsync();var u=await db.UserAccounts.FindAsync(EditUser.Id);if(u is null)return;if(await db.UserAccounts.AnyAsync(x=>x.Id!=u.Id&&x.Username==EditUser.Username.Trim())){Message="خطأ: اسم المستخدم مستخدم بالفعل.";return;}u.Username=EditUser.Username.Trim();u.FullName=EditUser.FullName.Trim();u.Role=EditUser.Role;
        if(EditUser.Role is "فني صيانة" or "مشرف صيانة"){if(!EditUser.MaintenanceCenterId.HasValue||EditUser.MaintenanceCenterId==0){Message="خطأ: يجب اختيار مركز الصيانة.";return;}var c=await db.Branches.FindAsync(EditUser.MaintenanceCenterId.Value);if(c is null||!c.IsMaintenanceCenter){Message="خطأ: المركز المحدد غير صالح.";return;}u.MaintenanceCenterId=c.Id;u.Branch=c.Name;}else{u.MaintenanceCenterId=null;u.Branch=EditUser.Role=="فني متنقل"?"متنقل":EditUser.Branch.Trim();}
u.Email=EditUser.Email.Trim();u.Phone=EditUser.Phone.Trim();await db.SaveChangesAsync();Message="تم تعديل الحساب.";EditUser=null;await Load();}
    void CancelUserEdit()=>EditUser=null;
    async Task ToggleUser(UserAccount u){if(u.Role is "مدير رئيسي" or "مدير عام ARMS"){Message="خطأ: لا يمكن تعطيل حساب مدير عام ARMS.";return;}await using var db=await DbFactory.CreateDbContextAsync();var x=await db.UserAccounts.FindAsync(u.Id);if(x is null||x.Role is "مدير رئيسي" or "مدير عام ARMS")return;x.IsActive=!x.IsActive;await db.SaveChangesAsync();Message=x.IsActive?"تم تفعيل الحساب.":"تم تعطيل الحساب.";await Load();}

    static string Hash(string v)=>Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(v)));
    static string BranchLabel(Branch b)=>b.City;
    static string NormalizeBranch(string? value)=>(value??"").Trim().Replace("فرع ","").Replace("فرع","").Trim();
    static string BuildBranchCode(string city,IEnumerable<Branch> existing){var key=CityKey(city);var n=existing.Count(x=>x.Code.StartsWith($"ARO-{key}-",StringComparison.OrdinalIgnoreCase))+1;return $"ARO-{key}-{n:000}";}
    static string CityKey(string city){var c=(city??"").Trim();var map=new Dictionary<string,string>(StringComparer.OrdinalIgnoreCase){{"الرياض","RYD"},{"جدة","JED"},{"مكة","MKK"},{"مكة المكرمة","MKK"},{"المدينة","MDN"},{"المدينة المنورة","MDN"},{"الدمام","DMM"},{"الخبر","KHB"},{"الطائف","TAF"},{"أبها","ABH"},{"تبوك","TBK"},{"بريدة","BRD"},{"حائل","HAI"}};if(map.TryGetValue(c,out var v))return v;var ascii=new string(c.Where(char.IsLetterOrDigit).Where(ch=>ch<128).ToArray()).ToUpperInvariant();if(ascii.Length>=3)return ascii[..3];var ar=new string(c.Where(char.IsLetterOrDigit).Take(3).ToArray());return string.IsNullOrWhiteSpace(ar)?"BRN":ar;}
}
