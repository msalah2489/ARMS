@page "/branch/receiving"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IWebHostEnvironment Env

<PageTitle>استلام أجهزة الصيانة - الفرع</PageTitle>

<div class="page-head">
  <div>
    <h1>استلام أجهزة الصيانة</h1>
    <p>استلام الأجهزة القادمة من مركز الصيانة ثم تسليمها للعميل.</p>
  </div>
</div>

@if (!string.IsNullOrWhiteSpace(Message))
{
  <div class="notice @(Message.StartsWith("خطأ") ? "danger-notice" : "success-notice")">@Message</div>
}

<div class="panel">
  <div class="section-title">📦 أجهزة قادمة من الصيانة</div>
  <p class="small">هذه الأجهزة تم إصلاحها وإرسالها للفرع وهي حاليًا مع مندوب التوصيل.</p>

  @if (Incoming.Count == 0)
  {
    <div class="empty">لا توجد أجهزة قادمة من الصيانة حاليًا.</div>
  }
  else
  {
    <table>
      <thead><tr><th>الجهاز</th><th>الموديل</th><th>الطلب</th><th>العميل</th><th>الحالة</th><th>الإجراء</th></tr></thead>
      <tbody>
      @foreach (var d in Incoming)
      {
        <tr>
          <td><b>@d.DeviceCode</b></td>
          <td>@d.Model</td>
          <td>@d.ServiceRequest?.RequestNumber</td>
          <td>@d.ServiceRequest?.CustomerName</td>
          <td><span class="pill blue">في الطريق للفرع</span><div class="small">مع مندوب التوصيل</div></td>
          <td><button class="btn primary" @onclick="() => Receive(d.Id)">✓ استلام الجهاز</button></td>
        </tr>
      }
      </tbody>
    </table>
  }
</div>

<div class="panel">
  <div class="section-title">👤 أجهزة مستلمة بالفرع</div>
  <p class="small">بعد الاستلام تظهر الأجهزة هنا، ويمكن تسجيل تسليمها للعميل.</p>
  @if (Received.Count == 0)
  {
    <div class="empty">لا توجد أجهزة بانتظار تسليمها للعميل.</div>
  }
  else
  {
    <table>
      <thead><tr><th><input type="checkbox" checked="@(Received.Count>0&&Received.All(x=>DeliverIds.Contains(x.Id)))" @onchange="ToggleAllDeliver" /></th><th>الجهاز</th><th>الموديل</th><th>الطلب</th><th>العميل</th><th>تاريخ الاستلام</th></tr></thead>
      <tbody>
      @foreach (var d in Received)
      {
        <tr>
          <td><input type="checkbox" checked="@DeliverIds.Contains(d.Id)" @onchange="e => ToggleDeliver(d.Id, (bool)e.Value!)" /></td>
          <td><b>@d.DeviceCode</b></td>
          <td>@d.Model</td>
          <td>@d.ServiceRequest?.RequestNumber</td>
          <td>@d.ServiceRequest?.CustomerName<br/><span class="small">@d.ServiceRequest?.Phone</span></td>
          <td>@d.BranchReceivedAt?.ToString("yyyy-MM-dd HH:mm")</td>
        </tr>
      }
      </tbody>
    </table>
    <div class="actions-bottom"><button class="btn primary" disabled="@(DeliverIds.Count==0)" @onclick="OpenDeliverSelected">✓ تسليم الأجهزة المحددة للعميل (@DeliverIds.Count)</button></div>
  }
</div>

<div class="panel">
  <div class="section-title">✓ أجهزة تم تسليمها للعميل</div>
  @if (Delivered.Count == 0)
  {
    <div class="empty">لا توجد عمليات تسليم مسجلة هنا.</div>
  }
  else
  {
    <table>
      <thead><tr><th>الجهاز</th><th>الطلب</th><th>العميل</th><th>تاريخ التسليم</th><th>الموظف</th></tr></thead>
      <tbody>
      @foreach (var d in Delivered)
      {
        <tr>
          <td><b>@d.DeviceCode</b></td>
          <td>@d.ServiceRequest?.RequestNumber</td>
          <td>@d.ServiceRequest?.CustomerName</td>
          <td>@d.CustomerDeliveredAt?.ToString("yyyy-MM-dd HH:mm")</td>
          <td>@d.CustomerDeliveredBy</td>
        </tr>
      }
      </tbody>
    </table>
  }
</div>

@if (ReceiptDevice is not null || DeliverBatch.Count > 0)
{
  <div class="modal-back">
    <div class="modal">
      <div class="modal-head">
        <h3>@(IsDelivery ? "تأكيد تسليم الجهاز/الأجهزة للعميل" : "سند استلام الجهاز من العميل")</h3>
        <button class="btn gray" @onclick="CloseReceipt">×</button>
      </div>
      @if (IsDelivery)
      {
        <p>عدد الأجهزة: <b>@DeliverBatch.Count</b></p>
        <ul>@foreach(var dv in DeliverBatch){<li>@dv.DeviceCode — @dv.ServiceRequest?.RequestNumber</li>}</ul>
        <div class="small">أدخل رقم وصورة سند التسليم لهذا الجهاز فقط. لا يجوز استخدام رقم السند نفسه لجهاز آخر.</div>
        <div class="field"><label>رقم سند التسليم *</label><input @bind="ReceiptNumber" /><div class="small">رقم يدوي من دفتر السندات — جهاز واحد لكل رقم سند.</div></div>
        <div class="field"><label>صورة سند التسليم *</label><InputFile OnChange="OnReceiptFile" accept="image/*" /></div>
      }
      else
      {
        <p>الجهاز: <b>@ReceiptDevice!.DeviceCode</b></p>
        <div class="field"><label>رقم السند *</label><input @bind="ReceiptNumber" /><div class="small">الرقم يُدخل يدويًا من دفتر السندات، ويجب ألا يكون مستخدمًا من قبل.</div></div>
        <div class="field"><label>صورة السند *</label><InputFile OnChange="OnReceiptFile" accept="image/*" /><div class="small">يمكن استخدام نفس رقم وصورة السند لأكثر من جهاز.</div></div>
      }
      <div class="actions-bottom">
        <button class="btn primary" @onclick="ConfirmReceipt">@(IsDelivery ? "تأكيد التسليم" : "حفظ السند")</button>
        <button class="btn gray" @onclick="CloseReceipt">إلغاء</button>
      </div>
    </div>
  </div>
}

@code {
  UserAccount? CurrentUser;
  List<ServiceDevice> Incoming = new();
  List<ServiceDevice> Received = new();
  List<ServiceDevice> Delivered = new();
  string Message = "";
  ServiceDevice? ReceiptDevice; bool IsDelivery; string ReceiptNumber=""; IBrowserFile? ReceiptFile;
  HashSet<int> DeliverIds = new();
  List<ServiceDevice> DeliverBatch = new();

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    var username = await JS.InvokeAsync<string>("armsTheme.getUser");
    await using var db = await DbFactory.CreateDbContextAsync();
    CurrentUser = await ArmsAuth.ResolveUserAsync(db, username);
    await Load();
    await InvokeAsync(StateHasChanged);
  }

  async Task Load()
  {
    if (CurrentUser is null) return;
    await using var db = await DbFactory.CreateDbContextAsync();
    var branch = NormalizeBranch(CurrentUser.Branch);

    // لا نستخدم NormalizeBranch داخل استعلام EF/SQLite لأنه لا يترجم إلى SQL بشكل موثوق.
    // نجلب الأجهزة المرتبطة بطلباتها ثم نوحّد اسم الفرع داخل الذاكرة قبل تقسيم القوائم.
    var allDevices = await db.ServiceDevices
        .Include(x => x.ServiceRequest)
        .Where(x => x.ServiceRequest != null)
        .ToListAsync();

    var q = allDevices.Where(x => NormalizeBranch(x.ServiceRequest?.Branch) == branch).ToList();

    // مصدر الحقيقة لوصول الجهاز للفرع هو CurrentLocation.
    // الحالة التشغيلية "مع مندوب التوصيل" تعرض للتوضيح فقط ولا تمنع ظهور الجهاز.
    Incoming = q.Where(x => x.CurrentLocation == "في الطريق للفرع" && x.CustomerDeliveredAt == null)
        .OrderBy(x => x.ServiceRequest?.RequestNumber).ToList();
    Received = q.Where(x => x.CurrentLocation == "الفرع" && (x.CurrentStatus == "مستلم بالفرع" || x.CurrentStatus == "تمت الصيانة محليًا") && x.CustomerDeliveredAt == null)
        .OrderByDescending(x => x.BranchReceivedAt).ToList();
    Delivered = q.Where(x => x.CurrentLocation == "الفرع" && x.CustomerDeliveredAt != null)
        .OrderByDescending(x => x.CustomerDeliveredAt).Take(30).ToList();
    DeliverIds.RemoveWhere(id => Received.All(d => d.Id != id));
  }

  static string NormalizeBranch(string? value)
  {
    if (string.IsNullOrWhiteSpace(value)) return "";
    var v = value.Trim().Replace("فرع ", "").Replace("فرع-", "").Replace("فرع", "");
    return v.Trim();
  }

  void ToggleDeliver(int id, bool on){ if(on) DeliverIds.Add(id); else DeliverIds.Remove(id); }
  void ToggleAllDeliver(ChangeEventArgs e){ var on=(bool)e.Value!; if(on) foreach(var d in Received) DeliverIds.Add(d.Id); else DeliverIds.Clear(); }
  void OpenDeliverSelected(){ DeliverBatch = Received.Where(d=>DeliverIds.Contains(d.Id)).ToList(); if(DeliverBatch.Count!=1){ Message="خطأ: كل جهاز يجب أن يكون له سند تسليم مستقل. اختر جهازًا واحدًا فقط."; return; } IsDelivery=true; ReceiptNumber=""; ReceiptFile=null; ReceiptDevice=null; }
  void CloseReceipt(){ReceiptDevice=null;ReceiptFile=null;ReceiptNumber="";DeliverBatch.Clear();}
  void OnReceiptFile(InputFileChangeEventArgs e){ReceiptFile=e.File;}

  async Task ConfirmReceipt(){
    if(CurrentUser is null)return;
    if(IsDelivery){
      if(DeliverBatch.Count==0)return;
      if(DeliverBatch.Count!=1){Message="خطأ: لا يمكن استخدام سند تسليم واحد لعدة أجهزة.";return;}
      if(string.IsNullOrWhiteSpace(ReceiptNumber)){Message="خطأ: رقم سند التسليم إجباري.";return;}
      await using(var checkDb=await DbFactory.CreateDbContextAsync()){var n=ReceiptNumber.Trim();if(await checkDb.DeviceReceipts.AnyAsync(x=>x.ReceiptNumber==n)){Message=$"خطأ: رقم سند التسليم {n} مستخدم مسبقًا ولا يمكن ربطه بجهاز آخر.";return;}if(await checkDb.ServiceDevices.AnyAsync(x=>x.Id==DeliverBatch[0].Id&&x.CustomerDeliveryReceiptNumber==n)){Message="خطأ: رقم السند مستخدم مسبقًا لهذا الجهاز.";return;}}
      if(ReceiptFile is null){Message="خطأ: صورة سند التسليم إجبارية.";return;}
      var uploadError0=UploadGuard.Validate(ReceiptFile);if(uploadError0 is not null){Message=uploadError0;return;}
      var dir0=Path.Combine(Env.WebRootPath,"uploads","delivery-receipts");Directory.CreateDirectory(dir0);
      var file0=Path.Combine(dir0,$"{Guid.NewGuid()}{UploadGuard.SafeExtension(ReceiptFile)}");
      await using(var fs0=File.Create(file0)){await ReceiptFile.OpenReadStream(UploadGuard.MaxFileSizeBytes).CopyToAsync(fs0);}
      var path0="/uploads/delivery-receipts/"+Path.GetFileName(file0);
      await DeliverToCustomer(DeliverBatch.Select(d=>d.Id).ToList(),ReceiptNumber,path0);
      DeliverIds.Clear();
      CloseReceipt();
      return;
    }
    return;
  }

  async Task Receive(int id){
    Message="";
    if(CurrentUser is null||CurrentUser.Role!="مستخدم فرع"){Message="خطأ: هذه العملية متاحة لمستخدم الفرع فقط.";return;}
    await using var db=await DbFactory.CreateDbContextAsync();
    var d=await db.ServiceDevices.Include(x=>x.ServiceRequest).FirstOrDefaultAsync(x=>x.Id==id);
    if(d is null||d.ServiceRequest is null||NormalizeBranch(d.ServiceRequest.Branch)!=NormalizeBranch(CurrentUser.Branch)||d.CurrentLocation!="في الطريق للفرع"){Message="خطأ: الجهاز غير متاح للاستلام من هذا الفرع.";return;}
    var now=DateTime.Now;
    d.CurrentLocation="الفرع";d.CurrentStatus="مستلم بالفرع";d.BranchReceivedAt=now;d.BranchReceivedBy=CurrentUser.FullName;
    // ملاحظة: هذا استلام داخلي للجهاز من مندوب التوصيل، وليس تعاملاً جديداً مع العميل،
    // لذلك لا نسجل هنا سند "استلام من العميل" (ذلك السند سُجّل مرة واحدة فقط عند استلام الجهاز
    // من العميل في الفرع أول مرة) ولا نستبدل بيانات ذلك السند الأصلي.
    db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="مستلم بالفرع",Location="الفرع",StartedAt=now,ChangedBy=CurrentUser.FullName,Notes="تم استلام الجهاز من مندوب التوصيل بالفرع."});
    var req=await db.ServiceRequests.Include(x=>x.Devices).FirstOrDefaultAsync(x=>x.Id==d.ServiceRequestId);
    if(req is not null)req.Status=RequestStatusHelper.Calculate(req.Devices);
    await db.SaveChangesAsync();
    Message=$"تم استلام الجهاز {d.DeviceCode} بالفرع.";
    await Load();
  }

  async Task DeliverToCustomer(List<int> ids,string receiptNumber,string receiptPath){
    Message="";
    if(CurrentUser is null||CurrentUser.Role!="مستخدم فرع"){Message="خطأ: هذه العملية متاحة لمستخدم الفرع فقط.";return;}
    await using var db=await DbFactory.CreateDbContextAsync();
    if(ids.Count!=1){Message="خطأ: كل جهاز يجب أن يكون له سند تسليم مستقل.";return;}
    if(await db.DeviceReceipts.AnyAsync(x=>x.ReceiptNumber==receiptNumber.Trim())){Message=$"خطأ: رقم سند التسليم {receiptNumber.Trim()} مستخدم مسبقًا.";return;}
    var devices=await db.ServiceDevices.Include(x=>x.ServiceRequest).Where(x=>ids.Contains(x.Id)).ToListAsync();
    var now=DateTime.Now;
    var delivered=new List<string>();
    foreach(var d in devices){
      if(d.ServiceRequest is null||NormalizeBranch(d.ServiceRequest.Branch)!=NormalizeBranch(CurrentUser.Branch)||d.CurrentLocation!="الفرع"||(d.CurrentStatus!="مستلم بالفرع"&&d.CurrentStatus!="تمت الصيانة محليًا")||d.CustomerDeliveredAt!=null) continue;
      d.CustomerDeliveredAt=now;d.CustomerDeliveredBy=CurrentUser.FullName;d.CurrentLocation="الفرع";d.CurrentStatus="تم التسليم للعميل";
      d.CustomerDeliveryReceiptNumber=receiptNumber;d.CustomerDeliveryReceiptImagePath=receiptPath;d.CustomerDeliveryReceiptAt=now;
      db.DeviceReceipts.Add(new DeviceReceipt{ServiceDeviceId=d.Id,ReceiptType="تسليم للعميل",ReceiptNumber=receiptNumber,ImagePath=receiptPath,ReceiptDate=now,RecordedBy=CurrentUser.FullName});
      db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="تم التسليم للعميل",Location="الفرع",StartedAt=now,ChangedBy=CurrentUser.FullName,Notes=$"تم تسليم الجهاز للعميل بسند تسليم رقم {receiptNumber}."});
      var remaining=await db.ServiceDevices.Where(x=>x.ServiceRequestId==d.ServiceRequestId&&x.CustomerDeliveredAt==null&&x.Decision!="مستبعد"&&x.Decision!="مهلك"&&x.Decision!="مستبدل").CountAsync();
      d.ServiceRequest.Status=remaining==0?"مغلق":RequestStatusHelper.Calculate(d.ServiceRequest.Devices);
      delivered.Add(d.DeviceCode);
    }
    await db.SaveChangesAsync();
    Message=delivered.Count==0?"خطأ: لم يتم تسليم أي جهاز (تأكد من حالة الأجهزة المحددة).":$"تم تسليم {delivered.Count} جهاز/أجهزة للعميل بسند التسليم رقم {receiptNumber}: {string.Join("، ",delivered)}.";
    await Load();
  }

}
