@page "/branch/shipping"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
<PageTitle>شحن أجهزة الصيانة</PageTitle>
@if(CurrentUser is null){<div class="empty">جارٍ التحميل...</div>}
else if(CurrentUser.Role!="مستخدم فرع"){<div class="notice danger-notice">هذه الصفحة متاحة لمستخدم الفرع فقط.</div>}
else{
<div class="page-head"><div><h1>شحن أجهزة الصيانة</h1><p>تظهر هنا بوالص الإرسال التي أنشأها مدير الصيانة. لا تعيد إدخال الأجهزة.</p></div></div>
@if(!string.IsNullOrWhiteSpace(Message)){<div class="notice @(Message.StartsWith("خطأ")?"danger-notice":"success-notice")">@Message</div>}
@if(Batches.Any()){@foreach(var b in Batches){<div class="panel"><div class="itemhead"><div><h2>@b.ShipmentNumber</h2><div class="small">@b.Carrier — @b.DestinationName — @b.Status</div></div><span class="pill @(b.Status=="تم التسليم لشركة الشحن"?"green":"yellow")">@b.Status</span></div><table><thead><tr><th>الجهاز</th><th>الموديل</th><th>اللون</th><th>الطلب</th><th>الحالة</th><th>إزالة</th></tr></thead><tbody>@foreach(var item in b.Items.Where(x=>x.RemovedAt==null)){<tr><td><b>@item.DeviceCodeSnapshot</b></td><td>@item.ModelSnapshot</td><td>@(string.IsNullOrWhiteSpace(item.ColorSnapshot)?"—":item.ColorSnapshot)</td><td>@item.ServiceDevice?.ServiceRequest?.RequestNumber</td><td>@item.Status</td><td>@if(b.Status=="بانتظار تسليم الفرع"){<button class="btn danger" @onclick="()=>RemoveItem(b.Id,item.Id)">حذف من الشحنة</button>}</td></tr>}</tbody></table>@if(b.Status=="بانتظار تسليم الفرع"){<div class="actions-bottom"><button class="btn primary" @onclick="()=>ConfirmHandover(b.Id)">✓ تم التسليم لشركة الشحن</button></div>}else{<div class="small">تم تثبيت الشحنة. لا يمكن تعديل الأجهزة بعد تأكيد التسليم.</div>}</div>}}
else{<div class="panel"><div class="empty">لا توجد بوالص إرسال جديدة لهذا الفرع.</div></div>}
}
@code{UserAccount? CurrentUser;List<ShippingBatch> Batches=new();string Message="";protected override async Task OnInitializedAsync(){await Load();}async Task Load(){var token=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db,token);if(CurrentUser?.Role!="مستخدم فرع")return;var branch=CurrentUser.Branch;Batches=await db.ShippingBatches.Include(x=>x.Items).ThenInclude(x=>x.ServiceDevice).ThenInclude(x=>x.ServiceRequest).Where(x=>x.Direction=="إرسال للصيانة"&&x.SourceName==branch&&x.Status!="مكتمل").OrderByDescending(x=>x.Id).Take(30).ToListAsync();}async Task RemoveItem(int batchId,int itemId){Message="";if(CurrentUser is null)return;await using var db=await DbFactory.CreateDbContextAsync();var b=await db.ShippingBatches.Include(x=>x.Items).FirstOrDefaultAsync(x=>x.Id==batchId&&x.SourceName==CurrentUser.Branch&&x.Status=="بانتظار تسليم الفرع");var item=b?.Items.FirstOrDefault(x=>x.Id==itemId&&x.RemovedAt==null);if(item is null){Message="خطأ: الجهاز غير متاح للحذف.";return;}item.RemovedAt=DateTime.Now;item.RemovedBy=CurrentUser.FullName;item.Status="محذوف من الشحنة";item.RemovalReason="تعديل الفرع قبل التسليم";var removedDevice=await db.ServiceDevices.FindAsync(item.ServiceDeviceId);if(removedDevice is not null&&removedDevice.DispatchBatchCode==b.BatchNumber)removedDevice.DispatchBatchCode="";await db.SaveChangesAsync();Message="تم حذف الجهاز من سند الإرسال. الجهاز بقي في الفرع.";await Load();}async Task ConfirmHandover(int batchId){Message="";if(CurrentUser is null)return;await using var db=await DbFactory.CreateDbContextAsync();var b=await db.ShippingBatches.Include(x=>x.Items).FirstOrDefaultAsync(x=>x.Id==batchId&&x.SourceName==CurrentUser.Branch&&x.Status=="بانتظار تسليم الفرع");if(b is null){Message="خطأ: البوليصة غير متاحة للتسليم.";return;}var ids=b.Items.Where(x=>x.RemovedAt==null).Select(x=>x.ServiceDeviceId).ToList();if(ids.Count==0){Message="خطأ: لا توجد أجهزة متبقية في الشحنة.";return;}var rows=await db.ServiceDevices.Where(x=>ids.Contains(x.Id)&&x.CurrentLocation==CurrentUser.Branch).ToListAsync();var now=DateTime.Now;foreach(var d in rows){d.MaintenanceRoute="مركز الصيانة";d.Decision="جاهز للإرسال";d.SentAt=now;d.DispatchBatchCode=b.BatchNumber;d.CurrentLocation="في الطريق إلى الصيانة";d.CurrentStatus="مرسل إلى مركز الصيانة";db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="مرسل إلى مركز الصيانة",Location="في الطريق إلى الصيانة",StartedAt=now,ChangedBy=CurrentUser.FullName,Notes=$"تم التسليم لشركة الشحن — بوليصة {b.ShipmentNumber}"});}b.Status="تم التسليم لشركة الشحن";b.HandedToCarrierAt=now;b.HandedToCarrierBy=CurrentUser.FullName;await db.SaveChangesAsync();Message=$"تم تثبيت تسليم {rows.Count} جهاز لشركة الشحن. حالة الأجهزة أصبحت مرسل إلى مركز الصيانة وموقعها في الطريق إلى الصيانة.";await Load();}}
