@page "/service-requests/bulk-dispatch"
@rendermode InteractiveServer
@using QRCoder
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
<PageTitle>إرسال أجهزة متعددة للصيانة</PageTitle>
@if(CurrentUser is null || Loading){<div class="empty">جارٍ تحميل البيانات...</div>}
else if(!IsBranch){<div class="notice danger-notice">هذه العملية متاحة لمستخدم الفرع فقط.</div>}
else{
<div class="page-head"><div><h1>إرسال أجهزة متعددة إلى مركز الصيانة</h1><p>هذا المسار قديم. إنشاء البوليصة وسند الإرسال أصبح من حساب مدير الصيانة، والفرع يؤكد التسليم فقط.</p></div><a class="btn outline" href="/service-requests">← عرض الطلبات</a></div>
@if(!string.IsNullOrWhiteSpace(Message)){<div class="notice @(Message.StartsWith("خطأ")?"danger-notice":"success-notice")">@Message</div>}
<div class="stats"><div class="stat"><span>الطلبات المحددة</span><b>@Requests.Count</b></div><div class="stat"><span>الأجهزة الجاهزة</span><b>@Rows.Count</b></div><div class="stat"><span>حالة التقرير</span><b>@(Printed?"تمت الطباعة":"لم تتم الطباعة")</b></div></div>
<div class="panel no-print"><div class="section-title">الأوامر</div><button class="btn outline" @onclick="PrintReport" disabled="@(!Rows.Any())">🖨 طباعة التقرير الموحد</button><button class="btn primary" style="margin-right:8px" @onclick="SendAll" disabled="@(!Printed||!Rows.Any())">⇧ إرسال جميع الأجهزة إلى مركز الصيانة</button><button class="btn gray" style="margin-right:8px" @onclick="Reload">↻ تحديث</button></div><div class="panel no-print"><div class="section-title">إعادة طباعة تقارير الإرسال السابقة</div>@if(!RecentBatches.Any()){<div class="small">لا توجد دفعات إرسال مسجلة.</div>}else{<table><thead><tr><th>الدفعة</th><th>التاريخ</th><th>عدد الأجهزة</th><th>إعادة الطباعة</th></tr></thead><tbody>@foreach(var b in RecentBatches){<tr><td>@b.Code</td><td>@b.Date.ToString("yyyy-MM-dd HH:mm")</td><td>@b.Count</td><td><button class="btn outline" @onclick="()=>LoadHistoricalBatch(b.Code)">🖨 إعادة طباعة</button></td></tr>}</tbody></table>}</div>
<div class="panel" id="bulk-dispatch-report"><img class="company-print-logo print-only" src="/images/company-logo.png" alt="الشركة"/><div class="print-only report-title">تقرير إرسال أجهزة متعددة إلى مركز الصيانة</div><div class="print-only"><p>دفعة الإرسال: <b>@BatchCode</b></p><p>تاريخ التقرير: <b>@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</b></p></div><table><thead><tr><th>رقم الطلب</th><th>العميل</th><th>الفرع</th><th>كود الجهاز</th><th>الموديل</th><th>السيريال</th><th>شكوى العميل</th><th>الحالة</th></tr></thead><tbody>@foreach(var d in Rows){<tr><td>@d.ServiceRequest?.RequestNumber</td><td>@d.ServiceRequest?.CustomerName</td><td>@d.ServiceRequest?.Branch</td><td><b>@d.DeviceCode</b></td><td>@d.Model</td><td>@d.SerialNumber</td><td>@(string.IsNullOrWhiteSpace(d.ComplaintDetails)?d.Problem:d.ComplaintDetails)</td><td>@(d.SentAt.HasValue?"تم الإرسال":"جاهز للإرسال")</td></tr>}</tbody></table></div>
}
@code{
 [SupplyParameterFromQuery(Name="ids")] public string? Ids{get;set;} UserAccount? CurrentUser; bool IsBranch=>CurrentUser?.Role=="مستخدم فرع"; bool Loading=true,Printed; string Message="",BatchCode=""; List<ServiceRequest> Requests=new(); List<ServiceDevice> Rows=new(); List<BatchInfo> RecentBatches=new();
 protected override async Task OnParametersSetAsync(){await Load();}
 async Task Load(){Loading=true;var username=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db, username);Requests.Clear();Rows.Clear();Printed=false;if(!IsBranch||string.IsNullOrWhiteSpace(Ids)){Loading=false;return;}var ids=Ids.Split(',',StringSplitOptions.RemoveEmptyEntries).Select(x=>int.TryParse(x,out var n)?n:0).Where(x=>x>0).Distinct().ToList();Requests=await db.ServiceRequests.Include(x=>x.Devices).Where(x=>ids.Contains(x.Id)&&x.Branch==CurrentUser!.Branch).OrderBy(x=>x.RequestNumber).ToListAsync();Rows=Requests.SelectMany(r=>r.Devices.Where(d=>d.CurrentLocation=="الفرع"&&!d.SentAt.HasValue&&!d.MaintenanceReceivedAt.HasValue&&(d.Decision=="جاهز للإرسال"||d.CurrentStatus=="تعذر الصيانة المحلية")&&d.Decision!="مستبعد"&&d.Decision!="مستبدل"&&d.Decision!="مهلك")).ToList();BatchCode=$"BULK-{DateTime.Now:yyyyMMdd-HHmmss}";RecentBatches=await db.ServiceDevices.Where(d=>d.ServiceRequest!.Branch==CurrentUser!.Branch&&d.DispatchBatchCode!="").GroupBy(d=>d.DispatchBatchCode).Select(g=>new BatchInfo{Code=g.Key!,Date=g.Max(x=>x.SentAt??DateTime.MinValue),Count=g.Count()}).OrderByDescending(x=>x.Date).Take(20).ToListAsync();Loading=false;}
 async Task PrintReport(){if(!Rows.Any()){Message="خطأ: لا توجد أجهزة جاهزة للإرسال في الطلبات المحددة.";return;}await using var db=await DbFactory.CreateDbContextAsync();var ids=Requests.Select(x=>x.Id).ToList();var rs=await db.ServiceRequests.Where(x=>ids.Contains(x.Id)).ToListAsync();foreach(var r in rs){r.ApprovedAt=DateTime.Now;r.DispatchReportPrintedAt=DateTime.Now;}await db.SaveChangesAsync();Printed=true;Message="تم اعتماد وطباعة التقرير الموحد. يمكنك الآن تنفيذ الإرسال لجميع الأجهزة.";await JS.InvokeVoidAsync("window.print");}
 async Task SendAll(){Message="";if(!Printed){Message="خطأ: يجب طباعة التقرير أولًا.";return;}if(CurrentUser is null)return;await using var db=await DbFactory.CreateDbContextAsync();var ids=Requests.Select(x=>x.Id).ToList();var rows=await db.ServiceDevices.Include(x=>x.ServiceRequest).Where(d=>ids.Contains(d.ServiceRequestId)&&d.ServiceRequest!.Branch==CurrentUser.Branch&&d.CurrentLocation=="الفرع"&&!d.SentAt.HasValue&&!d.MaintenanceReceivedAt.HasValue&&(d.Decision=="جاهز للإرسال"||d.CurrentStatus=="تعذر الصيانة المحلية")&&d.Decision!="مستبعد"&&d.Decision!="مستبدل"&&d.Decision!="مهلك").ToListAsync();if(!rows.Any()){Message="خطأ: لم تعد هناك أجهزة متاحة للإرسال.";await Load();return;}var now=DateTime.Now;foreach(var d in rows){d.MaintenanceRoute="مركز الصيانة";d.Decision="جاهز للإرسال";d.SentAt=now;d.DispatchBatchCode=BatchCode;d.CurrentLocation="في الطريق للصيانة";d.CurrentStatus="مع مندوب التوصيل";d.LocalMaintenanceFailureReason="";db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="مع مندوب التوصيل",Location="في الطريق للصيانة",StartedAt=now,ChangedBy=CurrentUser.FullName,Notes=$"إرسال جماعي — دفعة {BatchCode}"});}foreach(var r in await db.ServiceRequests.Include(x=>x.Devices).Where(x=>ids.Contains(x.Id)).ToListAsync()){r.SentAt=now;r.Status=RequestStatusHelper.Calculate(r.Devices);}await db.SaveChangesAsync();Message=$"تم إرسال {rows.Count} جهاز إلى مركز الصيانة في الدفعة {BatchCode}.";await Load();}
 async Task LoadHistoricalBatch(string code){if(string.IsNullOrWhiteSpace(code)||CurrentUser is null)return;await using var db=await DbFactory.CreateDbContextAsync();Rows=await db.ServiceDevices.Include(x=>x.ServiceRequest).Where(d=>d.DispatchBatchCode==code&&d.ServiceRequest!.Branch==CurrentUser.Branch).OrderBy(x=>x.Id).ToListAsync();BatchCode=code;Printed=true;Message=$"تم تحميل الدفعة {code} لإعادة طباعة التقرير.";await JS.InvokeVoidAsync("window.print");}
 async Task Reload(){await Load();}
 public class BatchInfo{public string Code{get;set;}="";public DateTime Date{get;set;}public int Count{get;set;}}
}
