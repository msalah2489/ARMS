@page "/customer-service"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>خدمة العملاء - ARMS</PageTitle>

<div class="page-head">
  <div><h1>خدمة العملاء</h1><p>استعراض الأجهزة حسب حالتها، البحث عن جهاز محدد، وإضافة ملاحظات عليه.</p></div>
</div>

<div class="panel">
  <div class="section-title">📋 استعراض الأجهزة حسب الحالة</div>
  <div class="field wide"><label>الحالة</label>
    <select @bind="StatusFilter" @bind:after="ApplyStatusFilter">
      <option value="to_maintenance">أجهزة في طريقها للصيانة</option>
      <option value="ready_for_maintenance">أجهزة جاهزة للصيانة</option>
      <option value="ready_to_branch">أجهزة جاهزة للإرسال للفرع</option>
      <option value="paused">أجهزة معلقة</option>
      <option value="ready_for_return">مجهزة للإرجاع</option>
      <option value="to_branch">في طريقها للفرع</option>
    </select>
  </div>
</div>

<div class="panel">
  <div class="section-title">🔎 بحث عن جهاز محدد</div>
  <div class="filter-grid">
    <div class="field"><label>اسم العميل</label><input @bind="SearchName" /></div>
    <div class="field"><label>رقم الجوال</label><input @bind="SearchPhone" /></div>
    <div class="field"><label>رقم الجهاز</label><input @bind="SearchDeviceCode" /></div>
    <div class="field"><label>رقم الطلب</label><input @bind="SearchRequestNumber" /></div>
    <div class="field"><label>من تاريخ</label><input type="date" @bind="SearchFrom" /></div>
    <div class="field"><label>إلى تاريخ</label><input type="date" @bind="SearchTo" /></div>
  </div>
  <div class="toolbar" style="margin-top:12px"><button class="btn primary" @onclick="Search">بحث</button><button class="btn" @onclick="ClearSearch">مسح البحث</button></div>
</div>

@if (!string.IsNullOrWhiteSpace(Message)) { <div class="notice @(Message.StartsWith("خطأ") ? "danger-notice" : "success-notice")">@Message</div> }

<div class="panel">
  <div class="section-title">الأجهزة (@Devices.Count)</div>
  @if (Devices.Count == 0)
  {
    <div class="empty">لا توجد أجهزة ضمن هذا الاختيار.</div>
  }
  else
  {
    <table>
      <thead><tr><th>الجهاز</th><th>الموديل</th><th>رقم الطلب</th><th>العميل</th><th>الجوال</th><th>الحالة</th><th>تاريخ الطلب</th><th>الإجراء</th></tr></thead>
      <tbody>
      @foreach (var d in Devices)
      {
        <tr>
          <td><b>@d.DeviceCode</b></td>
          <td>@d.Model</td>
          <td>@d.ServiceRequest?.RequestNumber</td>
          <td>@d.ServiceRequest?.CustomerName</td>
          <td>@d.ServiceRequest?.Phone</td>
          <td>@DisplayStatus(d)</td>
          <td>@d.ServiceRequest?.CreatedAt.ToString("yyyy-MM-dd")</td>
          <td><button class="btn small outline" @onclick="() => OpenComment(d)">💬 إضافة ملاحظة</button></td>
        </tr>
        @if (CommentDevice is not null && CommentDevice.Id == d.Id)
        {
          <tr><td colspan="8">
            <div class="panel" style="margin:0;background:#f8fafc">
              @if (ExistingComments.Count > 0)
              {
                <div class="comments-list">@foreach(var c in ExistingComments){<div class="comment-item"><div class="comment-head"><b>@c.CreatedBy</b> <span class="small">(@c.CreatedByRole)</span> <span class="small">— @c.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span></div><div>@c.Text</div></div>}</div>
              }
              <div class="field full"><label>ملاحظة جديدة على الجهاز @d.DeviceCode</label><textarea @bind="NewComment" placeholder="اكتب ملاحظتك هنا..."></textarea></div>
              <div class="actions-bottom"><button class="btn primary" @onclick="SaveComment">حفظ الملاحظة</button><button class="btn gray" @onclick="CloseComment">إغلاق</button></div>
            </div>
          </td></tr>
        }
      }
      </tbody>
    </table>
  }
</div>

@code {
  UserAccount? CurrentUser;
  string StatusFilter = "to_maintenance";
  string SearchName = "", SearchPhone = "", SearchDeviceCode = "", SearchRequestNumber = "", Message = "";
  DateTime? SearchFrom, SearchTo;
  List<ServiceDevice> Devices = new();
  ServiceDevice? CommentDevice; string NewComment = ""; List<DeviceComment> ExistingComments = new();

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    var u = await JS.InvokeAsync<string>("armsTheme.getUser");
    await using var db = await DbFactory.CreateDbContextAsync();
    CurrentUser = await ArmsAuth.ResolveUserAsync(db, u);
    if (CurrentUser?.Role != "خدمة العملاء") { Nav.NavigateTo("/"); return; }
    await ApplyStatusFilter();
    await InvokeAsync(StateHasChanged);
  }

  async Task ApplyStatusFilter()
  {
    Message = "";
    await using var db = await DbFactory.CreateDbContextAsync();
    var q = db.ServiceDevices.Include(x => x.ServiceRequest).Where(x => x.Decision != "مستبعد" && x.Decision != "مهلك" && x.Decision != "مستبدل").AsQueryable();
    q = StatusFilter switch
    {
      "to_maintenance" => q.Where(x => x.CurrentLocation == "في الطريق للصيانة"),
      "ready_for_maintenance" => q.Where(x => x.CurrentLocation == "مركز الصيانة" && x.CurrentStatus == "انتظار" && x.AssignedTechnicianId == null),
      "ready_to_branch" => q.Where(x => x.CurrentLocation == "مستودع الأجهزة الجاهزة للإرجاع" && x.CurrentStatus == "جاهز للإرسال"),
      "paused" => q.Where(x => x.CurrentLocation == "مركز الصيانة" && x.CurrentStatus == "معلق"),
      "ready_for_return" => q.Where(x => x.CurrentLocation == "مركز الصيانة" && x.CurrentStatus == "جاهز للإرجاع"),
      "to_branch" => q.Where(x => x.CurrentLocation == "في الطريق للفرع"),
      _ => q
    };
    Devices = await q.OrderByDescending(x => x.Id).Take(200).ToListAsync();
  }

  async Task Search()
  {
    Message = "";
    var name = SearchName.Trim(); var phone = SearchPhone.Trim(); var code = SearchDeviceCode.Trim(); var reqNo = SearchRequestNumber.Trim();
    if (string.IsNullOrWhiteSpace(name) && string.IsNullOrWhiteSpace(phone) && string.IsNullOrWhiteSpace(code) && string.IsNullOrWhiteSpace(reqNo) && SearchFrom is null && SearchTo is null)
    { Message = "خطأ: أدخل عنصر بحث واحد على الأقل."; return; }
    await using var db = await DbFactory.CreateDbContextAsync();
    var q = db.ServiceDevices.Include(x => x.ServiceRequest).Where(x => x.ServiceRequest != null).AsQueryable();
    if (!string.IsNullOrWhiteSpace(name)) q = q.Where(x => x.ServiceRequest!.CustomerName.Contains(name));
    if (!string.IsNullOrWhiteSpace(phone)) q = q.Where(x => x.ServiceRequest!.Phone.Contains(phone));
    if (!string.IsNullOrWhiteSpace(code)) q = q.Where(x => x.DeviceCode.Contains(code));
    if (!string.IsNullOrWhiteSpace(reqNo)) q = q.Where(x => x.ServiceRequest!.RequestNumber.Contains(reqNo));
    if (SearchFrom.HasValue) q = q.Where(x => x.ServiceRequest!.CreatedAt >= SearchFrom.Value.Date);
    if (SearchTo.HasValue) { var end = SearchTo.Value.Date.AddDays(1); q = q.Where(x => x.ServiceRequest!.CreatedAt < end); }
    Devices = await q.OrderByDescending(x => x.Id).Take(200).ToListAsync();
    if (Devices.Count == 0) Message = "خطأ: لا توجد نتائج مطابقة.";
  }

  void ClearSearch(){ SearchName=""; SearchPhone=""; SearchDeviceCode=""; SearchRequestNumber=""; SearchFrom=null; SearchTo=null; Message=""; _ = ApplyStatusFilter(); }

  async Task OpenComment(ServiceDevice d)
  {
    CommentDevice = d; NewComment = "";
    await using var db = await DbFactory.CreateDbContextAsync();
    ExistingComments = await db.DeviceComments.Where(x => x.ServiceDeviceId == d.Id).OrderByDescending(x => x.CreatedAt).ToListAsync();
  }
  void CloseComment(){ CommentDevice=null; NewComment=""; ExistingComments.Clear(); }

  async Task SaveComment()
  {
    if (CommentDevice is null || CurrentUser is null) return;
    if (string.IsNullOrWhiteSpace(NewComment)) { Message = "خطأ: نص الملاحظة إجباري."; return; }
    await using var db = await DbFactory.CreateDbContextAsync();
    db.DeviceComments.Add(new DeviceComment { ServiceDeviceId = CommentDevice.Id, Text = NewComment.Trim(), CreatedBy = CurrentUser.FullName, CreatedByRole = CurrentUser.Role, CreatedAt = DateTime.Now });
    await db.SaveChangesAsync();
    Message = $"تم إضافة الملاحظة على الجهاز {CommentDevice.DeviceCode}.";
    CloseComment();
  }

  string DisplayStatus(ServiceDevice d) => StatusFilter switch
  {
    "to_maintenance" => "في الطريق للصيانة",
    "ready_for_maintenance" => "جاهز للصيانة",
    "ready_to_branch" => "جاهز للإرسال للفرع",
    "paused" => "معلق",
    "ready_for_return" => "جاهز للإرجاع",
    "to_branch" => "في الطريق للفرع",
    _ => d.CurrentStatus
  };
}
