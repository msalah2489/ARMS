@page "/device-catalog"
@rendermode InteractiveServer
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
<PageTitle>إدارة الأجهزة والملحقات وقطع الغيار</PageTitle>
@if (CurrentUser is null){<div class="empty">جارٍ تحميل الحساب...</div>}
else if (!IsAdmin){<div class="notice danger-notice">هذه الصفحة متاحة لمدير النظام (مدير IT) فقط.</div>}
else{
<div class="page-head"><div><h1>إدارة الأجهزة والملحقات وقطع الغيار</h1><p>إدارة الموديلات والملحقات وقطع الغيار التي تظهر في دورة الصيانة.</p></div><a class="btn outline" href="/admin">← إدارة النظام</a></div>
@if(!string.IsNullOrWhiteSpace(Message)){<div class="notice @(Message.StartsWith("خطأ")?"danger-notice":"success-notice")">@Message</div>}
<div class="panel"><div class="page-head"><h2>موديلات الأجهزة</h2><button class="btn primary" @onclick="StartNewModel">+ إضافة موديل جهاز</button></div>
@if(ModelEditor is not null){<div class="form-grid" style="margin-bottom:14px"><div class="field"><label>اسم الموديل *</label><input @bind="ModelEditor.Name" /></div><div class="field"><label>نوع الجهاز *</label><input @bind="ModelEditor.DeviceType" /></div><div class="field"><label>البراند *</label><input @bind="ModelEditor.Brand" /></div><div class="field"><label>الحالة</label><select value="@(ModelEditor.IsActive ? "true" : "false")" @onchange="SetModelActive"><option value="true">نشط</option><option value="false">موقوف</option></select></div></div><div class="actions-bottom"><button class="btn green" @onclick="SaveModel">حفظ الموديل</button><button class="btn gray" @onclick="CancelModel">إلغاء</button></div>}
<table><thead><tr><th>الموديل</th><th>النوع</th><th>البراند</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody>@foreach(var m in Models){<tr><td><b>@m.Name</b></td><td>@m.DeviceType</td><td>@m.Brand</td><td><span class="pill @(m.IsActive?"green":"red")">@(m.IsActive?"نشط":"موقوف")</span></td><td><button class="btn small" @onclick="()=>EditModel(m)">تعديل</button> <button class="btn small" @onclick="()=>ToggleModel(m)">@(m.IsActive?"إيقاف":"تفعيل")</button></td></tr>}</tbody></table></div>
<div class="panel"><div class="page-head"><h2>الملحقات</h2><button class="btn primary" @onclick="StartNewAccessory">+ إضافة ملحق</button></div><p class="small">«الجهاز» ليس ملحقًا. هذه القائمة هي التي تظهر عند تسجيل الجهاز.</p>
@if(AccessoryEditor is not null){<div class="form-grid" style="margin-bottom:14px"><div class="field"><label>اسم الملحق *</label><input @bind="AccessoryEditor.Name" /></div><div class="field"><label>الحالة</label><select value="@(AccessoryEditor.IsActive ? "true" : "false")" @onchange="SetAccessoryActive"><option value="true">نشط</option><option value="false">موقوف</option></select></div></div><div class="actions-bottom"><button class="btn green" @onclick="SaveAccessory">حفظ الملحق</button><button class="btn gray" @onclick="CancelAccessory">إلغاء</button></div>}
<table><thead><tr><th>الملحق</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody>@foreach(var a in Accessories){<tr><td><b>@a.Name</b></td><td><span class="pill @(a.IsActive?"green":"red")">@(a.IsActive?"نشط":"موقوف")</span></td><td><button class="btn small" @onclick="()=>EditAccessory(a)">تعديل</button> <button class="btn small" @onclick="()=>ToggleAccessory(a)">@(a.IsActive?"إيقاف":"تفعيل")</button></td></tr>}</tbody></table></div>
<div class="panel"><div class="page-head"><h2>قطع الغيار والمخزون</h2><button class="btn primary" @onclick="StartNewPart">+ إضافة قطعة غيار</button></div><p class="small">يمكن ربط القطعة بموديل محدد أو تركها عامة. اللون اختياري. الرصيد ينخفض تلقائيًا عند إنهاء الفني لعملية الصيانة.</p>
@if(PartEditor is not null){<div class="form-grid" style="margin-bottom:14px"><div class="field"><label>اسم قطعة الغيار *</label><input @bind="PartEditor.Name" placeholder="مثال: موتور" /></div><div class="field"><label>اللون (اختياري)</label><input @bind="PartEditor.Color" placeholder="مثال: أبيض" /></div><div class="field"><label>الموديل المرتبط (اختياري)</label><select @bind="PartEditor.CompatibleDeviceModel"><option value="">كل الأجهزة</option>@foreach(var m in Models.Where(x=>x.IsActive)){<option value="@m.Name">@m.Name</option>}</select></div><div class="field"><label>الرصيد الحالي</label><input type="number" min="0" @bind="PartEditor.StockQuantity" /></div><div class="field"><label>الحالة</label><select value="@(PartEditor.IsActive ? "true" : "false")" @onchange="SetPartActive"><option value="true">نشط</option><option value="false">موقوف</option></select></div></div><div class="actions-bottom"><button class="btn green" @onclick="SavePart">حفظ القطعة</button><button class="btn gray" @onclick="CancelPart">إلغاء</button></div>}
<table><thead><tr><th>قطعة الغيار</th><th>اللون</th><th>الجهاز/الموديل المرتبط</th><th>الرصيد</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody>@foreach(var p in SpareParts){<tr><td><b>@p.Name</b></td><td>@(string.IsNullOrWhiteSpace(p.Color)?"—":p.Color)</td><td>@(string.IsNullOrWhiteSpace(p.CompatibleDeviceModel)?"كل الأجهزة":p.CompatibleDeviceModel)</td><td><span class="pill @(p.StockQuantity>0?"green":"red")">@p.StockQuantity</span></td><td><span class="pill @(p.IsActive?"green":"red")">@(p.IsActive?"نشط":"موقوف")</span></td><td><button class="btn small" @onclick="()=>EditPart(p)">تعديل</button> <button class="btn small" @onclick="()=>TogglePart(p)">@(p.IsActive?"إيقاف":"تفعيل")</button></td></tr>}</tbody></table></div>
}
@code {
 UserAccount? CurrentUser; bool IsAdmin=>ArmsAuth.IsSystemAdminRole(CurrentUser?.Role); List<DeviceModel> Models=new(); List<Accessory> Accessories=new(); List<SparePart> SpareParts=new(); DeviceModel? ModelEditor; Accessory? AccessoryEditor; SparePart? PartEditor; string Message="";
 protected override async Task OnAfterRenderAsync(bool firstRender){if(!firstRender)return;var username=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db, username);await Load();await InvokeAsync(StateHasChanged);}
 async Task Load(){await using var db=await DbFactory.CreateDbContextAsync();Models=await db.DeviceModels.OrderBy(x=>x.Name).ToListAsync();Accessories=await db.Accessories.Where(x=>x.Name!="الجهاز").OrderBy(x=>x.Name).ToListAsync();SpareParts=await db.SpareParts.OrderBy(x=>x.Name).ThenBy(x=>x.Color).ToListAsync();}
 void SetModelActive(ChangeEventArgs e){if(ModelEditor is not null)ModelEditor.IsActive=e.Value?.ToString()=="true";} void SetAccessoryActive(ChangeEventArgs e){if(AccessoryEditor is not null)AccessoryEditor.IsActive=e.Value?.ToString()=="true";} void SetPartActive(ChangeEventArgs e){if(PartEditor is not null)PartEditor.IsActive=e.Value?.ToString()=="true";}
 void StartNewModel()=>ModelEditor=new DeviceModel{DeviceType="Diffuser",Brand="Aromatic",IsActive=true}; void EditModel(DeviceModel m)=>ModelEditor=new DeviceModel{Id=m.Id,Name=m.Name,DeviceType=m.DeviceType,Brand=m.Brand,IsActive=m.IsActive}; void CancelModel()=>ModelEditor=null;
 async Task SaveModel(){Message="";if(ModelEditor is null)return;ModelEditor.Name=ModelEditor.Name.Trim();ModelEditor.DeviceType=ModelEditor.DeviceType.Trim();ModelEditor.Brand=ModelEditor.Brand.Trim();if(string.IsNullOrWhiteSpace(ModelEditor.Name)||string.IsNullOrWhiteSpace(ModelEditor.DeviceType)||string.IsNullOrWhiteSpace(ModelEditor.Brand)){Message="خطأ: اسم الموديل والنوع والبراند مطلوبة.";return;}await using var db=await DbFactory.CreateDbContextAsync();if(await db.DeviceModels.AnyAsync(x=>x.Name==ModelEditor.Name&&x.Id!=ModelEditor.Id)){Message="خطأ: هذا الموديل موجود بالفعل.";return;}if(ModelEditor.Id==0)db.DeviceModels.Add(ModelEditor);else{var x=await db.DeviceModels.FindAsync(ModelEditor.Id);if(x is null)return;x.Name=ModelEditor.Name;x.DeviceType=ModelEditor.DeviceType;x.Brand=ModelEditor.Brand;x.IsActive=ModelEditor.IsActive;}await db.SaveChangesAsync();ModelEditor=null;Message="تم حفظ موديل الجهاز.";await Load();}
 async Task ToggleModel(DeviceModel m){await using var db=await DbFactory.CreateDbContextAsync();var x=await db.DeviceModels.FindAsync(m.Id);if(x is null)return;x.IsActive=!x.IsActive;await db.SaveChangesAsync();Message=$"تم {(x.IsActive?"تفعيل":"إيقاف")} الموديل.";await Load();}
 void StartNewAccessory()=>AccessoryEditor=new Accessory{IsActive=true}; void EditAccessory(Accessory a)=>AccessoryEditor=new Accessory{Id=a.Id,Name=a.Name,IsActive=a.IsActive}; void CancelAccessory()=>AccessoryEditor=null;
 async Task SaveAccessory(){Message="";if(AccessoryEditor is null)return;AccessoryEditor.Name=AccessoryEditor.Name.Trim();if(string.IsNullOrWhiteSpace(AccessoryEditor.Name)||AccessoryEditor.Name=="الجهاز"){Message="خطأ: اسم الملحق غير صالح.";return;}await using var db=await DbFactory.CreateDbContextAsync();if(await db.Accessories.AnyAsync(x=>x.Name==AccessoryEditor.Name&&x.Id!=AccessoryEditor.Id)){Message="خطأ: هذا الملحق موجود بالفعل.";return;}if(AccessoryEditor.Id==0)db.Accessories.Add(AccessoryEditor);else{var x=await db.Accessories.FindAsync(AccessoryEditor.Id);if(x is null)return;x.Name=AccessoryEditor.Name;x.IsActive=AccessoryEditor.IsActive;}await db.SaveChangesAsync();AccessoryEditor=null;Message="تم حفظ الملحق.";await Load();}
 async Task ToggleAccessory(Accessory a){await using var db=await DbFactory.CreateDbContextAsync();var x=await db.Accessories.FindAsync(a.Id);if(x is null||x.Name=="الجهاز")return;x.IsActive=!x.IsActive;await db.SaveChangesAsync();Message=$"تم {(x.IsActive?"تفعيل":"إيقاف")} الملحق.";await Load();}
 void StartNewPart()=>PartEditor=new SparePart{IsActive=true,StockQuantity=0}; void EditPart(SparePart p)=>PartEditor=new SparePart{Id=p.Id,Name=p.Name,Color=p.Color,CompatibleDeviceModel=p.CompatibleDeviceModel,StockQuantity=p.StockQuantity,IsActive=p.IsActive}; void CancelPart()=>PartEditor=null;
 async Task SavePart(){Message="";if(PartEditor is null)return;PartEditor.Name=PartEditor.Name.Trim();PartEditor.Color=PartEditor.Color.Trim();PartEditor.CompatibleDeviceModel=PartEditor.CompatibleDeviceModel.Trim();if(string.IsNullOrWhiteSpace(PartEditor.Name)){Message="خطأ: اسم قطعة الغيار إجباري.";return;}if(PartEditor.StockQuantity<0){Message="خطأ: الرصيد لا يمكن أن يكون سالبًا.";return;}await using var db=await DbFactory.CreateDbContextAsync();if(await db.SpareParts.AnyAsync(x=>x.Name==PartEditor.Name&&x.Color==PartEditor.Color&&x.CompatibleDeviceModel==PartEditor.CompatibleDeviceModel&&x.Id!=PartEditor.Id)){Message="خطأ: هذه القطعة مسجلة بالفعل بنفس اللون والارتباط.";return;}if(PartEditor.Id==0)db.SpareParts.Add(PartEditor);else{var x=await db.SpareParts.FindAsync(PartEditor.Id);if(x is null)return;x.Name=PartEditor.Name;x.Color=PartEditor.Color;x.CompatibleDeviceModel=PartEditor.CompatibleDeviceModel;x.StockQuantity=PartEditor.StockQuantity;x.IsActive=PartEditor.IsActive;}await db.SaveChangesAsync();PartEditor=null;Message="تم حفظ قطعة الغيار.";await Load();}
 async Task TogglePart(SparePart p){await using var db=await DbFactory.CreateDbContextAsync();var x=await db.SpareParts.FindAsync(p.Id);if(x is null)return;x.IsActive=!x.IsActive;await db.SaveChangesAsync();Message=$"تم {(x.IsActive?"تفعيل":"إيقاف")} قطعة الغيار.";await Load();}
}
