@page "/devices/{DeviceId:int}/qr"
@rendermode InteractiveServer
@using QRCoder
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
<PageTitle>طباعة QR للجهاز</PageTitle>
@if(Device is null){<div class="empty">جارٍ التحميل...</div>}else{
<div class="print-toolbar no-print"><a class="btn outline" href="/service-requests/@Device.ServiceRequestId">← رجوع لطلب الصيانة</a><button class="btn primary" @onclick="Print">🖨 طباعة النسختين</button></div>
<div class="qr-sheet qr-double"><div class="qr-card"><img src="@QrData(Device.DeviceCode)" /><div class="barcode-label">نسخة تُلصق على الجهاز</div><div class="fake-barcode">@foreach(var w in BarcodeWidths(Device.DeviceCode)){<span style="width:@(w)px"></span>}</div><b>@Device.DeviceCode</b><span>@Device.Model</span><small>@Device.SerialNumber</small><small>@Device.ServiceRequest?.RequestNumber</small></div><div class="qr-card"><img src="@QrData(Device.DeviceCode)" /><div class="barcode-label">نسخة تُرفق/تُلصق على سند الاستلام</div><div class="fake-barcode">@foreach(var w in BarcodeWidths(Device.DeviceCode)){<span style="width:@(w)px"></span>}</div><b>@Device.DeviceCode</b><span>@Device.Model</span><small>@Device.SerialNumber</small><small>@Device.ServiceRequest?.RequestNumber</small></div></div>}
@code{[Parameter]public int DeviceId{get;set;}ServiceDevice? Device;bool printed;protected override async Task OnParametersSetAsync(){await using var db=await DbFactory.CreateDbContextAsync();Device=await db.ServiceDevices.Include(x=>x.ServiceRequest).FirstOrDefaultAsync(x=>x.Id==DeviceId);if(Device?.ReplacementDeviceId.HasValue==true){Device.ReplacementBarcodePrintedAt=DateTime.Now;await db.SaveChangesAsync();}}protected override async Task OnAfterRenderAsync(bool firstRender){if(firstRender&&Device is not null&&!printed){printed=true;await JS.InvokeVoidAsync("window.print");}}string QrData(string value){using var gen=new QRCodeGenerator();using var data=gen.CreateQrCode(value,QRCodeGenerator.ECCLevel.Q);var qr=new PngByteQRCode(data);var bytes=qr.GetGraphic(8);return "data:image/png;base64,"+Convert.ToBase64String(bytes);}int[] BarcodeWidths(string value)=>value.Select((c,i)=>(int)((c*7+i*3)%5)+1).Take(36).ToArray();async Task Print()=>await JS.InvokeVoidAsync("window.print");}
