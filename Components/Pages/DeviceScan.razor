@page "/device-scan"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
<PageTitle>سكان الجهاز</PageTitle>
<div class="page-head">
  <div><h1>📷 سكان الجهاز</h1><p>امسح QR/باركود الجهاز لفتح بطاقة الجهاز وتاريخ الصيانة.</p></div>
</div>
<div class="panel scan-panel">
  <div class="scan-help"><b>طريقة الاستخدام:</b> وجّه كاميرا الهاتف إلى QR/باركود الموجود على الجهاز. بعد القراءة سيفتح النظام بطاقة الجهاز مباشرة.</div>
  @if(Scanning){<div class="scan-video-wrap">
    <video id="deviceScannerVideo" class="scan-video" autoplay muted playsinline></video>
    <div class="scan-frame"></div>
  </div>}
  <canvas id="deviceScannerCanvas" style="display:none"></canvas>
  <div class="toolbar" style="margin-top:12px">
    @if(!Scanning){<button class="btn primary" @onclick="StartScan">📷 فتح الكاميرا</button>}else{<button class="btn danger" @onclick="StopScan">إيقاف الكاميرا</button>}
  </div>
  @if(!string.IsNullOrWhiteSpace(Message)){<div class="notice @(Message.StartsWith("تم")?"success-notice":"warning-notice")" style="margin-top:12px">@Message</div>}
  <div class="divider-title">أو استخدم قارئ الباركود USB / أدخل الكود يدويًا</div>
  <div class="field"><label>كود الجهاز / السيريال / الباركود</label><div class="scan-manual"><input @bind="ManualCode" @bind:event="oninput" placeholder="مثال: DEV-1234ABCD" @onkeydown="HandleKey" /><button class="btn primary" @onclick="FindManual">فتح الجهاز</button></div></div>
</div>
<div class="panel">
  <h3>ما الذي ستراه بعد المسح؟</h3>
  <div class="feature-grid">
    <div class="feature-card">📋 بيانات الجهاز والعميل</div>
    <div class="feature-card">🛠 سجل طلبات الصيانة</div>
    <div class="feature-card">👨‍🔧 الفنيون الذين عملوا عليه</div>
    <div class="feature-card">🔧 قطع الغيار والكميات والتواريخ</div>
    <div class="feature-card">📍 انتقالات الجهاز وحالاته</div>
    <div class="feature-card">📝 شكاوى وأعمال الإصلاح السابقة</div>
  </div>
</div>
@code {
  UserAccount? CurrentUser; bool Scanning; string ManualCode=""; string Message=""; DotNetObjectReference<DeviceScan>? Ref;
  protected override async Task OnInitializedAsync(){var username=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db, username);}
  async Task StartScan(){Message="";try{Ref ??= DotNetObjectReference.Create(this);await JS.InvokeVoidAsync("armsDeviceScanner.start",Ref,"deviceScannerVideo","deviceScannerCanvas");Scanning=true;}catch(Exception ex){Scanning=false;Message=ex.Message;}}
  async Task StopScan(){await JS.InvokeVoidAsync("armsDeviceScanner.stop");Scanning=false;}
  async Task HandleKey(KeyboardEventArgs e){if(e.Key=="Enter")await FindManual();}
  async Task FindManual(){Message="";var code=ManualCode.Trim();if(string.IsNullOrWhiteSpace(code)){Message="أدخل كود الجهاز أو السيريال.";return;}await OpenDevice(code);}
  [JSInvokable] public async Task OnDeviceCodeScanned(string value){await InvokeAsync(async()=>{Scanning=false;await OpenDevice(value);});}
  async Task OpenDevice(string value){var code=value.Trim();if(Uri.TryCreate(code,UriKind.Absolute,out var uri)&&uri.AbsolutePath.Contains("/device-history/")){Nav.NavigateTo(uri.AbsolutePath);return;}await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.Include(x=>x.ServiceRequest).Where(x=>x.DeviceCode==code||x.SerialNumber==code).OrderByDescending(x=>x.Id).FirstOrDefaultAsync();if(d is null){Message=$"لم يتم العثور على جهاز بالكود أو السيريال: {code}";return;}Nav.NavigateTo($"/device-history/{d.Id}");}
  public async ValueTask DisposeAsync(){try{await JS.InvokeVoidAsync("armsDeviceScanner.stop");}catch{}Ref?.Dispose();}
}
