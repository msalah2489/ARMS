@page "/devices"
@rendermode InteractiveServer
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
<PageTitle>الأجهزة</PageTitle>
<div class="page-head"><div><h1>الأجهزة</h1><p>بحث ومراجعة جميع الأجهزة المسجلة فعلياً.</p></div><div class="toolbar">@if(ArmsAuth.IsSystemAdminRole(CurrentUser?.Role)){<a class="btn primary" href="/device-catalog">⚙ إدارة الموديلات والملحقات</a>}</div></div>
<div class="panel">
  <div class="filter-grid">
    <div class="field"><label>بحث</label><input @bind="Search" @bind:event="oninput" placeholder="كود / سيريال / موديل" /></div>
    <div class="field"><label>العميل</label><input @bind="Customer" /></div>
    <div class="field"><label>الموديل</label><input @bind="ModelFilter" /></div>
    <div class="field"><label>فرع المستخدم</label><input value="@Branch" readonly /></div>
    <div class="field"><label>الحالة</label><select @bind="Status" @bind:after="Load"><option value="">كل الحالات</option><option value="ready">جاهز للإرسال</option><option value="excluded">مستبعد</option><option value="sent">مرسل</option></select></div>
  </div>
  <div class="toolbar" style="margin-top:12px"><button class="btn primary" @onclick="Load">بحث / تطبيق الفلاتر</button><button class="btn outline" @onclick="Print">🖨 طباعة القائمة</button></div>
</div>
<div class="panel"><img class="company-print-logo print-only" src="/images/company-logo.png" alt="الشركة"/><div class="print-only report-title">تقرير الأجهزة</div><table><thead><tr><th>الكود</th><th>النوع</th><th>البراند</th><th>الموديل</th><th>السيريال</th><th>العميل</th><th>الفرع</th><th>الموقع الحالي</th><th>شكوى العميل</th><th>تشخيص الفني</th><th>الحالة</th><th>الطلب</th><th class="no-print">QR</th></tr></thead><tbody>@foreach(var d in Items){<tr><td><b>@d.DeviceCode</b></td><td>@d.DeviceType</td><td>@d.Brand</td><td>@d.Model</td><td>@d.SerialNumber</td><td>@d.ServiceRequest?.CustomerName</td><td>@d.ServiceRequest?.Branch</td><td>@d.CurrentLocation</td><td>@(string.IsNullOrWhiteSpace(d.ComplaintDetails)?d.Problem:d.ComplaintDetails)</td><td>@(string.IsNullOrWhiteSpace(d.FaultCause)?"—":d.FaultCause)</td><td><span class="pill @(d.Decision=="مستبعد"?"red":(d.SentAt.HasValue?"blue":"green"))">@(DisplayDeviceStatus(d))</span></td><td><a class="link no-print" href="/service-requests/@d.ServiceRequestId">فتح الطلب</a><span class="print-only">@d.ServiceRequest?.RequestNumber</span></td><td class="no-print"><a class="btn outline" href="/devices/@d.Id/qr">طباعة QR</a>@if(ArmsAuth.IsSystemAdminRole(CurrentUser?.Role)){<a class="btn outline" style="margin-right:4px" href="/device-history/@d.Id">تصحيح الدورة</a>}</td></tr>}</tbody></table></div>
@code {[SupplyParameterFromQuery(Name="status")] public string? QueryStatus{get;set;}string Search="",Customer="",ModelFilter="",Branch="الرياض",Status=""; UserAccount? CurrentUser; bool IsBranch,IsTechnician;List<ServiceDevice> Items=new();protected override async Task OnInitializedAsync(){var username=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db, username);IsBranch=CurrentUser?.Role=="مستخدم فرع";IsTechnician=CurrentUser?.Role is "فني صيانة" or "فني متنقل";Branch=IsBranch?CurrentUser!.Branch:"الرياض";Status=QueryStatus??"";await Load();}async Task Load(){await using var db=await DbFactory.CreateDbContextAsync();var q=db.ServiceDevices.Include(x=>x.ServiceRequest).AsQueryable();if(!string.IsNullOrWhiteSpace(Search)){var s=Search.Trim();q=q.Where(d=>d.DeviceCode.Contains(s)||d.SerialNumber.Contains(s)||d.Model.Contains(s));}if(!string.IsNullOrWhiteSpace(Customer))q=q.Where(d=>d.ServiceRequest!=null&&d.ServiceRequest.CustomerName.Contains(Customer.Trim()));if(!string.IsNullOrWhiteSpace(ModelFilter))q=q.Where(d=>d.Model.Contains(ModelFilter.Trim()));q=q.Where(d=>d.ServiceRequest!=null&&d.ServiceRequest.Branch==Branch);if(IsTechnician)q=q.Where(d=>d.AssignedTechnicianId==CurrentUser!.Id);if(Status=="ready")q=q.Where(d=>d.CurrentLocation=="مستودع الأجهزة الجاهزة للإرجاع"&&d.CurrentStatus=="جاهز للإرسال"&&d.SentAt==null&&d.Decision!="مستبعد"&&d.Decision!="مهلك"&&d.Decision!="مستبدل");else if(Status=="excluded")q=q.Where(d=>d.Decision=="مستبعد");else if(Status=="sent")q=q.Where(d=>d.SentAt!=null);Items=await q.OrderByDescending(d=>d.Id).ToListAsync();}string DisplayDeviceStatus(ServiceDevice d){if(d.Decision=="مستبعد")return "مستبعد";if(d.ReplacedAt.HasValue||d.Decision=="مستبدل")return "مستبدل";if(d.Decision=="مهلك")return "مهلك";if(d.CustomerDeliveredAt.HasValue)return "مغلق";if(d.CurrentStatus=="جاري الصيانة محليًا")return "جاري الصيانة محليًا";if(d.CurrentStatus=="تمت الصيانة محليًا")return "تمت الصيانة محليًا";if(d.CurrentStatus=="تعذر الصيانة المحلية")return "تعذر الصيانة المحلية";if(d.CurrentLocation=="في الطريق للصيانة"||d.CurrentLocation=="في الطريق للفرع")return "مرسل";if(d.MaintenancePaused||d.CurrentStatus=="معلق")return "معلق";if(d.CurrentLocation=="مستودع الأجهزة الجاهزة للإرجاع"&&d.CurrentStatus=="جاهز للإرسال")return "جاهز للإرسال";if(d.MaintenanceCompletedAt.HasValue)return "تمت الصيانة";if(d.MaintenanceStartedAt.HasValue)return "جاري الصيانة";if(d.MaintenanceReceivedAt.HasValue)return "انتظار";return d.Decision;}async Task Print()=>await JS.InvokeVoidAsync("window.print");}
