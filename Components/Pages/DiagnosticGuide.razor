@page "/diagnostic-guide"
@rendermode InteractiveServer
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
<PageTitle>دليل تشخيص الأعطال</PageTitle>
@if(CurrentUser is null){<div class="empty">جارٍ تحميل الحساب...</div>}
else if(CurrentUser.Role!="خدمة العملاء"){<div class="notice danger-notice">هذه الصفحة متاحة لموظفي خدمة العملاء فقط.</div>}
else{
<div class="page-head"><div><h1>دليل تشخيص الأعطال</h1><p>تشخيص تفاعلي حسب موديل الجهاز.</p></div></div>
<div class="panel"><div class="section-title">اختيار موديل الجهاز</div><div class="field"><label>الموديل *</label><select @bind="SelectedModelId" @bind:after="LoadModel"><option value="0">اختر موديل الجهاز</option>@foreach(var m in Models.Where(x=>x.IsActive)){<option value="@m.Id">@m.Name</option>}</select></div>
@if(SelectedModel is not null && (!string.IsNullOrWhiteSpace(SelectedModel.UserGuideUrl)||!string.IsNullOrWhiteSpace(SelectedModel.MediaGuideUrl))){<div class="actions-bottom">@if(!string.IsNullOrWhiteSpace(SelectedModel.UserGuideUrl)){<a class="btn outline" href="@SelectedModel.UserGuideUrl" target="_blank" rel="noopener">📖 دليل المستخدم</a>}@if(!string.IsNullOrWhiteSpace(SelectedModel.MediaGuideUrl)){<a class="btn outline" href="@SelectedModel.MediaGuideUrl" target="_blank" rel="noopener">🎥 الفيديوهات / الصور التوضيحية</a>}</div>}
</div>
@if(SelectedModel is not null){
@if(IsSimplePathConfigured){<div class="actions-bottom"><button class="btn @(ShowAllQuestions?"outline":"primary")" @onclick="()=>ShowAllQuestions=false">التشخيص المبسط</button><button class="btn @(ShowAllQuestions?"primary":"outline")" @onclick="()=>ShowAllQuestions=true">العرض التفصيلي</button></div>}
@if(IsSimplePathConfigured&&!ShowAllQuestions){<div class="panel"><div class="section-title">التشخيص المبسط</div><p class="small">أجب عن السؤال الظاهر فقط؛ سينقلك النظام تلقائيًا إلى الخطوة التالية أو إلى النتيجة.</p>
@if(!string.IsNullOrWhiteSpace(PathResult)){<div class="notice success-notice"><b>نتيجة التشخيص</b><br />@PathResult</div><div class="actions-bottom"><button class="btn primary" @onclick="RestartSimplePath">بدء تشخيص جديد</button><button class="btn outline" @onclick="()=>ShowAllQuestions=true">عرض المشاكل المحتملة</button></div>}
else if(CurrentQuestion is not null){<div class="diagnostic-question"><div><b>@CurrentQuestion.QuestionText</b></div><div class="actions" style="margin-top:12px"><button class="btn primary" @onclick='()=>AnswerCurrent("نعم")'>نعم</button><button class="btn outline" @onclick='()=>AnswerCurrent("لا")'>لا</button></div><div class="actions-bottom"><button class="btn gray" disabled="@(PathHistory.Count==0)" @onclick="BackSimplePath">رجوع للسؤال السابق</button><button class="btn gray" @onclick="RestartSimplePath">إعادة البدء</button></div></div>}
else{<div class="empty">لم يتم إعداد سؤال بداية لمسار التشخيص.</div>}</div>}
else{<div class="panel"><div class="section-title">أسئلة التشخيص</div><p class="small">يمكنك الإجابة على أي سؤال بأي ترتيب. لا يلزم الإجابة على جميع الأسئلة.</p>
@if(Questions.Count==0){<div class="empty">لا توجد أسئلة تشخيصية مسجلة لهذا الموديل.</div>}
else foreach(var q in Questions){<div class="diagnostic-question"><div><b>@q.QuestionText</b></div>@if(q.AnswerType=="نعم/لا"){<div class="actions" style="margin-top:8px"><button class="btn @(Answers.TryGetValue(q.Id,out var a)&&a=="نعم"?"primary":"outline")" @onclick='()=>SetAnswer(q.Id,"نعم")'>نعم</button><button class="btn @(Answers.TryGetValue(q.Id,out var a2)&&a2=="لا"?"primary":"outline")" @onclick='()=>SetAnswer(q.Id,"لا")'>لا</button><button class="btn gray" @onclick="()=>ClearAnswer(q.Id)">مسح</button></div>}else{<div class="field" style="margin-top:8px"><select value="@(Answers.TryGetValue(q.Id,out var av)?av:"")" @onchange='e=>SetAnswer(q.Id,e.Value?.ToString()??"")'><option value="">اختر الإجابة</option>@foreach(var o in q.Options.Where(x=>x.IsActive).OrderBy(x=>x.SortOrder)){<option value="@o.OptionText">@o.OptionText</option>}</select></div>}}</div>}</div>
<div class="panel"><div class="section-title">نتيجة التشخيص</div><div class="diagnostic-summary"><span class="pill red">مستبعد: @Classified("مستبعدة").Count</span><span class="pill yellow">محتمل جدًا: @Classified("محتملة جدًا").Count</span><span class="pill blue">ممكن: @Classified("ممكنة").Count</span></div>
<div class="diagnostic-columns"><div class="diagnostic-group likely"><h3>محتمل جدًا</h3>@ProblemCards("محتملة جدًا")</div><div class="diagnostic-group possible"><h3>ممكن</h3>@ProblemCards("ممكنة")</div><div class="diagnostic-group excluded"><h3>مستبعد</h3>@ProblemCards("مستبعدة")</div></div></div>}
}
}
@code {
 UserAccount? CurrentUser; List<DeviceModel> Models=new(); DeviceModel? SelectedModel; int SelectedModelId; List<DiagnosticQuestion> Questions=new(); List<DiagnosticProblem> Problems=new(); List<DiagnosticRule> Rules=new(); Dictionary<int,string> Answers=new(); DiagnosticQuestion? CurrentQuestion; List<int> PathHistory=new(); string PathResult=""; bool ShowAllQuestions;
 bool IsSimplePathConfigured=>Questions.Any(x=>x.AnswerType=="نعم/لا"&&(x.YesNextQuestionId.HasValue||x.NoNextQuestionId.HasValue||!string.IsNullOrWhiteSpace(x.YesResultText)||!string.IsNullOrWhiteSpace(x.NoResultText)));
 protected override async Task OnAfterRenderAsync(bool firstRender){if(!firstRender)return;var token=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db,token);Models=await db.DeviceModels.OrderBy(x=>x.Name).ToListAsync();await InvokeAsync(StateHasChanged);}
 async Task LoadModel(){Answers.Clear();PathHistory.Clear();PathResult="";ShowAllQuestions=false;if(SelectedModelId==0){SelectedModel=null;Questions=new();Problems=new();Rules=new();CurrentQuestion=null;return;}await using var db=await DbFactory.CreateDbContextAsync();SelectedModel=await db.DeviceModels.FindAsync(SelectedModelId);if(SelectedModel is null)return;Questions=await db.DiagnosticQuestions.Where(x=>x.DeviceModelId==SelectedModelId&&x.IsActive).OrderBy(x=>x.SortOrder).ThenBy(x=>x.Id).ToListAsync();var ids=Questions.Select(x=>x.Id).ToList();var opts=await db.DiagnosticOptions.Where(x=>ids.Contains(x.DiagnosticQuestionId)&&x.IsActive).OrderBy(x=>x.SortOrder).ToListAsync();foreach(var q in Questions)q.Options=opts.Where(x=>x.DiagnosticQuestionId==q.Id).ToList();Problems=await db.DiagnosticProblems.Where(x=>x.DeviceModelId==SelectedModelId&&x.IsActive).OrderBy(x=>x.Id).ToListAsync();var pids=Problems.Select(x=>x.Id).ToList();Rules=await db.DiagnosticRules.Where(x=>pids.Contains(x.DiagnosticProblemId)&&x.IsActive).ToListAsync();CurrentQuestion=FindStartQuestion();StateHasChanged();}
 DiagnosticQuestion? FindStartQuestion(){var following=Questions.SelectMany(x=>new[]{x.YesNextQuestionId,x.NoNextQuestionId}).Where(x=>x.HasValue).Select(x=>x!.Value).ToHashSet();return Questions.Where(x=>x.AnswerType=="نعم/لا"&&!following.Contains(x.Id)).OrderBy(x=>x.SortOrder).ThenBy(x=>x.Id).FirstOrDefault()??Questions.Where(x=>x.AnswerType=="نعم/لا").OrderBy(x=>x.SortOrder).ThenBy(x=>x.Id).FirstOrDefault();}
 void AnswerCurrent(string answer){if(CurrentQuestion is null)return;var current=CurrentQuestion;var nextId=answer=="نعم"?current.YesNextQuestionId:current.NoNextQuestionId;var result=answer=="نعم"?current.YesResultText:current.NoResultText;if(nextId.HasValue){var next=Questions.FirstOrDefault(x=>x.Id==nextId.Value&&x.IsActive);if(next is not null){PathHistory.Add(current.Id);CurrentQuestion=next;PathResult="";StateHasChanged();return;}}PathResult=string.IsNullOrWhiteSpace(result)?"لا توجد نتيجة مسجلة لهذه الإجابة. راجع إعداد المسار المبسط لدى المدير.":result;StateHasChanged();}
 void BackSimplePath(){if(PathHistory.Count==0)return;var id=PathHistory[^1];PathHistory.RemoveAt(PathHistory.Count-1);CurrentQuestion=Questions.FirstOrDefault(x=>x.Id==id);PathResult="";StateHasChanged();}
 void RestartSimplePath(){PathHistory.Clear();PathResult="";CurrentQuestion=FindStartQuestion();StateHasChanged();}
 void SetAnswer(int id,string value){if(string.IsNullOrWhiteSpace(value))Answers.Remove(id);else Answers[id]=value;StateHasChanged();} void ClearAnswer(int id){Answers.Remove(id);StateHasChanged();}
 string Classification(DiagnosticProblem p){var prules=Rules.Where(x=>x.DiagnosticProblemId==p.Id&&Answers.TryGetValue(x.DiagnosticQuestionId,out var a)&&a==x.ExpectedAnswer).ToList();if(prules.Any(x=>x.Classification=="مستبعدة"))return "مستبعدة";if(prules.Any(x=>x.Classification=="محتملة جدًا"))return "محتملة جدًا";return "ممكنة";}
 List<DiagnosticProblem> Classified(string c)=>Problems.Where(x=>Classification(x)==c).ToList();
 RenderFragment ProblemCards(string c)=>builder=>{var seq=0;foreach(var p in Classified(c)){builder.OpenElement(seq++,"div");builder.AddAttribute(seq++,"class","diagnostic-card");builder.OpenElement(seq++,"div");builder.AddAttribute(seq++,"class","diagnostic-card-title");builder.AddContent(seq++,p.ProblemName);builder.CloseElement();builder.OpenElement(seq++,"div");builder.AddAttribute(seq++,"class","small");builder.AddContent(seq++,"السبب: "+(string.IsNullOrWhiteSpace(p.Cause)?"غير مسجل":p.Cause));builder.CloseElement();builder.OpenElement(seq++,"div");builder.AddContent(seq++,"طريقة الحل: "+(string.IsNullOrWhiteSpace(p.Solution)?"غير مسجلة":p.Solution));builder.CloseElement();builder.CloseElement();}if(!Problems.Any(x=>Classification(x)==c)){builder.OpenElement(seq++,"div");builder.AddAttribute(seq++,"class","empty");builder.AddContent(seq++,"لا توجد مشاكل في هذا التصنيف حاليًا.");builder.CloseElement();}};
}
