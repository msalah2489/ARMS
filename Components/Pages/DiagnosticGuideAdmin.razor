@page "/diagnostic-guide-admin"
@rendermode InteractiveServer
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
<PageTitle>دليل تشخيص الأعطال</PageTitle>
@if(CurrentUser is null){<div class="empty">جارٍ تحميل الحساب...</div>}
else if(!IsAdmin){<div class="notice danger-notice">هذه الصفحة متاحة لمدير النظام (مدير IT) فقط.</div>}
else{
<div class="page-head"><div><h1>دليل تشخيص الأعطال</h1><p>إدارة أسئلة التشخيص والمشاكل وقواعد الربط لكل موديل جهاز بشكل مستقل.</p></div></div>
@if(!string.IsNullOrWhiteSpace(Message)){<div class="notice @(Message.StartsWith("خطأ")?"danger-notice":"success-notice")">@Message</div>}
<div class="panel"><div class="section-title">اختيار الموديل</div><div class="form-grid"><div class="field full"><label>الموديل *</label><select @bind="SelectedModelId" @bind:after="LoadSelectedModel"><option value="0">اختر موديل الجهاز</option>@foreach(var m in Models.Where(x=>x.IsActive)){<option value="@m.Id">@m.Name</option>}</select></div></div></div>
@if(SelectedModel is not null){
<div class="panel"><div class="section-title">روابط الموديل</div><div class="form-grid"><div class="field"><label>رابط دليل المستخدم أو مسار ملف PDF</label><input @bind="GuideUrl" placeholder="https://... أو /uploads/manual.pdf" /></div><div class="field"><label>رابط الفيديوهات / الصور التوضيحية</label><input @bind="MediaUrl" placeholder="https://..." /></div></div><div class="actions-bottom"><button class="btn primary" @onclick="SaveLinks">حفظ الروابط</button></div></div>
<div class="panel"><div class="page-head"><h2>الأسئلة التشخيصية</h2><button class="btn primary" @onclick="StartNewQuestion">+ إضافة سؤال</button></div>
@if(QuestionEditor is not null){<div class="form-grid" style="margin-bottom:14px"><div class="field wide"><label>السؤال *</label><input @bind="QuestionEditor.QuestionText" /></div><div class="field"><label>نوع الإجابة *</label><select @bind="QuestionEditor.AnswerType"><option>نعم/لا</option><option>اختيار من متعدد</option></select></div><div class="field"><label>ترتيب العرض</label><input type="number" @bind="QuestionEditor.SortOrder" /></div></div>
@if(QuestionEditor.AnswerType=="اختيار من متعدد"){<div class="field"><label>خيارات الإجابة (خيار في كل سطر) *</label><textarea @bind="QuestionOptionsText" placeholder="أحمر\nأخضر\nوامض\nمطفأة"></textarea></div>}
<div class="actions-bottom"><button class="btn green" @onclick="SaveQuestion">حفظ السؤال</button><button class="btn gray" @onclick="CancelQuestion">إلغاء</button></div>}
<table><thead><tr><th>السؤال</th><th>نوع الإجابة</th><th>الخيارات</th><th>الترتيب</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody>@foreach(var q in Questions){<tr><td>@q.QuestionText</td><td>@q.AnswerType</td><td>@(q.AnswerType=="اختيار من متعدد"?string.Join("، ",q.Options.Where(x=>x.IsActive).OrderBy(x=>x.SortOrder).Select(x=>x.OptionText)):"نعم / لا")</td><td>@q.SortOrder</td><td><span class="pill @(q.IsActive?"green":"red")">@(q.IsActive?"نشط":"موقوف")</span></td><td><button class="btn small" @onclick="()=>EditQuestion(q)">تعديل</button> <button class="btn small" @onclick="()=>ToggleQuestion(q)">@(q.IsActive?"إيقاف":"تفعيل")</button></td></tr>}</tbody></table></div>
<div class="panel"><div class="page-head"><div><h2>التشخيص المبسط المتتابع</h2><p>اختر السؤال التالي أو اكتب النتيجة التي تظهر عند إجابة نعم أو لا. اترك السؤال التالي فارغًا عند انتهاء المسار.</p></div></div>
@foreach(var q in Questions.Where(x=>x.IsActive&&x.AnswerType=="نعم/لا").OrderBy(x=>x.SortOrder)){<div class="diagnostic-question"><b>@q.QuestionText</b><div class="form-grid" style="margin-top:10px"><div class="field"><label>عند الإجابة: نعم، السؤال التالي</label><select @bind="q.YesNextQuestionId"><option value="">لا يوجد سؤال تالٍ — اعرض النتيجة</option>@foreach(var next in Questions.Where(x=>x.IsActive&&x.Id!=q.Id).OrderBy(x=>x.SortOrder)){<option value="@next.Id">@next.QuestionText</option>}</select></div><div class="field wide"><label>نتيجة نعم عند انتهاء المسار</label><input @bind="q.YesResultText" placeholder="مثال: المشكلة ليست من الفيش." /></div><div class="field"><label>عند الإجابة: لا، السؤال التالي</label><select @bind="q.NoNextQuestionId"><option value="">لا يوجد سؤال تالٍ — اعرض النتيجة</option>@foreach(var next in Questions.Where(x=>x.IsActive&&x.Id!=q.Id).OrderBy(x=>x.SortOrder)){<option value="@next.Id">@next.QuestionText</option>}</select></div><div class="field wide"><label>نتيجة لا عند انتهاء المسار</label><input @bind="q.NoResultText" placeholder="مثال: جرّب الجهاز في فيش آخر يعمل." /></div></div></div>}
@if(!Questions.Any(x=>x.IsActive&&x.AnswerType=="نعم/لا")){<div class="empty">أضف أسئلة من نوع نعم/لا أولًا لتكوين مسار مبسط.</div>}<div class="actions-bottom"><button class="btn green" @onclick="SaveSimplePath">حفظ المسار المبسط</button></div></div>
<div class="panel"><div class="page-head"><h2>المشاكل المحتملة</h2><button class="btn primary" @onclick="StartNewProblem">+ إضافة مشكلة</button></div>
@if(ProblemEditor is not null){<div class="form-grid" style="margin-bottom:14px"><div class="field"><label>اسم المشكلة *</label><input @bind="ProblemEditor.ProblemName" /></div><div class="field wide"><label>السبب</label><textarea @bind="ProblemEditor.Cause"></textarea></div><div class="field full"><label>طريقة الحل</label><textarea @bind="ProblemEditor.Solution"></textarea></div></div><div class="actions-bottom"><button class="btn green" @onclick="SaveProblem">حفظ المشكلة</button><button class="btn gray" @onclick="CancelProblem">إلغاء</button></div>}
<table><thead><tr><th>المشكلة</th><th>السبب</th><th>طريقة الحل</th><th>الحالة</th><th>القواعد</th><th>الإجراء</th></tr></thead><tbody>@foreach(var p in Problems){<tr><td><b>@p.ProblemName</b></td><td>@p.Cause</td><td>@p.Solution</td><td><span class="pill @(p.IsActive?"green":"red")">@(p.IsActive?"نشطة":"موقوفة")</span></td><td>@Rules.Count(x=>x.DiagnosticProblemId==p.Id)</td><td><button class="btn small" @onclick="()=>EditProblem(p)">تعديل</button> <button class="btn small" @onclick="()=>ToggleProblem(p)">@(p.IsActive?"إيقاف":"تفعيل")</button></td></tr>}</tbody></table></div>
<div class="panel"><div class="page-head"><h2>قواعد الربط والتصنيف</h2></div>
<div class="form-grid"><div class="field"><label>المشكلة *</label><select @bind="RuleProblemId"><option value="0">اختر المشكلة</option>@foreach(var p in Problems.Where(x=>x.IsActive)){<option value="@p.Id">@p.ProblemName</option>}</select></div><div class="field"><label>السؤال *</label><select @bind="RuleQuestionId" @bind:after="RefreshRuleAnswers"><option value="0">اختر السؤال</option>@foreach(var q in Questions.Where(x=>x.IsActive).OrderBy(x=>x.SortOrder)){<option value="@q.Id">@q.QuestionText</option>}</select></div><div class="field"><label>الإجابة المطابقة *</label><select @bind="RuleExpectedAnswer"><option value="">اختر الإجابة</option>@foreach(var a in RuleAnswers){<option value="@a">@a</option>}</select></div><div class="field"><label>التصنيف عند تحقق القاعدة *</label><select @bind="RuleClassification"><option>محتملة جدًا</option><option>مستبعدة</option></select></div></div><div class="actions-bottom"><button class="btn green" @onclick="AddRule">+ إضافة القاعدة</button></div>
<table><thead><tr><th>المشكلة</th><th>السؤال</th><th>الإجابة</th><th>التصنيف</th><th>الإجراء</th></tr></thead><tbody>@foreach(var r in Rules){var q=Questions.FirstOrDefault(x=>x.Id==r.DiagnosticQuestionId);var p=Problems.FirstOrDefault(x=>x.Id==r.DiagnosticProblemId);<tr><td>@p?.ProblemName</td><td>@q?.QuestionText</td><td>@r.ExpectedAnswer</td><td><span class="pill @(r.Classification=="مستبعدة"?"red":"yellow")">@r.Classification</span></td><td><button class="btn small danger" @onclick="()=>DeleteRule(r)">حذف</button></td></tr>}</tbody></table></div>
}
}
@code {
 UserAccount? CurrentUser; bool IsAdmin=>ArmsAuth.IsSystemAdminRole(CurrentUser?.Role); List<DeviceModel> Models=new(); DeviceModel? SelectedModel; int SelectedModelId; List<DiagnosticQuestion> Questions=new(); List<DiagnosticProblem> Problems=new(); List<DiagnosticRule> Rules=new(); DiagnosticQuestion? QuestionEditor; DiagnosticProblem? ProblemEditor; string QuestionOptionsText="",GuideUrl="",MediaUrl="",Message="",RuleExpectedAnswer="",RuleClassification="محتملة جدًا"; int RuleProblemId,RuleQuestionId; List<string> RuleAnswers=new();
 protected override async Task OnAfterRenderAsync(bool firstRender){if(!firstRender)return;var token=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db,token);Models=await db.DeviceModels.OrderBy(x=>x.Name).ToListAsync();await InvokeAsync(StateHasChanged);}
 async Task LoadSelectedModel(){Message="";if(SelectedModelId==0){SelectedModel=null;Questions=new();Problems=new();Rules=new();return;}await using var db=await DbFactory.CreateDbContextAsync();SelectedModel=await db.DeviceModels.FindAsync(SelectedModelId);if(SelectedModel is null)return;GuideUrl=SelectedModel.UserGuideUrl;MediaUrl=SelectedModel.MediaGuideUrl;Questions=await db.DiagnosticQuestions.Where(x=>x.DeviceModelId==SelectedModelId).OrderBy(x=>x.SortOrder).ThenBy(x=>x.Id).ToListAsync();var ids=Questions.Select(x=>x.Id).ToList();var opts=await db.DiagnosticOptions.Where(x=>ids.Contains(x.DiagnosticQuestionId)).OrderBy(x=>x.SortOrder).ToListAsync();foreach(var q in Questions)q.Options=opts.Where(x=>x.DiagnosticQuestionId==q.Id).ToList();Problems=await db.DiagnosticProblems.Where(x=>x.DeviceModelId==SelectedModelId).OrderBy(x=>x.Id).ToListAsync();var pids=Problems.Select(x=>x.Id).ToList();Rules=await db.DiagnosticRules.Where(x=>pids.Contains(x.DiagnosticProblemId)&&x.IsActive).OrderBy(x=>x.Id).ToListAsync();RefreshRuleAnswers();StateHasChanged();}
 async Task SaveLinks(){if(SelectedModel is null)return;await using var db=await DbFactory.CreateDbContextAsync();var m=await db.DeviceModels.FindAsync(SelectedModel.Id);if(m is null)return;m.UserGuideUrl=GuideUrl.Trim();m.MediaGuideUrl=MediaUrl.Trim();await db.SaveChangesAsync();Message="تم حفظ روابط الموديل.";await LoadSelectedModel();}
 void StartNewQuestion()=>QuestionEditor=new DiagnosticQuestion{DeviceModelId=SelectedModelId,AnswerType="نعم/لا",IsActive=true,SortOrder=Questions.Count+1}; void CancelQuestion()=>QuestionEditor=null; void EditQuestion(DiagnosticQuestion q){QuestionEditor=new DiagnosticQuestion{Id=q.Id,DeviceModelId=q.DeviceModelId,QuestionText=q.QuestionText,AnswerType=q.AnswerType,SortOrder=q.SortOrder,IsActive=q.IsActive};QuestionOptionsText=string.Join("\n",q.Options.OrderBy(x=>x.SortOrder).Select(x=>x.OptionText));} void SetMessage(string m)=>Message=m;
 async Task SaveQuestion(){Message="";if(QuestionEditor is null||SelectedModel is null)return;QuestionEditor.QuestionText=QuestionEditor.QuestionText.Trim();if(string.IsNullOrWhiteSpace(QuestionEditor.QuestionText)){Message="خطأ: نص السؤال إجباري.";return;}var options=QuestionOptionsText.Split(new[]{'\r','\n'},StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries).Where(x=>x.Length>0).Distinct().ToList();if(QuestionEditor.AnswerType=="اختيار من متعدد"&&options.Count<2){Message="خطأ: يجب إضافة خيارين على الأقل للسؤال متعدد الخيارات.";return;}await using var db=await DbFactory.CreateDbContextAsync();DiagnosticQuestion q;if(QuestionEditor.Id==0){q=QuestionEditor;db.DiagnosticQuestions.Add(q);await db.SaveChangesAsync();}else{q=await db.DiagnosticQuestions.FindAsync(QuestionEditor.Id);if(q is null)return;q.QuestionText=QuestionEditor.QuestionText;q.AnswerType=QuestionEditor.AnswerType;q.SortOrder=QuestionEditor.SortOrder;q.IsActive=QuestionEditor.IsActive;await db.SaveChangesAsync();}var old=await db.DiagnosticOptions.Where(x=>x.DiagnosticQuestionId==q.Id).ToListAsync();db.DiagnosticOptions.RemoveRange(old);if(q.AnswerType=="اختيار من متعدد"){for(var i=0;i<options.Count;i++)db.DiagnosticOptions.Add(new DiagnosticOption{DiagnosticQuestionId=q.Id,OptionText=options[i],SortOrder=i+1,IsActive=true});}await db.SaveChangesAsync();QuestionEditor=null;QuestionOptionsText="";Message="تم حفظ السؤال.";await LoadSelectedModel();}
 async Task ToggleQuestion(DiagnosticQuestion q){await using var db=await DbFactory.CreateDbContextAsync();var x=await db.DiagnosticQuestions.FindAsync(q.Id);if(x is null)return;x.IsActive=!x.IsActive;await db.SaveChangesAsync();Message=$"تم {(x.IsActive?"تفعيل":"إيقاف")} السؤال.";await LoadSelectedModel();}
 async Task SaveSimplePath(){if(SelectedModel is null)return;await using var db=await DbFactory.CreateDbContextAsync();var ids=Questions.Select(x=>x.Id).ToHashSet();foreach(var source in Questions.Where(x=>x.AnswerType=="نعم/لا")){var q=await db.DiagnosticQuestions.FindAsync(source.Id);if(q is null)continue;q.YesNextQuestionId=source.YesNextQuestionId.HasValue&&source.YesNextQuestionId!=source.Id&&ids.Contains(source.YesNextQuestionId.Value)?source.YesNextQuestionId:null;q.NoNextQuestionId=source.NoNextQuestionId.HasValue&&source.NoNextQuestionId!=source.Id&&ids.Contains(source.NoNextQuestionId.Value)?source.NoNextQuestionId:null;q.YesResultText=source.YesResultText?.Trim()??"";q.NoResultText=source.NoResultText?.Trim()??"";}await db.SaveChangesAsync();Message="تم حفظ مسار التشخيص المبسط.";await LoadSelectedModel();}
 void StartNewProblem()=>ProblemEditor=new DiagnosticProblem{DeviceModelId=SelectedModelId,IsActive=true}; void CancelProblem()=>ProblemEditor=null; void EditProblem(DiagnosticProblem p)=>ProblemEditor=new DiagnosticProblem{Id=p.Id,DeviceModelId=p.DeviceModelId,ProblemName=p.ProblemName,Cause=p.Cause,Solution=p.Solution,IsActive=p.IsActive};
 async Task SaveProblem(){Message="";if(ProblemEditor is null)return;ProblemEditor.ProblemName=ProblemEditor.ProblemName.Trim();if(string.IsNullOrWhiteSpace(ProblemEditor.ProblemName)){Message="خطأ: اسم المشكلة إجباري.";return;}await using var db=await DbFactory.CreateDbContextAsync();if(ProblemEditor.Id==0)db.DiagnosticProblems.Add(ProblemEditor);else{var x=await db.DiagnosticProblems.FindAsync(ProblemEditor.Id);if(x is null)return;x.ProblemName=ProblemEditor.ProblemName;x.Cause=ProblemEditor.Cause;x.Solution=ProblemEditor.Solution;x.IsActive=ProblemEditor.IsActive;}await db.SaveChangesAsync();ProblemEditor=null;Message="تم حفظ المشكلة.";await LoadSelectedModel();}
 async Task ToggleProblem(DiagnosticProblem p){await using var db=await DbFactory.CreateDbContextAsync();var x=await db.DiagnosticProblems.FindAsync(p.Id);if(x is null)return;x.IsActive=!x.IsActive;await db.SaveChangesAsync();Message=$"تم {(x.IsActive?"تفعيل":"إيقاف")} المشكلة.";await LoadSelectedModel();}
 void RefreshRuleAnswers(){RuleAnswers=new();var q=Questions.FirstOrDefault(x=>x.Id==RuleQuestionId);if(q is null)return;if(q.AnswerType=="نعم/لا")RuleAnswers.AddRange(new[]{"نعم","لا"});else RuleAnswers.AddRange(q.Options.Where(x=>x.IsActive).OrderBy(x=>x.SortOrder).Select(x=>x.OptionText));if(!RuleAnswers.Contains(RuleExpectedAnswer))RuleExpectedAnswer="";}
 async Task AddRule(){Message="";if(RuleProblemId==0||RuleQuestionId==0||string.IsNullOrWhiteSpace(RuleExpectedAnswer)){Message="خطأ: المشكلة والسؤال والإجابة مطلوبة.";return;}var q=Questions.FirstOrDefault(x=>x.Id==RuleQuestionId);var p=Problems.FirstOrDefault(x=>x.Id==RuleProblemId);if(q is null||p is null||q.DeviceModelId!=SelectedModelId||p.DeviceModelId!=SelectedModelId){Message="خطأ: يجب أن تكون المشكلة والسؤال من نفس الموديل.";return;}await using var db=await DbFactory.CreateDbContextAsync();if(await db.DiagnosticRules.AnyAsync(x=>x.DiagnosticProblemId==RuleProblemId&&x.DiagnosticQuestionId==RuleQuestionId&&x.ExpectedAnswer==RuleExpectedAnswer&&x.Classification==RuleClassification&&x.IsActive)){Message="خطأ: القاعدة موجودة بالفعل.";return;}db.DiagnosticRules.Add(new DiagnosticRule{DiagnosticProblemId=RuleProblemId,DiagnosticQuestionId=RuleQuestionId,ExpectedAnswer=RuleExpectedAnswer,Classification=RuleClassification,IsActive=true});await db.SaveChangesAsync();Message="تمت إضافة القاعدة.";RuleExpectedAnswer="";await LoadSelectedModel();}
 async Task DeleteRule(DiagnosticRule r){await using var db=await DbFactory.CreateDbContextAsync();var x=await db.DiagnosticRules.FindAsync(r.Id);if(x is null)return;x.IsActive=false;await db.SaveChangesAsync();Message="تم حذف القاعدة.";await LoadSelectedModel();}
}
