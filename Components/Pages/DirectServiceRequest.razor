@page "/direct-service-request"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using QRCoder
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
<PageTitle>طلب عميل مباشر</PageTitle>
@if(CurrentUser is null){<div class="empty">جارٍ التحميل...</div>}
else if(!CanView){<div class="notice danger-notice">هذه الصفحة غير متاحة لهذا الحساب.</div>}
else{
<div class="page-head"><div><h1>طلب صيانة من عميل مباشر</h1><p>إنشاء QR للعميل قبل الشحن، وربط الجهاز ببوليصة الشحن إلى المستودع.</p></div></div>
@if(CanCreate){
@if(!string.IsNullOrWhiteSpace(Message)){<div class="notice @(Message.StartsWith("خطأ")?"danger-notice":"success-notice")">@Message</div>}
<div class="panel"><div class="section-title">بيانات العميل والجهاز</div><div class="form-grid">
<div class="field"><label>اسم العميل *</label><input @bind="CustomerName" /></div><div class="field"><label>الجوال *</label><input @bind="Phone" /></div><div class="field"><label>الرقم التسلسلي</label><input @bind="SerialNumber" @bind:after="LookupSerial" /><div class="small">إذا كان السيريال مسجلًا، يسترجع ARMS بيانات الجهاز تلقائيًا ولا يسمح بتكراره.</div>@if(!string.IsNullOrWhiteSpace(SerialLookupMessage)){<div class="small">@SerialLookupMessage</div>}</div><div class="field"><label>الموديل *</label><select @bind="Model"><option value="">اختر الموديل</option>@foreach(var m in Models){<option value="@m.Name">@m.Name</option>}</select></div><div class="field"><label>اللون</label><input @bind="Color" /></div><div class="field"><label>شكوى العميل</label><input @bind="Complaint" /></div><div class="field"><label>شركة الشحن *</label><input @bind="Carrier" /></div><div class="field"><label>رقم البوليصة *</label><input @bind="ShipmentNumber" /></div>
</div><div class="actions-bottom"><button class="btn primary" @onclick="Create">إنشاء الطلب وQR</button></div></div>
@if(Device is not null){<div class="panel"><div class="section-title">تم إنشاء الجهاز</div><div class="info-grid"><div><label>كود الجهاز</label><b>@Device.DeviceCode</b></div><div><label>الموديل</label><b>@Device.Model</b></div><div><label>الحالة</label><span class="pill yellow">في الطريق للمستودع</span></div></div><div class="qr-preview"><img src="@QrData(Device.DeviceCode)" alt="QR الجهاز" /><div><b>اطبع الـQR وألصقه على الجهاز قبل تسليمه لشركة الشحن.</b><div class="actions-bottom"><a class="btn outline" href="@($"/devices/{Device.Id}/qr")">🖨 طباعة QR</a></div></div></div></div>}
}
@if(!CanCreate){
<div class="panel"><div class="section-title">العملاء المباشرون — متابعة</div><p class="small">مشرف الصيانة لديه صلاحية عرض فقط: يمكنه متابعة طلبات العملاء المباشرين وحالات الشحن دون إنشاء أو تعديل البوليصة.</p>
@if(RecentDirect.Any()){<table><thead><tr><th>الطلب</th><th>العميل</th><th>الجوال</th><th>الجهاز</th><th>الحالة</th><th>الموقع</th></tr></thead><tbody>@foreach(var d in RecentDirect){<tr><td>@d.ServiceRequest?.RequestNumber</td><td>@d.ServiceRequest?.CustomerName</td><td>@d.ServiceRequest?.Phone</td><td>@d.DeviceCode</td><td>@d.CurrentStatus</td><td>@d.CurrentLocation</td></tr>}</tbody></table>}else{<div class="empty">لا توجد طلبات عملاء مباشرين مسجلة.</div>}
</div>}
}
@code{UserAccount? CurrentUser;bool CanCreate=>CurrentUser?.Role is "مدير صيانة" or "مدير عام ARMS" or "مدير رئيسي";bool CanView=>CurrentUser?.Role is "مشرف صيانة" or "مدير صيانة" or "مدير عام ARMS" or "مدير رئيسي";List<ServiceDevice> RecentDirect=new();List<DeviceModel> Models=new();string CustomerName="",Phone="",SerialNumber="",SerialLookupMessage="",Model="",Color="",Complaint="",Carrier="",ShipmentNumber="",Message="";ServiceDevice? Device;async Task LookupSerial(){SerialLookupMessage="";if(string.IsNullOrWhiteSpace(SerialNumber))return;await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.FirstOrDefaultAsync(x=>x.SerialNumber==SerialNumber.Trim());if(d is null){SerialLookupMessage="السيريال غير مسجل سابقًا — يمكن تسجيله.";return;}Model=d.Model;Color=d.Color;SerialLookupMessage=$"تم العثور على الجهاز {d.DeviceCode} — {d.Model} — {(string.IsNullOrWhiteSpace(d.Color)?"اللون غير محدد":d.Color)}. لن يسمح النظام بإنشاء جهاز آخر بنفس السيريال.";}
protected override async Task OnInitializedAsync(){var token=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db,token);if(CanCreate)Models=await db.DeviceModels.Where(x=>x.IsActive).OrderBy(x=>x.Name).ToListAsync();RecentDirect=await db.ServiceDevices.Include(x=>x.ServiceRequest).Where(x=>x.ServiceRequest!=null&&x.ServiceRequest.IntakeSource=="عميل مباشر").OrderByDescending(x=>x.Id).Take(50).ToListAsync();}async Task Create(){Message="";if(string.IsNullOrWhiteSpace(CustomerName)||string.IsNullOrWhiteSpace(Phone)||string.IsNullOrWhiteSpace(Model)||string.IsNullOrWhiteSpace(Carrier)||string.IsNullOrWhiteSpace(ShipmentNumber)){Message="خطأ: اسم العميل والجوال والموديل وشركة الشحن ورقم البوليصة كلها إجبارية.";return;}await using var db=await DbFactory.CreateDbContextAsync();if(!string.IsNullOrWhiteSpace(SerialNumber)&&await db.ServiceDevices.AnyAsync(x=>x.SerialNumber==SerialNumber.Trim())){Message=$"خطأ: الرقم التسلسلي {SerialNumber.Trim()} مسجل مسبقًا لجهاز آخر. تم استرجاع بياناته بالأعلى ولا يمكن تكراره.";return;}var customer=await db.Customers.FirstOrDefaultAsync(x=>x.Phone==Phone.Trim());if(customer is null){customer=new Customer{Name=CustomerName.Trim(),Phone=Phone.Trim(),Branch="عميل مباشر"};db.Customers.Add(customer);}else customer.Name=CustomerName.Trim();var request=new ServiceRequest{RequestNumber=await NextRequestNumber(db),CustomerName=CustomerName.Trim(),Phone=Phone.Trim(),Branch="عميل مباشر",Priority="عادي",Status="في الطريق للصيانة",CreatedBy=CurrentUser!.FullName,ServiceType="صيانة جهاز",IntakeSource="عميل مباشر",OriginName=CustomerName.Trim(),CreatedAt=DateTime.Now,ReceivedAt=DateTime.Now};var d=new ServiceDevice{DeviceCode="DEV-"+Guid.NewGuid().ToString("N")[..8].ToUpper(),Model=Model,Color=Color.Trim(),DeviceType="Diffuser",Brand="Aromatic",ComplaintDetails=Complaint.Trim(),SerialNumber=SerialNumber.Trim(),Decision="جاهز للإرسال",CurrentLocation="في الطريق إلى الصيانة",CurrentStatus="مرسل إلى مركز الصيانة",MaintenanceRoute="مركز الصيانة",SentAt=DateTime.Now};request.Devices.Add(d);db.ServiceRequests.Add(request);await db.SaveChangesAsync();var batch=new ShippingBatch{BatchNumber=$"IN-{DateTime.Now:yyyyMMddHHmmss}",ShipmentNumber=ShipmentNumber.Trim(),Carrier=Carrier.Trim(),Direction="إرسال للصيانة",SourceType="عميل مباشر",SourceName=CustomerName.Trim(),DestinationType="مستودع",DestinationName="المستودع",Status="جاري النقل",CreatedAt=DateTime.Now,CreatedBy=CurrentUser.FullName};db.ShippingBatches.Add(batch);await db.SaveChangesAsync();db.ShippingBatchItems.Add(new ShippingBatchItem{ShippingBatchId=batch.Id,ServiceDeviceId=d.Id,DeviceCodeSnapshot=d.DeviceCode,ModelSnapshot=d.Model,ColorSnapshot=d.Color});db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.Id==0?request.Id:d.ServiceRequestId,Status="مرسل إلى مركز الصيانة",Location="في الطريق إلى الصيانة",StartedAt=DateTime.Now,ChangedBy=CurrentUser.FullName,Notes=$"شحن مباشر من العميل — بوليصة {ShipmentNumber}"});await db.SaveChangesAsync();Device=d;Message=$"تم إنشاء الطلب {request.RequestNumber} والجهاز {d.DeviceCode}. يجب طباعة QR وإلصاقه قبل استلام شركة الشحن.";}async Task<string> NextRequestNumber(ArmsDbContext db){var count=await db.ServiceRequests.CountAsync()+1;return $"SR-{DateTime.Now:yyyy}-{count:000000}";}string QrData(string value){using var gen=new QRCodeGenerator();using var data=gen.CreateQrCode(value,QRCodeGenerator.ECCLevel.Q);var qr=new PngByteQRCode(data);return "data:image/png;base64,"+Convert.ToBase64String(qr.GetGraphic(8));}}
