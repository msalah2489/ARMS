@page "/service-requests/{RequestId:int}/edit"
@rendermode InteractiveServer
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
<PageTitle>تعديل طلب الصيانة</PageTitle>
@if(Request is null){<div class="empty">جارٍ التحميل...</div>}
else if(!IsBranch && !IsIT || Request.SentAt.HasValue || Request.Status=="ملغى"){<div class="notice info-notice">تعديل الطلب متاح لمستخدم الفرع فقط وقبل إرسال الطلب.</div>}
else{
<div class="page-head"><div><h1>تعديل طلب الصيانة</h1><p>قبل الإرسال يمكن تعديل الموديل، شكوى العميل، الملحقات والحالة الخارجية للجهاز.</p></div><a class="btn outline" href="/service-requests/@Request.Id">رجوع</a></div>
<div class="panel"><div class="form-grid"><div class="field"><label>رقم الطلب</label><input value="@Request.RequestNumber" readonly /></div><div class="field"><label>العميل</label><input value="@Request.CustomerName" readonly /></div><div class="field"><label>الجوال</label><input value="@Request.Phone" readonly /></div><div class="field"><label>فرع المستخدم</label><input value="@Request.Branch" readonly /></div><div class="field"><label>الأولوية</label><input value="@Request.Priority" readonly /></div></div><div class="notice info-notice">لا يمكن تعديل العميل أو الجوال أو الأولوية أو حالة الطلب من هذه الصفحة.</div></div>
<div class="panel"><div class="page-head"><h2>أجهزة الطلب</h2><span class="small">التعديلات المسموح بها قبل الإرسال</span></div><table><thead><tr><th>الكود</th><th>الموديل</th><th>السيريال</th><th>شكوى العميل</th><th>الحالة الخارجية</th><th>الملحقات</th><th></th></tr></thead><tbody>@foreach(var d in Request.Devices){<tr><td>@d.DeviceCode</td><td><select class="inline-input" @bind="d.Model"><option value="">اختر الموديل</option>@foreach(var m in DeviceModels.Where(x=>x.IsActive || x.Name==d.Model)){<option value="@m.Name">@m.Name</option>}</select></td><td>@d.SerialNumber</td><td><input class="inline-input" @bind="d.ComplaintDetails" /></td><td><select class="inline-input" @bind="d.ExternalCondition"><option>سليم</option><option>خدوش</option><option>كسر</option><option>آثار سقوط</option><option>مفقود أجزاء</option><option>آثار زيت / ماء</option><option>صدأ</option></select></td><td><div class="check-grid">@if(Accessories.Any()){@foreach(var a in Accessories){<label><input type="checkbox" checked="@HasAccessory(d,a)" @onchange="e=>ToggleAccessory(d,a,(bool)e.Value!)" /> @a</label>}}else{<span class="small">لا توجد ملحقات مسجلة لهذا الجهاز</span>}</div></td><td><button class="btn outline" @onclick="()=>SaveDevice(d)">حفظ</button></td></tr>}</tbody></table></div>
@if(!string.IsNullOrWhiteSpace(Message)){<div class="notice @(Message.StartsWith("خطأ")?"danger-notice":"success-notice")">@Message</div>}}
@code {
 [Parameter] public int RequestId{get;set;} ServiceRequest? Request; string Message=""; UserAccount? CurrentUser; bool IsBranch;bool IsIT; List<DeviceModel> DeviceModels=new(); List<string> Accessories=new();
 protected override async Task OnParametersSetAsync(){var username=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db, username);IsBranch=CurrentUser?.Role=="مستخدم فرع";IsIT=CurrentUser?.Role is "مدير عام ARMS" or "مدير رئيسي";DeviceModels=await db.DeviceModels.Where(x=>x.IsActive).OrderBy(x=>x.Name).ToListAsync();Accessories=await db.Accessories.Where(x=>x.IsActive&&x.Name!="الجهاز").OrderBy(x=>x.Name).Select(x=>x.Name).ToListAsync();Request=await db.ServiceRequests.Include(x=>x.Devices).FirstOrDefaultAsync(x=>x.Id==RequestId);if(IsBranch&&Request is not null&&NormalizeBranch(Request.Branch)!=NormalizeBranch(CurrentUser!.Branch))Request=null;}
 static string NormalizeBranch(string? value)=>(value??"").Trim().Replace("فرع ","").Replace("فرع","").Trim();
 List<string> GetRegisteredAccessories(ServiceDevice d)=>d.Accessories.Split(';',StringSplitOptions.RemoveEmptyEntries).Select(x=>x.Trim()).Where(x=>!string.IsNullOrWhiteSpace(x)&&x!="الجهاز").Distinct().ToList();
 bool HasAccessory(ServiceDevice d,string a)=>GetRegisteredAccessories(d).Contains(a);
 void ToggleAccessory(ServiceDevice d,string a,bool on){var list=d.Accessories.Split(';',StringSplitOptions.RemoveEmptyEntries).Select(x=>x.Trim()).Where(x=>!string.IsNullOrWhiteSpace(x)&&x!="الجهاز").Distinct().ToList();if(on&&!list.Contains(a))list.Add(a);if(!on)list.Remove(a);d.Accessories=string.Join(';',list);}
 async Task SaveDevice(ServiceDevice d){d.Accessories=string.Join(';',d.Accessories.Split(';',StringSplitOptions.RemoveEmptyEntries).Select(x=>x.Trim()).Where(x=>!string.IsNullOrWhiteSpace(x)&&x!="الجهاز"));Message="";if(!IsBranch||Request is null||Request.SentAt.HasValue||Request.Status=="ملغى"){Message="خطأ: لا يمكن تعديل الطلب بعد إرساله.";return;}if(string.IsNullOrWhiteSpace(d.Model)){Message="خطأ: موديل الجهاز إجباري.";return;}if(string.IsNullOrWhiteSpace(d.ComplaintDetails)){Message="خطأ: شكوى العميل إجباريّة.";return;}await using var db=await DbFactory.CreateDbContextAsync();var existing=await db.ServiceDevices.FirstOrDefaultAsync(x=>x.Id==d.Id&&x.ServiceRequestId==Request.Id);if(existing is null){Message="خطأ: الجهاز غير موجود ضمن الطلب.";return;}var originalLocation=existing.CurrentLocation;var originalStatus=existing.CurrentStatus;var originalRoute=existing.MaintenanceRoute;var originalSentAt=existing.SentAt;var originalReceivedAt=existing.MaintenanceReceivedAt;var originalAssignedId=existing.AssignedTechnicianId;var originalAssignedName=existing.AssignedTechnicianName;existing.Model=d.Model.Trim();existing.ComplaintDetails=d.ComplaintDetails.Trim();existing.ExternalCondition=d.ExternalCondition;existing.Accessories=d.Accessories;existing.CurrentLocation=originalLocation;existing.CurrentStatus=originalStatus;existing.MaintenanceRoute=originalRoute;existing.SentAt=originalSentAt;existing.MaintenanceReceivedAt=originalReceivedAt;existing.AssignedTechnicianId=originalAssignedId;existing.AssignedTechnicianName=originalAssignedName;await db.SaveChangesAsync();Message="تم حفظ تعديلات الجهاز.";Request=await db.ServiceRequests.Include(x=>x.Devices).FirstAsync(x=>x.Id==Request.Id);}
}
