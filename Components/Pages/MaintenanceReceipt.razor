@page "/service-requests/receiving/receipt"
@rendermode InteractiveServer
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
<PageTitle>نموذج استلام الصيانة</PageTitle>
@if(Devices.Count==0){<div class="empty">لا توجد أجهزة في نموذج الاستلام.</div>}
else{<div class="print-toolbar no-print"><button class="btn primary" @onclick="Print">🖨 طباعة النموذج</button></div><div class="panel"><h1>نموذج استلام أجهزة للصيانة</h1><p>تاريخ الاستلام: <b>@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</b></p><p>المشرف: <b>@CurrentUserName</b></p><table><thead><tr><th>كود الجهاز</th><th>الموديل</th><th>Serial</th><th>الطلب</th><th>الفرع</th><th>الحالة</th></tr></thead><tbody>@foreach(var d in Devices){<tr><td>@d.DeviceCode</td><td>@d.Model</td><td>@d.SerialNumber</td><td>@d.ServiceRequest?.RequestNumber</td><td>@d.ServiceRequest?.Branch</td><td>تم الاستلام بالصيانة</td></tr>}</tbody></table><div style="margin-top:50px;display:flex;justify-content:space-between"><span>توقيع المندوب: __________________</span><span>توقيع المشرف: __________________</span></div></div>}
@code{
    List<ServiceDevice> Devices=new();
    string CurrentUserName="";
    protected override async Task OnInitializedAsync()
    {
        var uri=new Uri(Nav.Uri);
        var raw=uri.Query.StartsWith("?ids=",StringComparison.OrdinalIgnoreCase)?uri.Query[5..]:"";
        var ids=(raw.Split('&')[0]).Split(',',StringSplitOptions.RemoveEmptyEntries).Select(x=>int.TryParse(x,out var n)?n:0).Where(x=>x>0).ToList();
        await using var db=await DbFactory.CreateDbContextAsync();
        Devices=await db.ServiceDevices.Include(x=>x.ServiceRequest).Where(x=>ids.Contains(x.Id)).ToListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender) return;
        var u=await JS.InvokeAsync<string>("armsTheme.getUser");
        await using var db=await DbFactory.CreateDbContextAsync();
        var user=await ArmsAuth.ResolveUserAsync(db, u);
        CurrentUserName=user?.FullName??"";
        await InvokeAsync(StateHasChanged);
    }

    async Task Print()=>await JS.InvokeVoidAsync("window.print");
}
