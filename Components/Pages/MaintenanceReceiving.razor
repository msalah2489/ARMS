@page "/service-requests/receiving"
@rendermode InteractiveServer
@using QRCoder
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
<PageTitle>استلام الأجهزة</PageTitle>
@if (IsTechnician)
{
    <div class="notice info-notice">هذه الصفحة غير متاحة لحساب الفني. يتم تنفيذ جميع أعمال الفني من «عمل الفني».</div>
}
else if (IsBranchUser)
{
    <div class="notice info-notice">هذه الصفحة غير متاحة لحساب الفرع. استلام الأجهزة من المندوب يتم من خلال دورة الفرع.</div>
}
else
{
<div class="page-head">
  <div><h1>استلام الأجهزة</h1><p>إدارة الأجهزة الواردة، قرارات الصيانة، والإرجاع للفرع.</p></div>
  <button class="btn outline" @onclick="Print">🖨 طباعة القائمة</button>
</div>

@if(IsMaintenanceUser)
{
<div class="panel">
  <div class="section-title">استلام شحنة من الفرع</div>
  <div class="field-row">
    <div class="field"><label>مسح QR ورقة التسليم</label><input @bind="ScanValue" placeholder="امسح QR أو أدخل رقم الطلب" @onkeydown="HandleScan" /></div>
    <button class="btn primary" @onclick="LoadBatch">إظهار الشحنة</button>
  </div>
  @if(Batch.Any())
  {
    <div class="notice info-notice">الشحنة: <b>@BatchCode</b> — حدد الأجهزة التي تم استلامها فعليًا ثم أكد الاستلام.</div>
    <div class="toolbar" style="margin-bottom:10px"><button class="btn outline" @onclick="SelectAllBatch" disabled="@(!Batch.Any())">تحديد الكل</button><button class="btn gray" @onclick="ClearBatchSelection" disabled="@(SelectedIds.Count==0)">إلغاء التحديد</button></div><table><thead><tr><th>استلام</th><th>الجهاز</th><th>الموديل</th><th>Serial</th><th>الطلب</th><th>الفرع</th><th>الحالة</th></tr></thead>
    <tbody>@foreach(var d in Batch){<tr><td><input type="checkbox" checked="@SelectedIds.Contains(d.Id)" @onchange="e=>ToggleSelected(d.Id,(bool)e.Value!)" /></td><td><b>@d.DeviceCode</b></td><td>@d.Model</td><td>@d.SerialNumber</td><td>@d.ServiceRequest?.RequestNumber</td><td>@d.ServiceRequest?.Branch</td><td><span class="pill blue">@d.CurrentStatus</span></td></tr>}</tbody></table>
    <div class="actions-bottom"><button class="btn green" disabled="@(SelectedIds.Count==0)" @onclick="ConfirmBatchReceipt">✓ تأكيد استلام الأجهزة المحددة وطباعة النموذج</button><button class="btn outline" @onclick="ClearBatch">إلغاء</button></div>
  }
</div>

<div class="tabs-panel">
  <div class="maintenance-tabs">
    <button class="maintenance-tab @(ActiveTab=="aroma"?"active":"")" @onclick="SelectAroma">طلبات خدمة التعطير <span class="tab-count @(AromaIncoming.Any()?"alert":"")">@AromaIncoming.Count</span></button>
    <button class="maintenance-tab @(ActiveTab=="warehouse"?"active":"")" @onclick="SelectWarehouse">أجهزة مستلمة بالمستودع <span class="tab-count @(WarehouseReady.Any()?"alert":"")">@WarehouseReady.Count</span></button>
    <button class="maintenance-tab @(ActiveTab=="incoming"?"active":"")" @onclick="SelectIncoming">أجهزة في طريقها للصيانة <span class="tab-count @(IncomingForMaintenance.Any()?"alert":"")">@IncomingForMaintenance.Count</span></button>
    <button class="maintenance-tab @(ActiveTab=="ready"?"active":"")" @onclick="SelectReady">أجهزة جاهزة للصيانة <span class="tab-count @(ReadyForMaintenance.Any()?"alert":"")">@ReadyForMaintenance.Count</span></button>
    <button class="maintenance-tab @(ActiveTab=="return"?"active":"")" @onclick="SelectReturn">أجهزة جاهزة للإرسال للفرع <span class="tab-count @(ReadyToReturn.Any()?"alert":"")">@ReadyToReturn.Count</span></button>
    <button class="maintenance-tab @(ActiveTab=="paused"?"active":"")" @onclick="SelectPaused">أجهزة معلقة <span class="tab-count @(Paused.Any()?"alert":"")">@Paused.Count</span></button>
    <button class="maintenance-tab @(ActiveTab=="pending"?"active":"")" @onclick="SelectPending">مجهزة للإرجاع <span class="tab-count @(PendingReturn.Any()?"alert":"")">@PendingReturn.Count</span></button>
    <button class="maintenance-tab @(ActiveTab=="transit"?"active":"")" @onclick="SelectTransit">في طريقها للفرع <span class="tab-count @(InTransit.Any()?"alert":"")">@InTransit.Count</span></button>
  </div>

  <div class="tab-content">
    @if(ActiveTab=="aroma")
    {
      <div class="section-title">طلبات خدمة التعطير الواردة من القسم</div><div class="small">هذه القائمة خاصة بالمشرف؛ لا تظهر في حساب الفرع. يمكن استلام الأجهزة الواردة هنا بنفس دورة مركز الصيانة.</div>
      <table><thead><tr><th>الجهاز</th><th>الموديل</th><th>الطلب</th><th>الجهة</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody>@foreach(var d in AromaIncoming){<tr><td><b>@(string.IsNullOrWhiteSpace(d.DeviceCode)?"بدون باركود":d.DeviceCode)</b></td><td>@d.Model</td><td>@d.ServiceRequest?.RequestNumber</td><td>خدمة التعطير</td><td><span class="pill blue">في انتظار الاستلام</span></td><td><button class="btn green" @onclick="()=>ReceiveMaintenance(d.Id)">✓ استلام</button></td></tr>}</tbody></table>
      @if(!AromaIncoming.Any()){<div class="empty-state">لا توجد طلبات خدمة تعطير في انتظار الاستلام.</div>}
    }
    else if(ActiveTab=="warehouse")
    {
      <div class="section-title">أجهزة مستلمة بالمستودع</div>
      <div class="small">الأجهزة التي تم استلامها فعليًا بواسطة المستودع بعد مطابقة البوليصة، ويمكن لمشرف الصيانة استلامها من هنا.</div>
      <table><thead><tr><th>الجهاز</th><th>الموديل</th><th>الطلب</th><th>المصدر</th><th>الإجراء</th></tr></thead><tbody>
      @foreach(var d in WarehouseReady){<tr><td><b>@(string.IsNullOrWhiteSpace(d.DeviceCode)?"بدون QR":d.DeviceCode)</b></td><td>@d.Model</td><td>@d.ServiceRequest?.RequestNumber</td><td>@d.ServiceRequest?.IntakeSource — @d.ServiceRequest?.OriginName</td><td><button class="btn green" @onclick="()=>ReceiveFromWarehouse(d.Id)">✓ استلام للصيانة</button></td></tr>}
      </tbody></table>
      @if(!WarehouseReady.Any()){<div class="empty-state">لا توجد أجهزة مستلمة بالمستودع حاليًا.</div>}
    }
    else if(ActiveTab=="incoming")
    {
      <div class="section-title">أجهزة في طريقها للصيانة</div>
      <div class="small">الأجهزة التي أصبحت في طريقها للصيانة ولم يسجل المستودع استلامها بعد.</div>
      <table><thead><tr><th>الجهاز</th><th>الموديل</th><th>الطلب</th><th>الفرع</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody>
      @foreach(var d in IncomingForMaintenance){<tr><td><b>@d.DeviceCode</b></td><td>@d.Model</td><td>@d.ServiceRequest?.RequestNumber</td><td>@d.ServiceRequest?.Branch</td><td><span class="pill blue">مع مندوب التوصيل</span> @if(IsLate(d)){<span class="urgent-badge late-badge">متأخر</span>}</td><td><button class="btn green" @onclick="()=>ReceiveMaintenance(d.Id)">✓ استلام الصيانة</button></td></tr>}
      </tbody></table>
      @if(!IncomingForMaintenance.Any()){<div class="empty-state">لا توجد أجهزة في هذا التبويب حاليًا.</div>}
    }
    else if(ActiveTab=="ready")
    {
      <div class="section-title">أجهزة جاهزة للصيانة</div>
      <table><thead><tr><th>الجهاز</th><th>الموديل</th><th>الطلب</th><th>الفرع</th><th>الحالة</th></tr></thead><tbody>
      @foreach(var d in ReadyForMaintenance){<tr><td><b>@d.DeviceCode</b></td><td>@d.Model</td><td>@d.ServiceRequest?.RequestNumber</td><td>@d.ServiceRequest?.Branch</td><td><span class="pill yellow">جاهز للصيانة</span></td></tr>}
      </tbody></table>
      @if(!ReadyForMaintenance.Any()){<div class="empty-state">لا توجد أجهزة في هذا التبويب حاليًا.</div>}
    }
    else if(ActiveTab=="return")
    {
      <div class="section-title">أجهزة جاهزة للإرسال للفرع</div>
      <div class="filter-grid" style="margin-bottom:12px"><div class="field"><label>الفرع</label><select @bind="ReturnBranch" @bind:after="OnReturnBranchChanged"><option value="">كل الفروع</option>@foreach(var b in Branches.Where(x=>x.IsActive).OrderBy(x=>x.Name)){<option value="@b.City">@b.Name</option>}</select></div></div>
      <div class="actions-bottom"><button class="btn outline" @onclick="SelectAllReturn">☑ تحديد الكل</button><button class="btn outline" @onclick="()=>ReturnSendIds.Clear()">إلغاء التحديد</button><span class="small">إنشاء بوليصة الإرجاع والتسليم لشركة الشحن يتم من حساب مدير الصيانة.</span></div>
      <table><thead><tr><th>الجهاز</th><th>الموديل</th><th>الطلب</th><th>الفني</th><th>الإجراء</th></tr></thead><tbody>
      @foreach(var d in FilteredReadyToReturn){<tr><td><b>@d.DeviceCode</b></td><td>@d.Model</td><td>@d.ServiceRequest?.RequestNumber @if(d.Decision=="مؤجل للإرسال"){<span class="pill yellow">مؤجل لحين اكتمال الطلب</span>}</td><td>@d.AssignedTechnicianName</td><td><input type="checkbox" checked="@ReturnSendIds.Contains(d.Id)" @onchange="e=>ToggleReturnSend(d.Id,(bool)e.Value!)" /> إرسال @if(d.ReplacementDeviceId.HasValue && !d.ReplacementBarcodePrintedAt.HasValue){<a class="btn outline" href="@($"/devices/{d.Id}/qr")">🖨 طباعة QR أولاً</a>}else if(d.ReplacementDeviceId.HasValue){<span class="pill green">QR مطبوع</span>} <button class="btn danger" @onclick="()=>OpenScrap(d)">إهلاك</button><button class="btn outline" @onclick="()=>OpenReplace(d)">استبدال</button></td></tr>}
      </tbody></table>
      @if(!ReadyToReturn.Any()){<div class="empty-state">لا توجد أجهزة في هذا التبويب حاليًا.</div>}
    }
    else if(ActiveTab=="paused")
    {
      <div class="section-title">أجهزة معلقة</div>
      <table><thead><tr><th>الجهاز</th><th>الموديل</th><th>السبب</th><th>الطلب</th><th>الإجراء</th></tr></thead><tbody>
      @foreach(var d in Paused){var supervisorDecision=d.MaintenancePauseReason.Contains("غير قابل للإصلاح",StringComparison.Ordinal);<tr><td><b>@d.DeviceCode</b></td><td>@d.Model</td><td>@(string.IsNullOrWhiteSpace(d.MaintenancePauseReason)?"غير محدد":d.MaintenancePauseReason)</td><td>@d.ServiceRequest?.RequestNumber</td><td><button class="btn primary" @onclick="()=>ResumeMaintenance(d.Id)">🔄 إعادة للفني للصيانة</button><button class="btn outline" @onclick="()=>OpenReturn(d)">↩ إرجاع للفرع بدون صيانة</button>@if(supervisorDecision){<button class="btn outline" @onclick="()=>OpenReplace(d)">🔁 استبدال الجهاز</button>}else{<button class="btn outline" @onclick="()=>OpenReplace(d)">استبدال</button><button class="btn danger" @onclick="()=>OpenScrap(d)">إهلاك</button>}</td></tr>}
      </tbody></table>
      @if(!Paused.Any()){<div class="empty-state">لا توجد أجهزة في هذا التبويب حاليًا.</div>}
    }
    else if(ActiveTab=="pending")
    {
      <div class="section-title">أجهزة مجهزة للإرجاع في عملية الإرسال القادمة</div>
      <table><thead><tr><th>الجهاز</th><th>الموديل</th><th>العميل</th><th>السبب</th><th>الإجراء</th></tr></thead><tbody>
      @foreach(var d in PendingReturn){<tr><td><b>@d.DeviceCode</b></td><td>@d.Model</td><td>@d.ServiceRequest?.CustomerName</td><td>@d.ReturnReason</td><td><button class="btn outline" @onclick="()=>CancelPendingReturn(d.Id)">إلغاء التجهيز</button></td></tr>}
      </tbody></table>
      @if(!PendingReturn.Any()){<div class="empty-state">لا توجد أجهزة في هذا التبويب حاليًا.</div>}
    }
    else if(ActiveTab=="transit")
    {
      <div class="section-title">أجهزة في طريقها للفرع</div>
      <div class="small">هذه الأجهزة في طريقها للفرع، وحالة الطلب تبقى مفتوحة حتى يستلم الفرع جميع الأجهزة المرتبطة به.</div>
      <table><thead><tr><th>الجهاز</th><th>الموديل</th><th>الطلب</th><th>الموقع</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody>
      @foreach(var d in InTransit){<tr><td><b>@d.DeviceCode</b></td><td>@d.Model</td><td>@d.ServiceRequest?.RequestNumber</td><td>@d.CurrentLocation</td><td><span class="pill yellow">في الطريق للفرع</span></td><td><span class="small">بانتظار استلام الفرع</span></td></tr>}
      </tbody></table>
      @if(!InTransit.Any()){<div class="empty-state">لا توجد أجهزة في هذا التبويب حاليًا.</div>}
    }
  </div>
</div>
}
}

@if(SendConflictOpen && IsMaintenanceUser){
<div class="modal-backdrop"><div class="modal"><h2>أجهزة أخرى في نفس الطلب</h2><p>الجهاز المحدد جزء من طلب يحتوي على أجهزة أخرى لم تصبح جاهزة للإرسال بعد.</p><p><b>المتاح:</b> إرسال الجهاز المحدد الآن، أو تأجيله وإخراجه من قائمة الإرسال مؤقتًا.</p><div class="actions-bottom"><button class="btn primary" @onclick="()=>ResolveSendConflict(true)">إرسال المحدد فقط</button><button class="btn outline" @onclick="()=>ResolveSendConflict(false)">تأجيل المحدد</button><button class="btn gray" @onclick="()=>{SendConflictOpen=false;ReturnSendIds.Clear();}">إلغاء</button></div></div></div>}

@if(Modal is not null && IsMaintenanceUser)
{
<div class="modal-backdrop"><div class="modal"><h2>@ModalTitle</h2><p>@ModalText</p>
@if(Modal=="return"){<div class="field"><label>سبب الإرجاع *</label><select @bind="ReturnReason"><option value="">اختر السبب</option><option>العميل رفض دفع التكلفة</option><option>العميل طلب استرجاع الجهاز</option><option>خدمة العملاء طلبت الإرجاع</option><option>سبب فني</option><option>سبب آخر</option></select></div><div class="field"><label>ملاحظة</label><textarea @bind="ReturnNotes"></textarea></div>}
@if(Modal=="scrap"){<div class="field"><label>سبب الإهلاك *</label><select @bind="ScrapReason"><option value="">اختر السبب</option><option>عطل لا يمكن إصلاحه</option><option>عدم توفر قطعة غيار</option><option>تكلفة الإصلاح غير مجدية</option><option>تلف شديد</option><option>قرار خدمة العملاء</option><option>قرار إداري</option><option>سبب آخر</option></select></div><div class="field"><label>ملاحظة إلزامية *</label><textarea @bind="ScrapNotes"></textarea></div><div class="notice danger-notice"><b>التعويض إجباري:</b> لا يمكن إهلاك جهاز العميل إلا بعد اختيار جهاز بديل وإتمام عملية التعويض.</div><div class="field"><label>مصدر الجهاز البديل *</label><select @bind="ReplacementSource"><option value="">اختر</option><option>من مستودع أجهزة الاستبدال</option><option>جهاز جديد خارجي</option><option>جهاز مستعمل خارجي</option></select></div>@if(ReplacementSource=="من مستودع أجهزة الاستبدال"){<div class="field"><label>الجهاز البديل *</label><select @bind="SelectedReplacementInventoryId"><option value="0">اختر جهازًا متاحًا</option>@foreach(var r in AvailableReplacementDevices){<option value="@r.Id">@r.Model — @r.Color — @r.SerialNumber @(string.IsNullOrWhiteSpace(r.DeviceCode)?"":" — "+r.DeviceCode)</option>}</select></div>}<div class="field"><label>حالة الجهاز البديل *</label><select @bind="ReplacementCondition"><option value="">اختر الحالة</option><option>جديد</option><option>مستعمل</option></select></div>}
@if(Modal=="replace"){
<div class="field"><label>سبب الاستبدال *</label><select @bind="ReplacementReason"><option value="">اختر السبب</option><option>عطل لا يمكن إصلاحه</option><option>عدم توفر قطعة الغيار</option><option>تكلفة الإصلاح غير مجدية</option><option>تلف شديد</option><option>قرار خدمة العملاء</option><option>قرار إداري</option><option>سبب آخر</option></select></div>
<div class="field"><label>ملاحظة إلزامية *</label><textarea @bind="ReplacementNotes"></textarea></div>
<div class="field"><label>نوع الجهاز البديل *</label><select @bind="ReplacementSource"><option value="">اختر النوع</option><option>جهاز جديد</option><option>جهاز مستعمل</option></select></div><div class="field"><label>من مستودع الصيانة (اختياري)</label><input type="checkbox" @bind="FromMaintenanceWarehouse" /> نعم، اختر من أجهزة مستودع الصيانة</div>
@if(FromMaintenanceWarehouse){<div class="field"><label>جهاز بديل من مستودع الصيانة *</label><select @bind="SelectedReplacementInventoryId"><option value="0">اختر جهازًا متاحًا</option>@foreach(var r in AvailableReplacementDevices){<option value="@r.Id">@r.Model — @r.Color — @r.SerialNumber @(string.IsNullOrWhiteSpace(r.DeviceCode)?"":" — "+r.DeviceCode)</option>}</select></div>}
else{<div class="notice info-notice">سيتم إنشاء جهاز بديل جديد في النظام، مع كود جهاز جديد وQR/باركود إلزامي للطباعة.</div>}
<div class="field"><label>حالة الجهاز البديل *</label><select @bind="ReplacementCondition"><option value="">اختر الحالة</option><option>جديد</option><option>مستعمل</option></select></div>
}
<div class="actions-bottom"><button class="btn primary" @onclick="ConfirmModal">تأكيد</button><button class="btn outline" @onclick="CloseModal">إلغاء</button></div></div></div>
}
@if(Message!=""){<div class="notice success-notice">@Message</div>}

<style>
.tabs-panel{margin-top:14px}.maintenance-tabs{display:flex;gap:8px;flex-wrap:wrap;padding:10px;background:#f8fafc;border:1px solid #d8e1ea;border-radius:12px}.maintenance-tab{border:1px solid #cbd5e1;background:#fff;color:#123c5d;padding:10px 14px;border-radius:9px;cursor:pointer;font-weight:600}.maintenance-tab.active{background:#0d6efd;color:#fff;border-color:#0d6efd}.tab-count{display:inline-flex;min-width:24px;height:24px;align-items:center;justify-content:center;border-radius:50%;background:#e5e7eb;color:#334155;margin-right:5px;font-size:12px}.tab-count.alert{background:#dc2626;color:#fff}.tab-content{margin-top:12px}.empty-state{text-align:center;padding:28px;color:#64748b;background:#fafafa;border-radius:8px;margin-top:8px}
</style>

@code {
 List<ServiceDevice> Batch=new(),ReadyForMaintenance=new(),ReadyToReturn=new(),Paused=new(),PendingReturn=new(),InTransit=new(),IncomingForMaintenance=new(),AromaIncoming=new(),WarehouseReady=new(); HashSet<int> SelectedIds=new(); HashSet<int> ReturnSendIds=new(); UserAccount? CurrentUser; string ActiveTab="incoming"; string ScanValue="",BatchCode="",Message=""; bool ConfirmWarning; bool SendConflictOpen; int ConflictRequestId; string ConflictMessage=""; string? Modal; string ModalTitle="",ModalText=""; ServiceDevice? ModalDevice; string ReturnReason="",ReturnNotes="",ScrapReason="",ScrapNotes="",ReplacementReason="",ReplacementNotes="",ReplacementSource="",ReplacementCondition=""; int SelectedReplacementInventoryId; string ReturnBranch=""; bool FromMaintenanceWarehouse;
 List<ReplacementInventory> AvailableReplacementDevices=new(); List<Branch> Branches=new();
 string CurrentRole => (CurrentUser?.Role ?? "").Trim();
 IEnumerable<ServiceDevice> FilteredReadyToReturn=>string.IsNullOrWhiteSpace(ReturnBranch)?ReadyToReturn:ReadyToReturn.Where(x=>x.ServiceRequest!=null&&NormalizeBranch(x.ServiceRequest.Branch)==NormalizeBranch(ReturnBranch));
bool IsBranchUser=>CurrentRole=="مستخدم فرع";
 bool IsMaintenanceUser=>CurrentRole=="مشرف صيانة"||CurrentRole=="مدير صيانة"||CurrentRole=="مدير عام ARMS"||ArmsAuth.IsSystemAdminRole(CurrentRole);
 bool IsTechnician=>CurrentRole=="فني صيانة";
 protected override async Task OnAfterRenderAsync(bool firstRender){
     if(!firstRender) return;
     var u=await JS.InvokeAsync<string>("armsTheme.getUser");
     await using var db=await DbFactory.CreateDbContextAsync();
     CurrentUser=await ArmsAuth.ResolveUserAsync(db, u);
     if(CurrentUser is null){Nav.NavigateTo("/login",true);return;}
     if(!IsMaintenanceUser){Nav.NavigateTo(IsTechnician?"/technician":IsBranchUser?"/service-requests":"/",true);return;}
     await Load();
     await InvokeAsync(StateHasChanged);
 }
 void SelectTab(string tab){ActiveTab=tab;Message="";}
 void SelectAroma()=>SelectTab("aroma");
 void SelectIncoming()=>SelectTab("incoming");
 void SelectWarehouse()=>SelectTab("warehouse");
 void SelectReady()=>SelectTab("ready");
 void SelectReturn()=>SelectTab("return");
 void SelectPaused()=>SelectTab("paused");
 void SelectPending()=>SelectTab("pending");
 void SelectTransit()=>SelectTab("transit");
 void OnReturnBranchChanged(){ReturnSendIds.Clear();}
 async Task Load(){await using var db=await DbFactory.CreateDbContextAsync();AvailableReplacementDevices=await db.ReplacementInventory.Where(x=>x.Status=="متاح").OrderBy(x=>x.Model).ThenBy(x=>x.DeviceCode).ToListAsync();Branches=await db.Branches.OrderBy(x=>x.Name).ToListAsync();var q=db.ServiceDevices.Include(x=>x.ServiceRequest).AsQueryable();IncomingForMaintenance=await q.Where(x=>x.SentAt.HasValue&&x.MaintenanceReceivedAt==null&&!x.MaintenanceCompletedAt.HasValue&&x.CurrentLocation=="في الطريق للصيانة"&&x.Decision!="مستبعد"&&x.Decision!="مستبدل"&&x.Decision!="مهلك").OrderBy(x=>x.Id).ToListAsync();AromaIncoming=await q.Where(x=>x.ServiceRequest!=null&&x.ServiceRequest.ServiceType=="خدمة التعطير"&&x.MaintenanceReceivedAt==null&&x.CurrentLocation=="في الطريق للصيانة"&&x.Decision!="مستبعد"&&x.Decision!="مستبدل"&&x.Decision!="مهلك").OrderBy(x=>x.Id).ToListAsync();ReadyForMaintenance=await q.Where(x=>x.CurrentLocation=="مركز الصيانة"&&x.CurrentStatus=="انتظار"&&x.AssignedTechnicianId==null&&x.Decision!="مستبعد").ToListAsync();ReadyToReturn=await q.Where(x=>x.Decision!="مستبعد"&&x.Decision!="مهلك"&&x.Decision!="مستبدل"&&x.AssignedTechnicianId==null&&x.CurrentLocation=="مستودع الأجهزة الجاهزة للإرجاع"&&x.CurrentStatus=="جاهز للإرسال"&&!x.MaintenancePaused).ToListAsync();Paused=await q.Where(x=>x.CurrentLocation=="مركز الصيانة"&&x.CurrentStatus=="معلق").ToListAsync();PendingReturn=await q.Where(x=>x.CurrentLocation=="مركز الصيانة"&&x.CurrentStatus=="جاهز للإرجاع").ToListAsync();InTransit=await q.Where(x=>x.CurrentLocation=="في الطريق للفرع"&&x.CurrentStatus=="مع مندوب التوصيل").ToListAsync();WarehouseReady=await q.Where(x=>x.CurrentLocation=="المستودع"&&x.CurrentStatus=="مستلم بالمستودع"&&x.AssignedTechnicianId==null&&x.Decision!="مستبعد"&&x.Decision!="مستبدل"&&x.Decision!="مهلك").OrderBy(x=>x.Id).ToListAsync();}
 async Task ReceiveFromWarehouse(int id){if(!IsMaintenanceUser||CurrentUser is null)return;await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.Include(x=>x.ServiceRequest).FirstOrDefaultAsync(x=>x.Id==id&&x.CurrentLocation=="المستودع"&&x.CurrentStatus=="مستلم بالمستودع");if(d is null){Message="خطأ: الجهاز غير متاح للاستلام من المستودع.";return;}var now=DateTime.Now;d.CurrentLocation="مركز الصيانة";d.CurrentStatus="انتظار";d.MaintenanceReceivedAt=now;d.MaintenanceReceivedBy=CurrentUser.FullName;db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="انتظار",Location="مركز الصيانة",StartedAt=now,ChangedBy=CurrentUser.FullName,Notes="استلام من المستودع إلى قسم الصيانة"});await db.SaveChangesAsync();Message=$"تم استلام الجهاز {d.DeviceCode} من المستودع إلى قسم الصيانة.";await Load();}
 async Task HandleScan(KeyboardEventArgs e){if(e.Key=="Enter")await LoadBatch();} async Task ReceiveMaintenance(int id){if(!IsMaintenanceUser||CurrentUser is null)return;await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.Include(x=>x.ServiceRequest).FirstOrDefaultAsync(x=>x.Id==id);if(d is null||d.CurrentLocation!="في الطريق للصيانة"||d.MaintenanceReceivedAt.HasValue||d.Decision=="مستبعد"||d.Decision=="مستبدل"||d.Decision=="مهلك")return;d.CurrentLocation="مركز الصيانة";d.CurrentStatus="انتظار";d.MaintenanceReceivedAt=DateTime.Now;d.MaintenanceReceivedBy=CurrentUser.FullName;var openHist=await db.DeviceStatusHistories.Where(x=>x.ServiceDeviceId==d.Id&&x.EndedAt==null&&x.Location=="في الطريق للصيانة").ToListAsync();foreach(var h in openHist)h.EndedAt=DateTime.Now;db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="انتظار",Location="مركز الصيانة",StartedAt=DateTime.Now,ChangedBy=CurrentUser.FullName,Notes="استلام مباشر من قائمة الأجهزة القادمة من الفرع"});var r=await db.ServiceRequests.Include(x=>x.Devices).FirstOrDefaultAsync(x=>x.Id==d.ServiceRequestId);if(r is not null)r.Status=RequestStatusHelper.Calculate(r.Devices);await db.SaveChangesAsync();Message=$"تم استلام الجهاز {d.DeviceCode} في مركز الصيانة.";await Load();}
 async Task LoadBatch(){Message="";Batch.Clear();SelectedIds.Clear();var key=ScanValue.Trim();if(key=="")return;await using var db=await DbFactory.CreateDbContextAsync();Batch=await db.ServiceDevices.Include(x=>x.ServiceRequest).Where(x=>(x.DispatchBatchCode==key||x.ServiceRequest!.RequestNumber==key)&&x.CurrentLocation=="في الطريق للصيانة"&&x.Decision!="مستبعد").ToListAsync();BatchCode=key;if(!Batch.Any())Message="لم يتم العثور على شحنة واردة بهذا الرقم.";}
 void ToggleSelected(int id,bool on){if(on)SelectedIds.Add(id);else SelectedIds.Remove(id);}
