 async Task ConfirmBatchReceipt(){if(CurrentUser is null)return;await using var db=await DbFactory.CreateDbContextAsync();var ids=SelectedIds.ToList();var rows=await db.ServiceDevices.Include(x=>x.ServiceRequest).Where(x=>ids.Contains(x.Id)&&x.CurrentLocation=="في الطريق للصيانة"&&x.Decision!="مستبعد").ToListAsync();foreach(var d in rows){d.CurrentLocation="مركز الصيانة";d.CurrentStatus="انتظار";d.MaintenanceReceivedAt=DateTime.Now;d.MaintenanceReceivedBy=CurrentUser.FullName;db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="انتظار",Location="مركز الصيانة",StartedAt=DateTime.Now,ChangedBy=CurrentUser.FullName});}var requestIds=rows.Select(x=>x.ServiceRequestId).Distinct().ToList();foreach(var rid in requestIds){var r=await db.ServiceRequests.Include(x=>x.Devices).FirstOrDefaultAsync(x=>x.Id==rid);if(r is not null)r.Status=RequestStatusHelper.Calculate(r.Devices);}await db.SaveChangesAsync();var receiptIds=string.Join(",",rows.Select(x=>x.Id));Message=$"تم استلام {rows.Count} جهاز.";Batch.Clear();SelectedIds.Clear();await Load();if(receiptIds!="")await JS.InvokeVoidAsync("eval", $"window.open('/service-requests/receiving/receipt?ids={receiptIds}','_blank')");}
 void ToggleReturnSend(int id,bool on){if(on)ReturnSendIds.Add(id);else ReturnSendIds.Remove(id);}
void SelectAllReturn(){foreach(var d in FilteredReadyToReturn)ReturnSendIds.Add(d.Id);}
async Task SendToBranch(int id){ReturnSendIds.Clear();ReturnSendIds.Add(id);await ConfirmSendSelected();}
async Task ConfirmSendSelected(){
 if(!IsMaintenanceUser||CurrentUser is null||ReturnSendIds.Count==0)return;
 await using var db=await DbFactory.CreateDbContextAsync();
 var ids=ReturnSendIds.ToList();
 var selected=await db.ServiceDevices.Include(x=>x.ServiceRequest).Where(x=>ids.Contains(x.Id)&&x.Decision!="مستبعد"&&x.Decision!="مهلك"&&x.Decision!="مستبدل"&&x.AssignedTechnicianId==null&&(!x.ReplacementDeviceId.HasValue||x.ReplacementBarcodePrintedAt.HasValue)&&(x.MaintenanceCompletedAt.HasValue||x.CurrentStatus=="جاهز للإرسال"||x.CurrentStatus=="تمت الصيانة")).ToListAsync();
 if(!selected.Any()){Message="خطأ: لا يوجد جهاز جاهز فعليًا للإرسال ضمن الاختيار.";return;}
 var requestIds=selected.Select(x=>x.ServiceRequestId).Distinct().ToList();
 var notReady=await db.ServiceDevices.Where(x=>requestIds.Contains(x.ServiceRequestId)&&!ids.Contains(x.Id)&&x.Decision!="مستبعد"&&x.Decision!="مهلك"&&x.Decision!="مستبدل"&&x.CustomerDeliveredAt==null&&x.CurrentStatus!="ملغى").ToListAsync();
 if(notReady.Any()){
   ConflictRequestId=selected.First().ServiceRequestId; ConflictMessage=$"يوجد {notReady.Count} جهاز آخر في نفس الطلب لم يجهز للإرسال بعد."; SendConflictOpen=true; return;
 }
 await DispatchRows(db,selected);
}
async Task ResolveSendConflict(bool sendNow){
 if(!sendNow){
   await using var deferDb=await DbFactory.CreateDbContextAsync();
   var deferIds=ReturnSendIds.ToList();
   var deferRows=await deferDb.ServiceDevices.Where(x=>deferIds.Contains(x.Id)).ToListAsync();
   foreach(var d in deferRows)d.Decision="مؤجل للإرسال";
   await deferDb.SaveChangesAsync();
   SendConflictOpen=false;ReturnSendIds.Clear();
   Message="تم تأجيل الأجهزة المحددة وإخراجها من قائمة الإرسال الحالية لحين اكتمال بقية أجهزة الطلب.";
   await Load();return;
 }
 await using var sendDb=await DbFactory.CreateDbContextAsync();
 var sendIds=ReturnSendIds.ToList();
 var sendRows=await sendDb.ServiceDevices.Include(x=>x.ServiceRequest).Where(x=>sendIds.Contains(x.Id)&&x.AssignedTechnicianId==null&&x.Decision!="مستبعد"&&x.Decision!="مهلك"&&x.Decision!="مستبدل"&&(!x.ReplacementDeviceId.HasValue||x.ReplacementBarcodePrintedAt.HasValue)&&(x.MaintenanceCompletedAt.HasValue||x.CurrentStatus=="جاهز للإرسال"||x.CurrentStatus=="تمت الصيانة")).ToListAsync();
 await DispatchRows(sendDb,sendRows); SendConflictOpen=false;
}
async Task DispatchRows(ArmsDbContext db,List<ServiceDevice> rows){
 var dispatchRequestIds=rows.Select(x=>x.ServiceRequestId).Distinct().ToList();foreach(var d in rows){d.CurrentLocation="في الطريق للفرع";d.CurrentStatus="مع مندوب التوصيل";d.SentAt=DateTime.Now;if(d.ReplacementDeviceId.HasValue){var original=await db.ServiceDevices.FindAsync(d.ReplacementDeviceId.Value);if(original is not null){original.Decision="مستبدل";original.CurrentLocation="مستودع الأجهزة المستبدلة";original.CurrentStatus="مستبدل";original.MaintenancePaused=false;db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=original.Id,ServiceRequestId=original.ServiceRequestId,Status="مستبدل",Location="مستودع الأجهزة المستبدلة",StartedAt=DateTime.Now,ChangedBy=CurrentUser!.FullName,Notes="تم إرسال الجهاز البديل للفرع، ونقل الجهاز الأصلي إلى مستودع الأجهزة المستبدلة."});}}db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="مع مندوب التوصيل",Location="في الطريق للفرع",StartedAt=DateTime.Now,ChangedBy=CurrentUser!.FullName});db.Notifications.Add(new Notification{Message=$"الجهاز {d.DeviceCode} جاري إرجاعه للفرع.",TargetUrl="/service-requests/receiving",Type="info"});}
 foreach(var rid in dispatchRequestIds){var request=await db.ServiceRequests.Include(x=>x.Devices).FirstOrDefaultAsync(x=>x.Id==rid);if(request is not null){request.SentAt=DateTime.Now;request.Status=RequestStatusHelper.Calculate(request.Devices);}}await db.SaveChangesAsync();ReturnSendIds.Clear();ConfirmWarning=false;Message=$"تم إرسال {rows.Count} جهاز للفرع.";await Load();
}
async Task CancelPendingReturn(int id){if(!IsMaintenanceUser)return;await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.FindAsync(id);if(d is null)return;d.CurrentStatus="معلق";d.CurrentLocation="مركز الصيانة";db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="معلق",Location="مركز الصيانة",StartedAt=DateTime.Now,ChangedBy=CurrentUser!.FullName,Notes="إلغاء تجهيز الإرجاع"});await db.SaveChangesAsync();await Load();}
async Task ResumeMaintenance(int id){if(!IsMaintenanceUser)return;await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.FindAsync(id);if(d is null||d.CurrentStatus!="معلق")return;d.CurrentStatus="انتظار";d.MaintenancePaused=false;d.MaintenancePauseReason="";db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="انتظار",Location="مركز الصيانة",StartedAt=DateTime.Now,ChangedBy=CurrentUser!.FullName,Notes="إعادة من التعليق للصيانة"});await db.SaveChangesAsync();await Load();}
 void OpenReturn(ServiceDevice d){Modal="return";ModalTitle="إرجاع جهاز للفرع";ModalText=$"الجهاز {d.DeviceCode} سيضاف إلى عملية الإرجاع القادمة.";ModalDevice=d;ReturnReason="";ReturnNotes="";}
 void OpenScrap(ServiceDevice d){Modal="scrap";ModalTitle="إهلاك جهاز";ModalText=$"سيتم إخراج {d.DeviceCode} من دورة الصيانة، مع إلزام تعويض العميل بجهاز بديل أولًا.";ModalDevice=d;ScrapReason="";ScrapNotes="";ReplacementSource="";ReplacementCondition="";SelectedReplacementInventoryId=0;}
 void OpenReplace(ServiceDevice d){Modal="replace";ModalTitle="استبدال جهاز";ModalText=$"استبدال {d.DeviceCode} مع الاحتفاظ بتاريخ الجهاز الأصلي.";ModalDevice=d;ReplacementReason="";ReplacementNotes="";ReplacementSource="";ReplacementCondition="";SelectedReplacementInventoryId=0;FromMaintenanceWarehouse=false;}
 void CloseModal(){Modal=null;ModalDevice=null;}
 async Task ConfirmModal(){
 if(ModalDevice is null||CurrentUser is null)return;
 await using var db=await DbFactory.CreateDbContextAsync();
 var d=await db.ServiceDevices.Include(x=>x.ServiceRequest).FirstOrDefaultAsync(x=>x.Id==ModalDevice.Id);
 if(d is null){CloseModal();return;}
 if(Modal=="return"){
   if(string.IsNullOrWhiteSpace(ReturnReason)){Message="سبب الإرجاع إجباري.";return;}
   d.Decision="مرتجع";d.ReturnReason=ReturnReason;d.ReturnedBy=CurrentUser.FullName;d.CurrentLocation="مركز الصيانة";d.CurrentStatus="جاهز للإرجاع";d.MaintenancePauseReason=ReturnNotes;
 }else if(Modal=="scrap"){
   if(string.IsNullOrWhiteSpace(ScrapReason)||string.IsNullOrWhiteSpace(ScrapNotes)){Message="سبب وملاحظة الإهلاك إجباريان.";return;}
   if(string.IsNullOrWhiteSpace(ReplacementSource)||string.IsNullOrWhiteSpace(ReplacementCondition)){Message="خطأ: لا يمكن إهلاك جهاز العميل قبل إتمام التعويض بجهاز بديل وتحديد حالته.";return;}
   if(ReplacementSource=="من مستودع أجهزة الاستبدال"&&SelectedReplacementInventoryId==0){Message="خطأ: يجب اختيار جهاز بديل من مستودع أجهزة الاستبدال.";return;}
   ServiceDevice replacement;
   if(ReplacementSource=="من مستودع أجهزة الاستبدال"){
     var spare=await db.ReplacementInventory.FirstOrDefaultAsync(x=>x.Id==SelectedReplacementInventoryId&&x.Status=="متاح");
     if(spare is null){Message="خطأ: الجهاز البديل غير متاح في المستودع.";return;}
     var replacementCode=string.IsNullOrWhiteSpace(spare.DeviceCode)?"REP-"+Guid.NewGuid().ToString("N")[..8].ToUpper():spare.DeviceCode;
     replacement=new ServiceDevice{ServiceRequestId=d.ServiceRequestId,DeviceCode=replacementCode,DeviceType=spare.DeviceType,Brand=spare.Brand,Model=spare.Model,SerialNumber=spare.SerialNumber,Problem="جهاز بديل — تعويض عن إهلاك "+d.DeviceCode,Decision="جاهز للإرسال",ExternalCondition=ReplacementCondition,CurrentLocation="مستودع الأجهزة الجاهزة للإرجاع",CurrentStatus="جاهز للإرسال",ReplacementDeviceId=d.Id,ReplacementSource="من مستودع أجهزة الاستبدال",ReplacementCondition=ReplacementCondition,ReplacementNotes="تعويض إلزامي قبل إهلاك الجهاز الأصلي."};
     db.ServiceDevices.Add(replacement);await db.SaveChangesAsync();spare.Status="مخصص للطلب";spare.Location="مركز الصيانة";spare.ServiceRequestId=d.ServiceRequestId;spare.AssignedServiceDeviceId=replacement.Id;
   }else{
     var code="REP-"+Guid.NewGuid().ToString("N")[..8].ToUpper();
     replacement=new ServiceDevice{ServiceRequestId=d.ServiceRequestId,DeviceCode=code,DeviceType=d.DeviceType,Brand=d.Brand,Model=d.Model,SerialNumber="",Problem="جهاز بديل — تعويض عن إهلاك "+d.DeviceCode,Decision="جاهز للإرسال",ExternalCondition=ReplacementCondition,CurrentLocation="مستودع الأجهزة الجاهزة للإرجاع",CurrentStatus="جاهز للإرسال",ReplacementDeviceId=d.Id,ReplacementSource=ReplacementSource,ReplacementCondition=ReplacementCondition,ReplacementNotes="تعويض إلزامي قبل إهلاك الجهاز الأصلي."};
     db.ServiceDevices.Add(replacement);await db.SaveChangesAsync();
   }
   d.ScrapReason=ScrapReason;d.ScrapNotes=ScrapNotes;d.ScrappedAt=DateTime.Now;d.ScrappedBy=CurrentUser.FullName;d.Decision="مهلك";d.CurrentLocation="مستودع الأجهزة المستبدلة";d.CurrentStatus="مهلك";
   d.ReplacementReason="تعويض عن الإهلاك";d.ReplacementNotes="تم تعويض العميل بجهاز بديل قبل إتمام الإهلاك.";d.ReplacedAt=DateTime.Now;d.ReplacedBy=CurrentUser.FullName;
   db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=replacement.Id,ServiceRequestId=d.ServiceRequestId,Status="جاهز للإرسال",Location="مستودع الأجهزة الجاهزة للإرجاع",StartedAt=DateTime.Now,ChangedBy=CurrentUser.FullName,Notes="جهاز بديل تم تخصيصه لتعويض العميل قبل إهلاك الجهاز الأصلي."});
   db.Notifications.Add(new Notification{Message=$"تم تعويض العميل بجهاز بديل {replacement.DeviceCode} قبل إهلاك الجهاز {d.DeviceCode}.",TargetUrl=$"/devices/{replacement.Id}/qr",Type="warning"});
 }else if(Modal=="replace"){
   if(string.IsNullOrWhiteSpace(ReplacementReason)||string.IsNullOrWhiteSpace(ReplacementNotes)||string.IsNullOrWhiteSpace(ReplacementSource)||string.IsNullOrWhiteSpace(ReplacementCondition)){Message="سبب الاستبدال والملاحظة ونوع الجهاز وحالته كلها إجبارية.";return;}
   ServiceDevice replacement;
   if(FromMaintenanceWarehouse){
     if(SelectedReplacementInventoryId==0){Message="يجب اختيار جهاز من مستودع أجهزة الاستبدال.";return;}
     var spare=await db.ReplacementInventory.FirstOrDefaultAsync(x=>x.Id==SelectedReplacementInventoryId&&x.Status=="متاح");
     if(spare is null){Message="الجهاز البديل غير متاح في مستودع الصيانة.";return;}
     replacement=new ServiceDevice{ServiceRequestId=d.ServiceRequestId,DeviceCode=string.IsNullOrWhiteSpace(spare.DeviceCode)?"REP-"+Guid.NewGuid().ToString("N")[..8].ToUpper():spare.DeviceCode,DeviceType=spare.DeviceType,Brand=spare.Brand,Model=spare.Model,SerialNumber=spare.SerialNumber,Problem="جهاز بديل — استبدال للجهاز "+d.DeviceCode,Decision="جاهز للإرسال",ExternalCondition=ReplacementCondition,Accessories="",ComplaintDetails=d.ServiceRequest?.Notes??"",CurrentLocation="مستودع الأجهزة الجاهزة للإرجاع",CurrentStatus="جاهز للإرسال",AdditionalDetails="جهاز بديل من مستودع الصيانة مرتبط بالطلب "+(d.ServiceRequest?.RequestNumber??""),ReplacementDeviceId=d.Id,ReplacementSource="من مستودع الصيانة",ReplacementCondition=ReplacementCondition};
     db.ServiceDevices.Add(replacement);await db.SaveChangesAsync();
     spare.Status="مخصص للطلب";spare.Location="مركز الصيانة";spare.ServiceRequestId=d.ServiceRequestId;spare.AssignedServiceDeviceId=replacement.Id;
   }else{
     var code="DEV-"+Guid.NewGuid().ToString("N")[..8].ToUpper();
     replacement=new ServiceDevice{ServiceRequestId=d.ServiceRequestId,DeviceCode=code,DeviceType=d.DeviceType,Brand=d.Brand,Model=d.Model,SerialNumber="",Problem="جهاز بديل — استبدال للجهاز "+d.DeviceCode,Decision="جاهز للإرسال",ExternalCondition=ReplacementCondition,Accessories="",ComplaintDetails=d.ServiceRequest?.Notes??"",CurrentLocation="مستودع الأجهزة الجاهزة للإرجاع",CurrentStatus="جاهز للإرسال",AdditionalDetails="جهاز بديل خارجي مرتبط بالطلب "+(d.ServiceRequest?.RequestNumber??""),ReplacementDeviceId=d.Id,ReplacementSource=ReplacementSource,ReplacementCondition=ReplacementCondition};
     db.ServiceDevices.Add(replacement);await db.SaveChangesAsync();
   }
   d.ReplacementReason=ReplacementReason;d.ReplacementNotes=ReplacementNotes;d.ReplacedAt=DateTime.Now;d.ReplacedBy=CurrentUser.FullName;d.Decision="مستبدل";d.CurrentStatus="مستبدل";d.CurrentLocation="مستودع الأجهزة المستبدلة";
   db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=replacement.Id,ServiceRequestId=d.ServiceRequestId,Status="جاهز للإرسال",Location="مستودع الأجهزة الجاهزة للإرجاع",StartedAt=DateTime.Now,ChangedBy=CurrentUser.FullName,Notes="جهاز بديل تم إنشاؤه/تخصيصه. طباعة الباركود/QR إلزامية قبل الإرسال."});
   db.Notifications.Add(new Notification{Message=$"تم إنشاء الجهاز البديل {replacement.DeviceCode}. يجب طباعة الباركود/QR قبل إرساله للفرع.",TargetUrl=$"/devices/{replacement.Id}/qr",Type="warning"});
 }
 db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status=d.CurrentStatus,Location=d.CurrentLocation,StartedAt=DateTime.Now,ChangedBy=CurrentUser.FullName,Notes=Modal=="scrap"?ScrapNotes:Modal=="replace"?ReplacementNotes:ReturnNotes});
 await db.SaveChangesAsync();Message="تم حفظ الإجراء.";CloseModal();await Load();
}
async Task Receive(int id){if(!IsBranchUser)return;await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.Include(x=>x.ServiceRequest).FirstOrDefaultAsync(x=>x.Id==id);if(d is null)return;d.CurrentLocation=d.ServiceRequest?.Branch??CurrentUser!.Branch;d.CurrentStatus="تم الاستلام";db.DeviceStatusHistories.Where(x=>x.ServiceDeviceId==d.Id&&x.EndedAt==null&&x.Status=="مع مندوب التوصيل").ToList().ForEach(x=>x.EndedAt=DateTime.Now);db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="تم الاستلام",Location=d.CurrentLocation,StartedAt=DateTime.Now,ChangedBy=CurrentUser!.FullName});await db.SaveChangesAsync();await Load();}
 async Task Print()=>await JS.InvokeVoidAsync("window.print");
 static string NormalizeBranch(string? value)=>(value??"").Trim().Replace("فرع ","").Replace("فرع","").Trim();
 static bool IsLate(ServiceDevice d)=>!d.MaintenanceCompletedAt.HasValue && ((d.MaintenanceStartedAt.HasValue && DateTime.Now-d.MaintenanceStartedAt.Value>=TimeSpan.FromHours(24)) || (!d.MaintenanceStartedAt.HasValue && d.MaintenanceReceivedAt.HasValue && DateTime.Now-d.MaintenanceReceivedAt.Value>=TimeSpan.FromHours(24)));
}
