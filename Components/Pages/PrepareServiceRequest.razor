@page "/service-requests/{RequestId:int}/prepare"
@rendermode InteractiveServer
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
<PageTitle>تحديد مسار الصيانة</PageTitle>
@if(Request is null){<div class="empty">جارٍ التحميل...</div>}
else{
<div class="page-head"><div><h1>تحديد مسار الصيانة</h1><p>حدد لكل جهاز: إرسال إلى مركز الصيانة أو صيانة محلية بواسطة فني متنقل. يظل الجهاز في الفرع عند الصيانة المحلية.</p></div><a class="btn outline" href="/service-requests/@Request.Id">رجوع للطلب</a></div>
<div class="info-grid panel"><div><label>رقم الطلب</label><b>@Request.RequestNumber</b></div><div><label>العميل</label><b>@Request.CustomerName</b></div><div><label>الفرع</label><b>@Request.Branch</b></div><div><label>الحالة</label><span class="pill blue">@RequestStatus</span></div></div>
<div class="stats"><div class="stat"><span>إجمالي الأجهزة</span><b>@Request.Devices.Count</b></div><div class="stat"><span>إرسال لمركز الصيانة</span><b>@CentralRows.Count</b></div><div class="stat"><span>صيانة محلية</span><b>@LocalRows.Count</b></div><div class="stat"><span>مستبعدة</span><b>@Request.Devices.Count(x=>x.Decision=="مستبعد")</b></div></div>
<div class="panel"><h2>الأجهزة ومسار الصيانة</h2><table><thead><tr><th>الجهاز</th><th>الموديل</th><th>شكوى العميل</th><th>الموقع</th><th>الحالة</th><th>مسار الصيانة</th><th>الإجراء</th></tr></thead><tbody>
@foreach(var d in Request.Devices){<tr><td><b>@d.DeviceCode</b></td><td>@d.Model</td><td>@d.ComplaintDetails</td><td>@d.CurrentLocation</td><td>@DisplayDeviceStatus(d)</td><td>@(string.IsNullOrWhiteSpace(d.MaintenanceRoute)?"لم يحدد بعد":d.MaintenanceRoute)</td><td>
@if(CanChooseRoute(d)){
 <button class="btn primary" @onclick="()=>ChooseCenter(d.Id)">⇧ إرسال للصيانة</button>
 <button class="btn green" style="margin-right:6px" @onclick="()=>OpenLocal(d.Id)">🛠 صيانة محلية</button>
 <button class="btn danger" style="margin-right:6px" @onclick="()=>Exclude(d.Id)">استبعاد</button>
}else if(d.CurrentStatus=="تعذر الصيانة المحلية"){
 <button class="btn primary" @onclick="()=>ChooseCenter(d.Id)">⇧ إرسال للصيانة</button>
 <button class="btn green" style="margin-right:6px" @onclick="()=>OpenLocal(d.Id)">🔄 إعادة صيانة محلية</button>
}else if(d.MaintenanceRoute=="صيانة محلية" && d.CurrentStatus=="جاهز للصيانة"){
 <span class="pill yellow">الفني المتنقل: @d.AssignedTechnicianName — جاهز للصيانة المحلية</span>
}else if(d.CurrentStatus=="جاري الصيانة محليًا"){
 <span class="pill yellow">الفني المتنقل: @d.AssignedTechnicianName</span>
}else if(d.CurrentStatus=="تمت الصيانة محليًا"){
 <span class="pill green">تمت الصيانة محليًا</span>
}else if(d.Decision=="مستبعد"){
 <button class="btn green" @onclick="()=>Include(d.Id)">إعادة للجهاز</button>
}else{<span class="small">—</span>}
</td></tr>}
</tbody></table></div>
@if(!string.IsNullOrWhiteSpace(Message)){<div class="notice @(Message.StartsWith("خطأ")?"danger-notice":"success-notice")">@Message</div>}
@if(CentralRows.Any()){
<div class="panel"><div class="section-title">إرسال الأجهزة المحددة إلى مركز الصيانة</div>
@if(!Request.ApprovedAt.HasValue){<div class="actions-bottom"><button class="btn green" @onclick="ApproveList">اعتماد قائمة الإرسال للمركز (@CentralRows.Count)</button></div>}
else if(!Request.DispatchReportPrintedAt.HasValue){<div class="actions"><a class="btn outline" href="@($"/service-requests/{Request.Id}/dispatch-report")">🖨 طباعة تقرير الأجهزة المرسلة</a><button class="btn gray" disabled>إرسال الأجهزة — اطبع التقرير أولًا</button></div>}
else{<div class="actions"><a class="btn outline" href="@($"/service-requests/{Request.Id}/dispatch-report")">🖨 إعادة طباعة التقرير</a><button class="btn primary" @onclick="SendRequest">⇧ إرسال @CentralRows.Count جهاز إلى مركز الصيانة</button></div>}
</div>}
else{<div class="notice info-notice">لا توجد أجهزة مختارة حاليًا للإرسال إلى مركز الصيانة.</div>}
}

@if(LocalDevice is not null){
<div class="modal-backdrop"><div class="modal"><h2>صيانة محلية</h2><p>الجهاز <b>@LocalDevice.DeviceCode</b> سيظل موقعه <b>الفرع</b> ويتم إسناد مهمة إلى فني متنقل.</p>
<div class="field"><label>الفني المتنقل *</label><select @bind="SelectedMobileTechId"><option value="0">-- اختر الفني --</option>@foreach(var t in MobileTechnicians){<option value="@t.Id">@t.FullName</option>}</select></div>
<div class="actions-bottom"><button class="btn green" @onclick="AssignLocalMaintenance">تأكيد الصيانة المحلية</button><button class="btn outline" @onclick="CloseLocal">إلغاء</button></div></div></div>}

@code {
 [Parameter]public int RequestId{get;set;} ServiceRequest? Request; UserAccount? CurrentUser; string Message=""; string RequestStatus=>RequestStatusHelper.Calculate(Request?.Devices); List<UserAccount> MobileTechnicians=new(); ServiceDevice? LocalDevice; int SelectedMobileTechId;
 List<ServiceDevice> CentralRows => Request?.Devices.Where(x=>x.Decision=="جاهز للإرسال"&&x.MaintenanceRoute=="مركز الصيانة"&&x.CurrentLocation=="الفرع"&&!x.SentAt.HasValue&&!x.MaintenanceReceivedAt.HasValue).ToList()??new();
 List<ServiceDevice> LocalRows => Request?.Devices.Where(x=>x.CurrentStatus is "جاري الصيانة محليًا" or "تمت الصيانة محليًا" || x.MaintenanceRoute=="صيانة محلية").ToList()??new();
 protected override async Task OnParametersSetAsync(){await Load();}
 async Task Load(){var username=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db, username);Request=await db.ServiceRequests.Include(x=>x.Devices).FirstOrDefaultAsync(x=>x.Id==RequestId);if(CurrentUser?.Role=="مستخدم فرع"&&Request is not null&&NormalizeBranch(Request.Branch)!=NormalizeBranch(CurrentUser.Branch))Request=null;MobileTechnicians=await db.UserAccounts.Where(x=>x.Role=="فني متنقل"&&x.IsActive).OrderBy(x=>x.FullName).ToListAsync();}
 static string NormalizeBranch(string? value)=>(value??"").Trim().Replace("فرع ","").Replace("فرع","").Trim();
 bool CanChooseRoute(ServiceDevice d)=>d.CurrentLocation=="الفرع"&&!d.SentAt.HasValue&&!d.MaintenanceReceivedAt.HasValue&&d.Decision!="مستبعد"&&d.MaintenanceRoute!="صيانة محلية"&&d.CurrentStatus is not "جاري الصيانة محليًا" and not "تمت الصيانة محليًا";
 async Task Exclude(int id)=>await SetDecision(id,"مستبعد"); async Task Include(int id)=>await SetDecision(id,"جاهز للإرسال");
 async Task SetDecision(int id,string decision){await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.FindAsync(id);if(d is null)return;d.Decision=decision;if(decision=="مستبعد"){d.CurrentStatus="مستبعد";d.MaintenanceRoute="";}else if(d.CurrentStatus=="مستبعد")d.CurrentStatus="مستلم بالفرع";await db.SaveChangesAsync();await RefreshRequestStatus(db,d.ServiceRequestId);await db.SaveChangesAsync();await Load();}
 async Task ChooseCenter(int id){Message="";await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.FindAsync(id);if(d is null||d.CurrentLocation!="الفرع"||d.SentAt.HasValue||d.DispatchBatchCode!=""){Message="خطأ: لا يمكن تغيير مسار جهاز مرتبط بحركة شحن. يجب استبعاده من البوليصة أولًا قبل تغيير المسار.";return;}d.Decision="جاهز للإرسال";d.MaintenanceRoute="مركز الصيانة";d.CurrentStatus="مستلم بالفرع";d.LocalMaintenanceCompletedAt=null;d.AssignedTechnicianId=null;d.AssignedTechnicianName="";d.LocalMaintenanceFailureReason="";var rr=await db.ServiceRequests.FindAsync(d.ServiceRequestId);if(rr is not null){rr.ApprovedAt=null;rr.DispatchReportPrintedAt=null;}await RefreshRequestStatus(db,d.ServiceRequestId);await db.SaveChangesAsync();Message=$"تم تجهيز {d.DeviceCode} للإرسال إلى مركز الصيانة.";await Load();}
 void OpenLocal(int id){LocalDevice=Request?.Devices.FirstOrDefault(x=>x.Id==id);SelectedMobileTechId=0;}
 void CloseLocal(){LocalDevice=null;SelectedMobileTechId=0;}
 async Task AssignLocalMaintenance(){Message="";if(LocalDevice is null||SelectedMobileTechId==0){Message="خطأ: يجب اختيار فني متنقل.";return;}await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.FindAsync(LocalDevice.Id);var tech=await db.UserAccounts.FindAsync(SelectedMobileTechId);if(d is null||tech is null){Message="خطأ: تعذر إسناد المهمة.";return;}if(d.SentAt.HasValue||d.DispatchBatchCode!=""){Message="خطأ: لا يمكن تحويل الجهاز إلى فني متنقل بعد دخوله في الشحن. يجب استبعاده من البوليصة أولًا.";return;}d.MaintenanceRoute="صيانة محلية";d.CurrentLocation="الفرع";d.CurrentStatus="جاهز للصيانة";d.AssignedTechnicianId=tech.Id;d.AssignedTechnicianName=tech.FullName;d.MaintenanceStartedAt=null;d.MaintenanceCompletedAt=null;d.MaintenancePaused=false;d.TechnicianReceivedAt=null;d.TechnicianDecision="";d.LocalMaintenanceFailureReason="";d.Decision="صيانة محلية";d.MaintenanceTestsJson="";db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="جاهز للصيانة",Location="الفرع",StartedAt=DateTime.Now,ChangedBy=CurrentUser?.FullName??"مستخدم الفرع",Notes=$"إسناد صيانة محلية إلى الفني المتنقل {tech.FullName}."});db.Notifications.Add(new Notification{Message=$"تم إسناد الجهاز {d.DeviceCode} للصيانة المحلية في الفرع إلى {tech.FullName}.",TargetUrl="/technician",Type="info"});await RefreshRequestStatus(db,d.ServiceRequestId);await db.SaveChangesAsync();LocalDevice=null;Message="تم إسناد الجهاز للصيانة المحلية مع بقائه في الفرع.";await Load();}
 async Task ApproveList(){Message="";await using var db=await DbFactory.CreateDbContextAsync();var r=await db.ServiceRequests.Include(x=>x.Devices).FirstOrDefaultAsync(x=>x.Id==RequestId);if(r is null)return;var rows=r.Devices.Where(x=>x.Decision=="جاهز للإرسال"&&x.MaintenanceRoute=="مركز الصيانة"&&x.CurrentLocation=="الفرع"&&!x.SentAt.HasValue&&!x.MaintenanceReceivedAt.HasValue).ToList();if(!rows.Any()){Message="لا توجد أجهزة جاهزة للإرسال إلى المركز.";return;}r.ApprovedAt=DateTime.Now;r.DispatchReportPrintedAt=null;await db.SaveChangesAsync();Message="تم اعتماد قائمة الأجهزة المرسلة إلى مركز الصيانة.";await Load();}
 async Task SendRequest(){Message="";await using var db=await DbFactory.CreateDbContextAsync();var r=await db.ServiceRequests.Include(x=>x.Devices).FirstOrDefaultAsync(x=>x.Id==RequestId);if(r is null)return;var rows=r.Devices.Where(x=>x.Decision=="جاهز للإرسال"&&x.MaintenanceRoute=="مركز الصيانة"&&x.CurrentLocation=="الفرع"&&!x.SentAt.HasValue&&!x.MaintenanceReceivedAt.HasValue).ToList();if(!rows.Any()){Message="لا توجد أجهزة متاحة للإرسال.";return;}if(!r.ApprovedAt.HasValue){Message="اعتمد قائمة الإرسال أولًا.";return;}if(!r.DispatchReportPrintedAt.HasValue){Message="يجب طباعة التقرير أولًا.";return;}var remaining=r.Devices.Where(x=>x.Id>0&&!rows.Any(y=>y.Id==x.Id)&&x.Decision!="مستبعد"&&x.Decision!="مستبدل"&&x.Decision!="مهلك"&&x.CurrentStatus!="ملغى"&&x.CurrentStatus!="تم التسليم للعميل").ToList();
foreach(var d in rows){d.MaintenanceRoute="مركز الصيانة";d.SentAt=DateTime.Now;d.DispatchBatchCode=r.RequestNumber;d.CurrentLocation="في الطريق للصيانة";d.CurrentStatus="مع مندوب التوصيل";db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=r.Id,Status="مع مندوب التوصيل",Location="في الطريق للصيانة",StartedAt=DateTime.Now,ChangedBy=CurrentUser?.FullName??"مستخدم الفرع"});}db.Notifications.Add(new Notification{Message=$"تم إرسال {rows.Count} جهاز من الطلب {r.RequestNumber} إلى مركز الصيانة ويحتاج استلام المشرف.",TargetUrl="/service-requests/receiving",Type="info"});
r.SentAt=DateTime.Now;await RefreshRequestStatus(db,r.Id);await db.SaveChangesAsync();Message=remaining.Any()? $"تم إرسال {rows.Count} جهاز إلى مركز الصيانة. تنبيه: يوجد {remaining.Count} جهاز/أجهزة أخرى في نفس الطلب لم يتم إرسالها بعد. تم السماح بالإرسال الجزئي دون منع العملية.":$"تم إرسال {rows.Count} جهاز إلى مركز الصيانة.";await Load();}
 async Task RefreshRequestStatus(ArmsDbContext db,int requestId){var r=await db.ServiceRequests.Include(x=>x.Devices).FirstOrDefaultAsync(x=>x.Id==requestId);if(r is not null)r.Status=RequestStatusHelper.Calculate(r.Devices);}
 string DisplayDeviceStatus(ServiceDevice d)=>d.CurrentStatus;
}
