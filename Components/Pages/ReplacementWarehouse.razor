@page "/replacement-warehouse"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
<PageTitle>مستودع أجهزة الاستبدال</PageTitle>
@if(CurrentUser is null){<div class="empty">جارٍ تحميل الحساب...</div>}else if(!CanAccess){<div class="notice danger-notice">هذه الصفحة متاحة للمدير الرئيسي ومشرف الصيانة فقط.</div>}else{
<div class="page-head"><div><h1>مستودع أجهزة الاستبدال</h1><p>دورة حياة الأجهزة البديلة والاسترداد عند الإهلاك.</p></div></div>
@if(!string.IsNullOrWhiteSpace(Message)){<div class="notice @(Message.StartsWith("خطأ")?"danger-notice":"success-notice")">@Message</div>}
<div class="panel"><div class="section-title">إضافة جهاز</div><div class="form-grid"><div class="field"><label>كود الجهاز (اختياري)</label><input @bind="Editor.DeviceCode" /></div><div class="field"><label>نوع الجهاز *</label><select @bind="Editor.DeviceType"><option value="">اختر النوع</option>@foreach(var t in DeviceTypes){<option value="@t">@t</option>}</select></div><div class="field"><label>البراند *</label><input @bind="Editor.Brand" /></div><div class="field"><label>الموديل *</label><select @bind="Editor.Model"><option value="">اختر الموديل</option>@foreach(var m in Models.Where(x=>x.IsActive).OrderBy(x=>x.Name)){<option value="@m.Name">@m.Name</option>}</select></div><div class="field"><label>اللون *</label><input @bind="Editor.Color" /></div><div class="field"><label>السيريال</label><input @bind="Editor.SerialNumber" /></div><div class="field"><label>حالة الجهاز *</label><select @bind="Editor.DeviceCondition"><option value="">اختر الحالة</option><option>جديد</option><option>مستعمل</option></select></div></div><div class="actions-bottom"><button class="btn primary" @onclick="Add">+ إضافة للمستودع</button></div></div>
<div class="panel"><div class="section-title">الفلاتر</div><div class="filter-grid"><div class="field"><label>الجهاز / الموديل</label><select @bind="ModelFilter"><option value="">كل الأجهزة</option>@foreach(var m in Models.OrderBy(x=>x.Name)){<option value="@m.Name">@m.Name</option>}</select></div><div class="field"><label>حالة الجهاز</label><select @bind="StatusFilter"><option value="">كل الحالات</option><option>متاح</option><option>موقوف</option><option>مستبدل</option><option>مهلك</option><option>مخصص للطلب</option></select></div></div></div>
<div class="panel"><div class="section-title">الأجهزة (@Filtered.Count())</div><div class="table-wrap"><table><thead><tr><th>الكود</th><th>النوع</th><th>البراند</th><th>الموديل</th><th>اللون</th><th>السيريال</th><th>حالة الجهاز</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody>@foreach(var x in Filtered){<tr><td>@(string.IsNullOrWhiteSpace(x.DeviceCode)?"—":x.DeviceCode)</td><td>@x.DeviceType</td><td>@x.Brand</td><td>@x.Model</td><td>@x.Color</td><td>@x.SerialNumber</td><td>@x.DeviceCondition</td><td>@x.Status</td><td>@if((x.DeviceCondition=="مستعمل"||x.Status=="مستبدل")&&x.Status!="مهلك"){<button class="btn small danger" @onclick="()=>OpenScrap(x)">♻ إهلاك</button>} else if(x.Status=="متاح"){<button class="btn small" @onclick="()=>Toggle(x)">إيقاف</button>} else if(x.Status=="موقوف"){<button class="btn small" @onclick="()=>Toggle(x)">تفعيل</button>}</td></tr>}</tbody></table></div></div>
@if(ScrapItem is not null){<div class="modal-back"><div class="modal modal-wide"><div class="modal-head"><h3>إهلاك جهاز واستخراج قطع الغيار</h3><button class="btn gray" @onclick="CloseScrap">×</button></div><p>الجهاز: <b>@ScrapItem.Model</b> — @ScrapItem.SerialNumber</p><div class="field"><label>سبب الإهلاك *</label><input @bind="ScrapReason" /></div><div class="field"><label>ملاحظات</label><textarea @bind="ScrapNotes"></textarea></div><div class="section-title">القطع المستخرجة</div>@foreach(var p in ActiveParts){<div class="form-grid"><div class="field"><label><input type="checkbox" checked="@ScrapParts.ContainsKey(p.Id)" @onchange="e=>TogglePart(p.Id,(bool)e.Value!)" /> @p.Name (@p.Code)</label></div><div class="field"><label>الكمية</label><input type="number" min="1" value="@(ScrapParts.TryGetValue(p.Id,out var q)?q:1)" @onchange="e=>SetPartQty(p.Id,e.Value)" /></div></div>}<div class="actions-bottom"><button class="btn danger" @onclick="ConfirmScrap">تأكيد الإهلاك وإضافة القطع للمخزون</button><button class="btn gray" @onclick="CloseScrap">إلغاء</button></div></div></div>}
}
@code{
UserAccount? CurrentUser;List<ReplacementInventory> Items=new();List<DeviceModel> Models=new();List<SparePart> ActiveParts=new();ReplacementInventory Editor=new(){Status="متاح",DeviceCondition="",Location="مستودع المستبدل"};string Message="",ModelFilter="",StatusFilter="",ScrapReason="",ScrapNotes="";ReplacementInventory? ScrapItem;Dictionary<int,int> ScrapParts=new();bool CanAccess=>CurrentUser?.Role is "مدير رئيسي" or "مدير عام ARMS" or "مشرف صيانة" or "مدير صيانة";IEnumerable<string> DeviceTypes=>Models.Select(x=>x.DeviceType).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x=>x);IEnumerable<ReplacementInventory> Filtered=>Items.Where(x=>(string.IsNullOrWhiteSpace(ModelFilter)||x.Model==ModelFilter)&&(string.IsNullOrWhiteSpace(StatusFilter)||x.Status==StatusFilter));
protected override async Task OnInitializedAsync(){var u=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db, u);await Load();}
async Task Load(){await using var db=await DbFactory.CreateDbContextAsync();Items=await db.ReplacementInventory.OrderBy(x=>x.Status).ThenBy(x=>x.Model).ToListAsync();Models=await db.DeviceModels.ToListAsync();ActiveParts=await db.SpareParts.Where(x=>x.IsActive).OrderBy(x=>x.Name).ToListAsync();}
async Task Add(){Message="";Editor.DeviceCode=Editor.DeviceCode.Trim();Editor.DeviceType=Editor.DeviceType.Trim();Editor.Brand=Editor.Brand.Trim();Editor.Model=Editor.Model.Trim();Editor.Color=Editor.Color.Trim();Editor.SerialNumber=Editor.SerialNumber.Trim();if(string.IsNullOrWhiteSpace(Editor.DeviceType)||string.IsNullOrWhiteSpace(Editor.Model)||string.IsNullOrWhiteSpace(Editor.Color)||string.IsNullOrWhiteSpace(Editor.DeviceCondition)){Message="خطأ: نوع الجهاز والموديل واللون وحالة الجهاز إجبارية.";return;}await using var db=await DbFactory.CreateDbContextAsync();if(!string.IsNullOrWhiteSpace(Editor.DeviceCode)&&await db.ReplacementInventory.AnyAsync(x=>x.DeviceCode==Editor.DeviceCode)){Message="خطأ: كود الجهاز موجود بالفعل.";return;}db.ReplacementInventory.Add(new ReplacementInventory{DeviceCode=Editor.DeviceCode,DeviceType=Editor.DeviceType,Brand=Editor.Brand,Model=Editor.Model,Color=Editor.Color,SerialNumber=Editor.SerialNumber,Status="متاح",DeviceCondition=Editor.DeviceCondition,Location="مستودع المستبدل"});await db.SaveChangesAsync();Editor=new ReplacementInventory{Status="متاح",DeviceCondition="",Location="مستودع المستبدل"};Message="تمت إضافة الجهاز.";await Load();}
async Task Toggle(ReplacementInventory item){await using var db=await DbFactory.CreateDbContextAsync();var x=await db.ReplacementInventory.FindAsync(item.Id);if(x is null||x.Status is "مخصص للطلب" or "مستبدل" or "مهلك")return;x.Status=x.Status=="متاح"?"موقوف":"متاح";await db.SaveChangesAsync();await Load();}
void OpenScrap(ReplacementInventory x){ScrapItem=x;ScrapReason="";ScrapNotes="";ScrapParts.Clear();}void CloseScrap(){ScrapItem=null;ScrapParts.Clear();}void TogglePart(int id,bool on){if(on)ScrapParts[id]=1;else ScrapParts.Remove(id);}void SetPartQty(int id,object? value){if(int.TryParse(value?.ToString(),out var q)&&q>0)ScrapParts[id]=q;}
async Task ConfirmScrap(){if(ScrapItem is null)return;if(string.IsNullOrWhiteSpace(ScrapReason)){Message="خطأ: سبب الإهلاك إجباري.";return;}await using var db=await DbFactory.CreateDbContextAsync();var x=await db.ReplacementInventory.FindAsync(ScrapItem.Id);if(x is null||x.Status=="مهلك")return;var now=DateTime.Now;x.Status="مهلك";x.ScrappedAt=now;x.ScrapReason=ScrapReason;x.ScrapNotes=ScrapNotes;foreach(var item in ScrapParts){var part=await db.SpareParts.FindAsync(item.Key);if(part is null||!part.IsActive)continue;part.StockQuantity+=item.Value;db.SparePartMovements.Add(new SparePartMovement{SparePartId=part.Id,MovementType="استرداد من جهاز مهلك",Quantity=item.Value,MovementDate=now,Location="فرع الصيانة",DeviceModel=x.Model,DeviceCode=x.DeviceCode,Notes=$"استخراج من جهاز مستبدل/مستعمل مهلك رقم {x.Id}. سبب الإهلاك: {ScrapReason}"});}await db.SaveChangesAsync();Message="تم إهلاك الجهاز وإضافة القطع المستخرجة إلى المخزون.";CloseScrap();await Load();}
}
