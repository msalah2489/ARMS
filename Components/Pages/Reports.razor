async Task ExportExcel(){var rows=new List<string[]>();if(ReportType=="requests"){rows.Add(new[]{"رقم الطلب","العميل","الجوال","الفرع","الأجهزة","الأولوية","الحالة","التاريخ"});rows.AddRange(RequestRows.Select(r=>new[]{r.RequestNumber,r.CustomerName,r.Phone,r.Branch,r.Devices.Count.ToString(),r.Priority,DisplayRequestStatus(r),r.CreatedAt.ToString("yyyy-MM-dd")}));}else if(ReportType=="parts-movements"){rows.Add(new[]{"التاريخ","نوع الحركة","قطعة الغيار","الكود","الكمية","السند","الموقع","الفني","الجهاز","الموديل","ملاحظات"});rows.AddRange(MovementRows.Select(m=>new[]{m.MovementDate.ToString("yyyy-MM-dd HH:mm"),m.MovementType,m.SparePart?.Name??"",m.SparePart?.Code??"",m.Quantity.ToString(),m.ReferenceNumber,m.Location,m.TechnicianName,m.DeviceCode,m.DeviceModel,m.Notes}));}else if(ReportType is "parts" or "technician-parts"){rows.Add(new[]{"التاريخ","الفني","قطعة الغيار","اللون","الكمية","الجهاز","نوع الجهاز","الموديل","السيريال","رقم الطلب","العميل","الفرع"});rows.AddRange(UsageRows.Select(u=>new[]{u.UsedAt.ToString("yyyy-MM-dd HH:mm"),u.TechnicianName,u.SparePart?.Name??"",u.SparePart?.Color??"",u.Quantity.ToString(),u.ServiceDevice?.DeviceCode??"",u.ServiceDevice?.DeviceType??"",u.ServiceDevice?.Model??"",u.ServiceDevice?.SerialNumber??"",u.ServiceDevice?.ServiceRequest?.RequestNumber??"",u.ServiceDevice?.ServiceRequest?.CustomerName??"",u.ServiceDevice?.ServiceRequest?.Branch??""}));}else if(ReportType=="fault-analysis"){rows.Add(new[]{"نوع التحليل","النص","العدد","حسب الجهاز"});rows.AddRange(ComplaintAnalysis.Select(x=>new[]{"شكوى",x.Text,x.Count.ToString(),x.Breakdown}));rows.AddRange(FaultAnalysis.Select(x=>new[]{"سبب عطل",x.Text,x.Count.ToString(),x.Breakdown}));rows.AddRange(ModelAnalysis.Select(x=>new[]{"موديل",x.Model,x.Cases.ToString()}));}else{rows.Add(new[]{"كود الجهاز","النوع","البراند","الموديل","السيريال","رقم الطلب","العميل","الفرع","العطل","الموقع","الحالة","القرار","تاريخ الإنشاء","تاريخ الإرسال"});rows.AddRange(DeviceRows.Select(d=>new[]{d.DeviceCode,d.DeviceType,d.Brand,d.Model,d.SerialNumber,d.ServiceRequest?.RequestNumber??"",d.ServiceRequest?.CustomerName??"",d.ServiceRequest?.Branch??"",d.Problem,d.CurrentLocation,d.CurrentStatus,d.Decision,d.ServiceRequest?.CreatedAt.ToString("yyyy-MM-dd")??"",d.SentAt?.ToString("yyyy-MM-dd HH:mm")??""}));}var bytes=CreateXlsx(rows);await JS.InvokeVoidAsync("armsDownload.downloadBase64",$"ARMS-{ReportType}-{DateTime.Now:yyyyMMdd-HHmmss}.xlsx","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",Convert.ToBase64String(bytes));}
static byte[] CreateXlsx(List<string[]> rows)
{
    using var ms = new MemoryStream();
    using (var zip = new ZipArchive(ms, ZipArchiveMode.Create, true))
    {
        Add(zip, "[Content_Types].xml", "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\"><Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/><Default Extension=\"xml\" ContentType=\"application/xml\"/><Override PartName=\"/xl/workbook.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\"/><Override PartName=\"/xl/worksheets/sheet1.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/></Types>");
        Add(zip, "_rels/.rels", "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"xl/workbook.xml\"/></Relationships>");
        Add(zip, "xl/workbook.xml", "<?xml version=\"1.0\" encoding=\"UTF-8\"?><workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\"><sheets><sheet name=\"ARMS Report\" sheetId=\"1\" r:id=\"rId1\"/></sheets></workbook>");
        Add(zip, "xl/_rels/workbook.xml.rels", "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"worksheets/sheet1.xml\"/></Relationships>");
        XNamespace ns = "http://schemas.openxmlformats.org/spreadsheetml/2006/main";
        var sheetData = new XElement(ns + "sheetData");
        for (var i = 0; i < rows.Count; i++)
        {
            var row = new XElement(ns + "row", new XAttribute("r", i + 1));
            for (var j = 0; j < rows[i].Length; j++)
            {
                row.Add(new XElement(ns + "c",
                    new XAttribute("r", Col(j + 1) + (i + 1)),
                    new XAttribute("t", "inlineStr"),
                    new XElement(ns + "is", new XElement(ns + "t", rows[i][j] ?? string.Empty))));
            }
            sheetData.Add(row);
        }
        var doc = new XDocument(new XDeclaration("1.0", "UTF-8", null), new XElement(ns + "worksheet", sheetData));
        Add(zip, "xl/worksheets/sheet1.xml", doc.ToString(SaveOptions.DisableFormatting));
    }
    return ms.ToArray();
}
static string Col(int n){var s="";while(n>0){n--;s=(char)('A'+n%26)+s;n/=26;}return s;}
static void Add(ZipArchive z,string path,string text){var e=z.CreateEntry(path);using var w=new StreamWriter(e.Open(),new UTF8Encoding(false));w.Write(text);}
record AnalysisRow(string Text,int Count,string Breakdown);
