@page "/reports"
@rendermode InteractiveServer
@inject NavigationManager Nav
@using System.IO.Compression
@using System.Text
@using System.Xml.Linq
@using System.Xml
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
<PageTitle>التقارير</PageTitle>
<div class="page-head"><div><h1>التقارير</h1><p>تقارير التشغيل والصيانة وقطع الغيار واستهلاك الفنيين.</p></div></div>
<div class="stats"><div class="stat"><span>إجمالي الطلبات</span><b>@Requests</b></div><div class="stat"><span>إجمالي الأجهزة</span><b>@Devices</b></div><div class="stat"><span>جاهز للإرسال</span><b>@Ready</b></div><div class="stat"><span>مستبعد</span><b>@Excluded</b></div><div class="stat"><span>تم الإرسال</span><b>@Sent</b></div></div>
<div class="panel"><div class="section-title">إصدار تقرير</div><div class="filter-grid"><div class="field"><label>نوع التقرير</label><select @bind="ReportType"><option value="requests">طلبات الصيانة</option><option value="devices">الأجهزة</option><option value="sent">الأجهزة المرسلة</option><option value="excluded">الأجهزة المستبعدة</option>@if(CanSeeParts){<option value="parts">استهلاك قطع الغيار</option><option value="technician-parts">استهلاك قطع الغيار حسب الفني</option><option value="parts-movements">حركة قطع الغيار (استلام واستهلاك واسترداد)</option>}@if(CanSeeFaults){<option value="fault-analysis">تحليل الأعطال والشكاوى</option>}</select></div><div class="field"><label>من تاريخ</label><input type="date" @bind="FromDate" /></div><div class="field"><label>إلى تاريخ</label><input type="date" @bind="ToDate" /></div><div class="field"><label>العميل</label><input @bind="Customer" /></div><div class="field"><label>كود الجهاز</label><input @bind="DeviceCodeFilter" placeholder="اختياري" /></div><div class="field"><label>الموديل</label><select @bind="ModelFilter"><option value="">كل الموديلات</option>@foreach(var m in ModelOptions){<option value="@m">@m</option>}</select></div>@if(ReportType=="technician-parts" || ReportType=="parts-movements"){<div class="field"><label>الفني</label><select @bind="TechnicianFilter"><option value="">كل الفنيين</option>@foreach(var t in TechnicianOptions){<option value="@t">@t</option>}</select></div>}<div class="field"><label>فرع المستخدم</label><input value="@Branch" readonly /></div><div class="field"><label>عدد الصفوف</label><select @bind="PageSize" @bind:after="ResetPage"><option value="10">10</option><option value="20">20</option><option value="50">50</option><option value="100">100</option></select></div></div><div class="toolbar" style="margin-top:12px"><button class="btn primary" @onclick="Generate">تطبيق الفلاتر</button><button class="btn outline" @onclick="Print">🖨 طباعة التقرير</button><button class="btn green" @onclick="ExportExcel">📊 تصدير Excel</button></div></div>
<div class="panel" id="report-area"><img class="company-print-logo print-only" src="/images/company-logo.png" alt="الشركة"/><div class="print-only report-title">@ReportTitle</div>
@if(ReportType=="requests")
{
<table><thead><tr><th @onclick='()=>RepSortBy("")'>رقم الطلب @RepSortIcon("")</th><th @onclick='()=>RepSortBy("Customer")'>العميل @RepSortIcon("Customer")</th><th @onclick='()=>RepSortBy("Phone")'>الجوال @RepSortIcon("Phone")</th><th @onclick='()=>RepSortBy("Branch")'>الفرع @RepSortIcon("Branch")</th><th @onclick='()=>RepSortBy("Devices")'>الأجهزة @RepSortIcon("Devices")</th><th @onclick='()=>RepSortBy("Priority")'>الأولوية @RepSortIcon("Priority")</th><th @onclick='()=>RepSortBy("Status")'>الحالة @RepSortIcon("Status")</th><th @onclick='()=>RepSortBy("Date")'>التاريخ @RepSortIcon("Date")</th></tr></thead><tbody>@foreach(var r in Paged(SortedRequestRows)){<tr><td>@r.RequestNumber</td><td>@r.CustomerName</td><td>@r.Phone</td><td>@r.Branch</td><td>@r.Devices.Count</td><td>@r.Priority</td><td>@DisplayRequestStatus(r)</td><td>@r.CreatedAt.ToString("yyyy-MM-dd")</td></tr>}</tbody></table>
}
else if(ReportType is "parts" or "technician-parts")
{
<table><thead><tr><th>التاريخ</th><th>الفني</th><th>قطعة الغيار</th><th>اللون</th><th>الكمية</th><th>الجهاز</th><th>نوع الجهاز</th><th>الموديل</th><th>السيريال</th><th>رقم الطلب</th><th>العميل</th><th>الفرع</th></tr></thead><tbody>@if(UsageRows.Count==0){<tr><td colspan="12"><div class="empty">لا توجد عمليات استهلاك قطع غيار ضمن الفلاتر الحالية.</div></td></tr>}@foreach(var u in Paged(UsageRows)){<tr><td>@u.UsedAt.ToString("yyyy-MM-dd HH:mm")</td><td>@u.TechnicianName</td><td>@u.SparePart?.Name</td><td>@u.SparePart?.Color</td><td>@u.Quantity</td><td>@u.ServiceDevice?.DeviceCode</td><td>@u.ServiceDevice?.DeviceType</td><td>@u.ServiceDevice?.Model</td><td>@u.ServiceDevice?.SerialNumber</td><td>@u.ServiceDevice?.ServiceRequest?.RequestNumber</td><td>@u.ServiceDevice?.ServiceRequest?.CustomerName</td><td>@u.ServiceDevice?.ServiceRequest?.Branch</td></tr>}</tbody></table>
}
else if(ReportType=="parts-movements")
{
<table><thead><tr><th>التاريخ</th><th>نوع الحركة</th><th>قطعة الغيار</th><th>الكود</th><th>الكمية</th><th>السند</th><th>الموقع</th><th>الفني</th><th>الجهاز</th><th>الموديل</th><th>ملاحظات</th></tr></thead><tbody>@if(MovementRows.Count==0){<tr><td colspan="11"><div class="empty">لا توجد حركات ضمن الفلاتر الحالية.</div></td></tr>}@foreach(var m in Paged(MovementRows)){<tr><td>@m.MovementDate.ToString("yyyy-MM-dd HH:mm")</td><td>@m.MovementType</td><td>@m.SparePart?.Name</td><td>@m.SparePart?.Code</td><td>@m.Quantity</td><td>@m.ReferenceNumber</td><td>@m.Location</td><td>@m.TechnicianName</td><td>@m.DeviceCode</td><td>@m.DeviceModel</td><td>@m.Notes</td></tr>}</tbody></table>
}
else if(ReportType=="fault-analysis")
{
<div class="info-grid">
  <div class="panel"><div class="section-title">أكثر شكاوى العملاء</div><table><thead><tr><th>الشكوى</th><th>عدد الحالات</th><th>حسب الجهاز</th></tr></thead><tbody>@foreach(var x in Paged(ComplaintAnalysis)){<tr><td>@x.Text</td><td>@x.Count</td><td>@x.Breakdown</td></tr>}</tbody></table></div>
  <div class="panel"><div class="section-title">أكثر أسباب الأعطال</div><table><thead><tr><th>سبب العطل</th><th>عدد الحالات</th><th>حسب الجهاز</th></tr></thead><tbody>@foreach(var x in Paged(FaultAnalysis)){<tr><td>@x.Text</td><td>@x.Count</td><td>@x.Breakdown</td></tr>}</tbody></table></div>
</div>
<table><thead><tr><th>الموديل</th><th>عدد الأجهزة</th><th>عدد الحالات</th><th>أكثر شكوى</th><th>أكثر سبب عطل</th></tr></thead><tbody>@foreach(var x in Paged(ModelAnalysis)){<tr><td>@x.Model</td><td>@x.Devices</td><td>@x.Cases</td><td>@x.TopComplaint</td><td>@x.TopFault</td></tr>}</tbody></table>
}
else
{
<table><thead><tr><th @onclick='()=>RepSortBy("")'>كود الجهاز @RepSortIcon("")</th><th @onclick='()=>RepSortBy("Type")'>النوع @RepSortIcon("Type")</th><th @onclick='()=>RepSortBy("Brand")'>البراند @RepSortIcon("Brand")</th><th @onclick='()=>RepSortBy("Model")'>الموديل @RepSortIcon("Model")</th><th @onclick='()=>RepSortBy("Serial")'>السيريال @RepSortIcon("Serial")</th><th @onclick='()=>RepSortBy("RequestNumber")'>رقم الطلب @RepSortIcon("RequestNumber")</th><th @onclick='()=>RepSortBy("Customer")'>العميل @RepSortIcon("Customer")</th><th @onclick='()=>RepSortBy("Branch")'>الفرع @RepSortIcon("Branch")</th><th>العطل</th><th @onclick='()=>RepSortBy("Location")'>الموقع الحالي @RepSortIcon("Location")</th><th>الحالة التشغيلية</th><th>القرار</th><th @onclick='()=>RepSortBy("Status")'>الحالة @RepSortIcon("Status")</th><th @onclick='()=>RepSortBy("Priority")'>الأولوية @RepSortIcon("Priority")</th><th @onclick='()=>RepSortBy("Created")'>تاريخ الإنشاء @RepSortIcon("Created")</th><th @onclick='()=>RepSortBy("Sent")'>تاريخ الإرسال @RepSortIcon("Sent")</th><th @onclick='()=>RepSortBy("Returned")'>تاريخ الإرجاع @RepSortIcon("Returned")</th></tr></thead><tbody>@foreach(var d in Paged(SortedDeviceRows)){<tr><td>@d.DeviceCode</td><td>@d.DeviceType</td><td>@d.Brand</td><td>@d.Model</td><td>@d.SerialNumber</td><td>@d.ServiceRequest?.RequestNumber</td><td>@d.ServiceRequest?.CustomerName</td><td>@d.ServiceRequest?.Branch</td><td>@d.Problem</td><td>@d.CurrentLocation</td><td>@d.CurrentStatus</td><td>@d.Decision</td><td>@DisplayDeviceStatus(d)</td><td>@d.ServiceRequest?.Priority</td><td>@d.ServiceRequest?.CreatedAt.ToString("yyyy-MM-dd")</td><td>@d.SentAt?.ToString("yyyy-MM-dd HH:mm")</td><td>@d.ReturnedAt?.ToString("yyyy-MM-dd HH:mm")</td></tr>}</tbody></table>
}
<div class="actions-bottom" style="justify-content:center;gap:8px"><button class="btn outline" disabled="@(Page<=1)" @onclick="PrevPage">← السابق</button><span class="small">صفحة @Page من @TotalPages — إجمالي @CurrentTotal</span><button class="btn outline" disabled="@(Page>=TotalPages)" @onclick="NextPage">التالي →</button></div>
</div>
@code {
string ReportType="requests",Customer="",ModelFilter="",TechnicianFilter="",DeviceCodeFilter="",Branch="الرياض"; UserAccount? CurrentUser; bool IsBranch,IsTechnician; DateTime? FromDate,ToDate; string ReportTitle="تقرير طلبات الصيانة"; int Requests,Devices,Ready,Excluded,Sent; List<ServiceRequest> RequestRows=new(); List<ServiceDevice> DeviceRows=new(); List<SparePartUsage> UsageRows=new(); List<SparePartMovement> MovementRows=new(); List<string> ModelOptions=new(),TechnicianOptions=new(); List<AnalysisRow> ComplaintAnalysis=new(),FaultAnalysis=new(); List<ModelAnalysisRow> ModelAnalysis=new(); int Page=1,PageSize=10; bool CanSeeFaults=>CurrentUser?.Role is "خدمة العملاء" or "مشرف صيانة" or "مدير صيانة" or "مدير رئيسي" or "مدير عام ARMS"; bool CanSeeParts=>CurrentUser?.Role is "مشرف صيانة" or "مدير صيانة" or "مدير رئيسي" or "مدير عام ARMS"; int CurrentTotal=>ReportType=="requests"?RequestRows.Count:ReportType is "parts" or "technician-parts"?UsageRows.Count:ReportType=="parts-movements"?MovementRows.Count:ReportType=="fault-analysis"?Math.Max(ComplaintAnalysis.Count,Math.Max(FaultAnalysis.Count,ModelAnalysis.Count)):DeviceRows.Count; int TotalPages=>Math.Max(1,(int)Math.Ceiling(CurrentTotal/(double)PageSize)); void ResetPage(){Page=1;} void PrevPage(){if(Page>1)Page--;} void NextPage(){if(Page<TotalPages)Page++;} IEnumerable<T> Paged<T>(IEnumerable<T> rows)=>rows.Skip((Page-1)*PageSize).Take(PageSize);
string RepSortColumn=""; bool RepSortAsc=true;
void RepSortBy(string c){if(RepSortColumn==c)RepSortAsc=!RepSortAsc;else{RepSortColumn=c;RepSortAsc=true;}}
string RepSortIcon(string c)=>RepSortColumn==c?(RepSortAsc?"↑":"↓"):"↕";
IEnumerable<ServiceRequest> SortedRequestRows{get{IEnumerable<ServiceRequest> q=RequestRows;return RepSortColumn switch{
 "Customer"=>(RepSortAsc?q.OrderBy(x=>x.CustomerName):q.OrderByDescending(x=>x.CustomerName)),
 "Phone"=>(RepSortAsc?q.OrderBy(x=>x.Phone):q.OrderByDescending(x=>x.Phone)),
 "Branch"=>(RepSortAsc?q.OrderBy(x=>x.Branch):q.OrderByDescending(x=>x.Branch)),
 "Devices"=>(RepSortAsc?q.OrderBy(x=>x.Devices.Count):q.OrderByDescending(x=>x.Devices.Count)),
 "Priority"=>(RepSortAsc?q.OrderBy(x=>x.Priority):q.OrderByDescending(x=>x.Priority)),
 "Status"=>(RepSortAsc?q.OrderBy(x=>DisplayRequestStatus(x)):q.OrderByDescending(x=>DisplayRequestStatus(x))),
 "Date"=>(RepSortAsc?q.OrderBy(x=>x.CreatedAt):q.OrderByDescending(x=>x.CreatedAt)),
 _=>(RepSortAsc?q.OrderBy(x=>x.RequestNumber):q.OrderByDescending(x=>x.RequestNumber))};}}
IEnumerable<ServiceDevice> SortedDeviceRows{get{IEnumerable<ServiceDevice> q=DeviceRows;return RepSortColumn switch{
 "Type"=>(RepSortAsc?q.OrderBy(x=>x.DeviceType):q.OrderByDescending(x=>x.DeviceType)),
 "Brand"=>(RepSortAsc?q.OrderBy(x=>x.Brand):q.OrderByDescending(x=>x.Brand)),
 "Model"=>(RepSortAsc?q.OrderBy(x=>x.Model):q.OrderByDescending(x=>x.Model)),
 "Serial"=>(RepSortAsc?q.OrderBy(x=>x.SerialNumber):q.OrderByDescending(x=>x.SerialNumber)),
 "RequestNumber"=>(RepSortAsc?q.OrderBy(x=>x.ServiceRequest!.RequestNumber):q.OrderByDescending(x=>x.ServiceRequest!.RequestNumber)),
 "Customer"=>(RepSortAsc?q.OrderBy(x=>x.ServiceRequest!.CustomerName):q.OrderByDescending(x=>x.ServiceRequest!.CustomerName)),
 "Branch"=>(RepSortAsc?q.OrderBy(x=>x.ServiceRequest!.Branch):q.OrderByDescending(x=>x.ServiceRequest!.Branch)),
 "Location"=>(RepSortAsc?q.OrderBy(x=>x.CurrentLocation):q.OrderByDescending(x=>x.CurrentLocation)),
 "Status"=>(RepSortAsc?q.OrderBy(x=>DisplayDeviceStatus(x)):q.OrderByDescending(x=>DisplayDeviceStatus(x))),
 "Priority"=>(RepSortAsc?q.OrderBy(x=>x.ServiceRequest!.Priority):q.OrderByDescending(x=>x.ServiceRequest!.Priority)),
 "Created"=>(RepSortAsc?q.OrderBy(x=>x.ServiceRequest!.CreatedAt):q.OrderByDescending(x=>x.ServiceRequest!.CreatedAt)),
 "Sent"=>(RepSortAsc?q.OrderBy(x=>x.SentAt):q.OrderByDescending(x=>x.SentAt)),
 "Returned"=>(RepSortAsc?q.OrderBy(x=>x.ReturnedAt):q.OrderByDescending(x=>x.ReturnedAt)),
 _=>(RepSortAsc?q.OrderBy(x=>x.DeviceCode):q.OrderByDescending(x=>x.DeviceCode))};}}
protected override async Task OnInitializedAsync(){var username=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db, username);if(CurrentUser?.Role=="خدمة العملاء"){Nav.NavigateTo("/customer-service");return;}IsBranch=CurrentUser?.Role=="مستخدم فرع";IsTechnician=CurrentUser?.Role is "فني صيانة" or "فني متنقل";Branch=IsBranch?CurrentUser!.Branch:"الرياض";ModelOptions=await db.DeviceModels.Where(x=>x.IsActive).Select(x=>x.Name).Concat(await db.ServiceDevices.Where(x=>x.Model!="").Select(x=>x.Model).Distinct().ToListAsync()).Distinct().OrderBy(x=>x).ToListAsync();TechnicianOptions=await db.SparePartUsages.Select(x=>x.TechnicianName).Where(x=>x!="").Distinct().OrderBy(x=>x).ToListAsync();await LoadStats();await Generate();}
async Task LoadStats(){await using var db=await DbFactory.CreateDbContextAsync();Requests=await db.ServiceRequests.CountAsync(x=>!IsBranch||x.Branch==Branch);Devices=await db.ServiceDevices.CountAsync(x=>x.ServiceRequest!=null&&(!IsBranch||x.ServiceRequest.Branch==Branch));Ready=await db.ServiceDevices.CountAsync(x=>x.ServiceRequest!=null&&(!IsBranch||x.ServiceRequest.Branch==Branch)&&x.CurrentLocation=="مستودع الأجهزة الجاهزة للإرجاع"&&x.CurrentStatus=="جاهز للإرسال"&&x.SentAt==null&&x.Decision!="مستبعد"&&x.Decision!="مهلك"&&x.Decision!="مستبدل");Excluded=await db.ServiceDevices.CountAsync(x=>x.ServiceRequest!=null&&(!IsBranch||x.ServiceRequest.Branch==Branch)&&x.Decision=="مستبعد");Sent=await db.ServiceDevices.CountAsync(x=>x.ServiceRequest!=null&&(!IsBranch||x.ServiceRequest.Branch==Branch)&&x.SentAt!=null);}
async Task Generate(){if(ReportType=="fault-analysis"&&!CanSeeFaults){ReportType="requests";Page=1;}if((ReportType=="parts"||ReportType=="technician-parts"||ReportType=="parts-movements")&&!CanSeeParts){ReportType="requests";Page=1;}Page=1;await using var db=await DbFactory.CreateDbContextAsync();if(ReportType=="requests"){ReportTitle="تقرير طلبات الصيانة";var q=db.ServiceRequests.Include(x=>x.Devices).AsQueryable();if(IsBranch)q=q.Where(x=>x.Branch==Branch);if(IsTechnician)q=q.Where(x=>x.Devices.Any(d=>d.AssignedTechnicianId==CurrentUser!.Id||d.MaintenanceTechnicianName==CurrentUser.FullName));if(!string.IsNullOrWhiteSpace(Customer))q=q.Where(x=>x.CustomerName.Contains(Customer.Trim()));if(!string.IsNullOrWhiteSpace(ModelFilter))q=q.Where(x=>x.Devices.Any(d=>d.Model==ModelFilter.Trim()));if(FromDate.HasValue)q=q.Where(x=>x.CreatedAt>=FromDate.Value.Date);if(ToDate.HasValue)q=q.Where(x=>x.CreatedAt<ToDate.Value.Date.AddDays(1));RequestRows=await q.OrderByDescending(x=>x.CreatedAt).ToListAsync();DeviceRows=new();UsageRows=new();}
else if(ReportType=="fault-analysis"){ReportTitle="تحليل الأعطال والشكاوى";var q=db.ServiceDevices.Include(x=>x.ServiceRequest).AsQueryable();if(IsBranch)q=q.Where(x=>x.ServiceRequest!=null&&x.ServiceRequest.Branch==Branch);if(IsTechnician)q=q.Where(x=>x.AssignedTechnicianId==CurrentUser!.Id||x.MaintenanceTechnicianName==CurrentUser.FullName);if(!string.IsNullOrWhiteSpace(Customer))q=q.Where(x=>x.ServiceRequest!=null&&x.ServiceRequest.CustomerName.Contains(Customer.Trim()));if(!string.IsNullOrWhiteSpace(ModelFilter))q=q.Where(x=>x.Model==ModelFilter.Trim());if(!string.IsNullOrWhiteSpace(DeviceCodeFilter))q=q.Where(x=>x.DeviceCode.Contains(DeviceCodeFilter.Trim()));if(FromDate.HasValue)q=q.Where(x=>x.ServiceRequest!=null&&x.ServiceRequest.CreatedAt>=FromDate.Value.Date);if(ToDate.HasValue)q=q.Where(x=>x.ServiceRequest!=null&&x.ServiceRequest.CreatedAt<ToDate.Value.Date.AddDays(1));var data=await q.ToListAsync();ComplaintAnalysis=data.Where(d=>Complaint(d)!="—").GroupBy(d=>Complaint(d)).OrderByDescending(g=>g.Count()).ThenBy(g=>g.Key).Take(30).Select(g=>new AnalysisRow(g.Key,g.Count(),string.Join(" ؛ ",g.GroupBy(d=>d.Model??"غير محدد").OrderByDescending(x=>x.Count()).Select(x=>$"الجهاز {x.Key}: {x.Count()} حالات")))).ToList();FaultAnalysis=data.GroupBy(d=>string.IsNullOrWhiteSpace(d.FaultCause)?"غير مسجل":d.FaultCause.Trim()).OrderByDescending(g=>g.Count()).ThenBy(g=>g.Key).Take(30).Select(g=>new AnalysisRow(g.Key,g.Count(),string.Join(" ؛ ",g.GroupBy(d=>d.Model??"غير محدد").OrderByDescending(x=>x.Count()).Select(x=>$"الجهاز {x.Key}: {x.Count()} حالات")))).ToList();ModelAnalysis=data.GroupBy(x=>x.Model??"").OrderByDescending(g=>g.Count()).Select(g=>new ModelAnalysisRow(g.Key,g.Select(x=>x.Id).Distinct().Count(),g.Count(),TopText(g.Select(Complaint)),TopText(g.Select(x=>string.IsNullOrWhiteSpace(x.FaultCause)?"غير مسجل":x.FaultCause)))).ToList();RequestRows=new();DeviceRows=new();UsageRows=new();MovementRows=new();}
else if(ReportType=="parts-movements"){ReportTitle="حركة قطع الغيار";var q=db.SparePartMovements.Include(x=>x.SparePart).AsQueryable();if(IsBranch)q=q.Where(x=>x.Location==Branch);if(IsTechnician)q=q.Where(x=>x.TechnicianName==CurrentUser!.FullName);if(!string.IsNullOrWhiteSpace(ModelFilter))q=q.Where(x=>x.DeviceModel==ModelFilter.Trim());if(!string.IsNullOrWhiteSpace(TechnicianFilter))q=q.Where(x=>x.TechnicianName==TechnicianFilter);if(FromDate.HasValue)q=q.Where(x=>x.MovementDate>=FromDate.Value.Date);if(ToDate.HasValue)q=q.Where(x=>x.MovementDate<ToDate.Value.Date.AddDays(1));MovementRows=await q.OrderByDescending(x=>x.MovementDate).ToListAsync();RequestRows=new();DeviceRows=new();UsageRows=new();}
else if(ReportType is "parts" or "technician-parts"){ReportTitle=ReportType=="parts"?"تقرير استهلاك قطع الغيار":"تقرير استهلاك قطع الغيار حسب الفني";var q=db.SparePartUsages.Include(x=>x.SparePart).Include(x=>x.ServiceDevice).ThenInclude(x=>x!.ServiceRequest).AsQueryable();if(IsBranch)q=q.Where(x=>x.ServiceDevice!.ServiceRequest!.Branch==Branch);if(IsTechnician)q=q.Where(x=>x.TechnicianName==CurrentUser!.FullName);if(!string.IsNullOrWhiteSpace(Customer))q=q.Where(x=>x.ServiceDevice!.ServiceRequest!.CustomerName.Contains(Customer.Trim()));if(!string.IsNullOrWhiteSpace(ModelFilter))q=q.Where(x=>x.ServiceDevice!.Model==ModelFilter.Trim());if(!string.IsNullOrWhiteSpace(TechnicianFilter))q=q.Where(x=>x.TechnicianName==TechnicianFilter);if(FromDate.HasValue)q=q.Where(x=>x.UsedAt>=FromDate.Value.Date);if(ToDate.HasValue)q=q.Where(x=>x.UsedAt<ToDate.Value.Date.AddDays(1));UsageRows=await q.OrderByDescending(x=>x.UsedAt).ToListAsync();RequestRows=new();DeviceRows=new();}
else{ReportTitle=ReportType=="sent"?"تقرير الأجهزة المرسلة":ReportType=="excluded"?"تقرير الأجهزة المستبعدة":"تقرير الأجهزة";var q=db.ServiceDevices.Include(x=>x.ServiceRequest).Include(x=>x.DeviceStatusHistories).AsQueryable();if(IsBranch)q=q.Where(x=>x.ServiceRequest!=null&&x.ServiceRequest.Branch==Branch);if(IsTechnician)q=q.Where(x=>x.AssignedTechnicianId==CurrentUser!.Id||x.MaintenanceTechnicianName==CurrentUser.FullName||x.DeviceStatusHistories.Any(h=>h.ChangedBy==CurrentUser.FullName));if(!string.IsNullOrWhiteSpace(Customer))q=q.Where(x=>x.ServiceRequest!=null&&x.ServiceRequest.CustomerName.Contains(Customer.Trim()));if(!string.IsNullOrWhiteSpace(ModelFilter))q=q.Where(x=>x.Model==ModelFilter.Trim());if(!string.IsNullOrWhiteSpace(DeviceCodeFilter))q=q.Where(x=>x.DeviceCode.Contains(DeviceCodeFilter.Trim()));if(FromDate.HasValue)q=q.Where(x=>(x.SentAt??x.ServiceRequest!.CreatedAt)>=FromDate.Value.Date);if(ToDate.HasValue)q=q.Where(x=>(x.SentAt??x.ServiceRequest!.CreatedAt)<ToDate.Value.Date.AddDays(1));if(ReportType=="sent")q=q.Where(x=>x.SentAt!=null);if(ReportType=="excluded")q=q.Where(x=>x.Decision=="مستبعد");DeviceRows=await q.OrderByDescending(x=>x.Id).ToListAsync();RequestRows=new();UsageRows=new();}}
string DisplayRequestStatus(ServiceRequest r)=>RequestStatusHelper.Calculate(r.Devices);
string DisplayDeviceStatus(ServiceDevice d){if(d.Decision=="ملغى"||d.CurrentStatus=="ملغى")return "ملغى";if(d.Decision=="مستبعد")return "مستبعد";if(d.Decision=="مستبدل")return "مستبدل";if(d.Decision=="مهلك")return "مهلك";if(d.CustomerDeliveredAt.HasValue)return "مغلق";if(d.CurrentLocation=="في الطريق للفرع")return "في الطريق للفرع";if(d.CurrentLocation=="مستودع الأجهزة الجاهزة للإرجاع"&&d.CurrentStatus=="جاهز للإرسال")return "جاهز للإرسال";if(d.MaintenancePaused||d.CurrentStatus=="معلق")return "معلق";if(d.AssignedTechnicianId.HasValue||d.MaintenanceStartedAt.HasValue)return "قيد الصيانة";if(d.CurrentLocation=="مركز الصيانة")return "بانتظار بدء الصيانة";if(d.CurrentLocation=="في الطريق للصيانة")return "في الطريق للصيانة";return d.CurrentStatus;}
