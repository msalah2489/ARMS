string Complaint(ServiceDevice d)=>string.IsNullOrWhiteSpace(d.ComplaintDetails)?(string.IsNullOrWhiteSpace(d.Problem)?"—":d.Problem.Trim()):d.ComplaintDetails.Trim();
string TopText(IEnumerable<string> values){var g=values.Where(x=>!string.IsNullOrWhiteSpace(x)&&x!="—").GroupBy(x=>x).OrderByDescending(x=>x.Count()).FirstOrDefault();return g?.Key??"—";}

