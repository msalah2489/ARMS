@page "/service-requests/{RequestId:int}"
@rendermode InteractiveServer
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
<PageTitle>تفاصيل طلب الصيانة</PageTitle>
@if(Request is null){<div class="empty">جارٍ تحميل الطلب...</div>}else{
<div class="page-head"><div><div class="breadcrumb"><a href="/service-requests">← طلبات الصيانة</a></div><h1>تفاصيل طلب الصيانة</h1><p>مراجعة بيانات العميل والأجهزة ومسارات الصيانة.</p></div><div class="toolbar">@if(IsBranch && CanPrepare){<a class="btn primary" href="@($"/service-requests/{Request.Id}/prepare")">تحديد مسار الصيانة</a>}@if(IsBranch && CanCancel){<a class="btn outline" href="@($"/service-requests/{Request.Id}/edit")">✎ تعديل الطلب</a><button class="btn danger" @onclick="CancelRequest">✕ إلغاء الطلب بالكامل</button>}</div></div>
<div class="info-grid panel"><div><label>رقم الطلب</label><b>@Request.RequestNumber</b></div><div><label>العميل</label><b>@Request.CustomerName</b></div><div><label>الجوال</label><b>@Request.Phone</b></div><div><label>الفرع</label><b>@Request.Branch</b></div><div><label>الحالة</label><span class="pill @(RequestStatus=="ملغى"?"red":RequestStatus=="مغلق"?"green":"yellow")">@RequestStatus</span></div></div>
<div class="panel"><div class="page-head"><h2>الأجهزة (@Request.Devices.Count)</h2></div><table><thead><tr><th>كود الجهاز</th><th>الموديل</th><th>شكوى العميل</th><th>صورة الجهاز</th><th>تشخيص الفني</th><th>الإجراء</th><th>مسار الصيانة</th><th>الفني</th><th>الموقع الحالي</th><th>الحالة</th><th>الإجراء</th><th>QR</th></tr></thead><tbody>@foreach(var d in Request.Devices){<tr><td><b>@d.DeviceCode</b></td><td>@d.Model</td><td>@(string.IsNullOrWhiteSpace(d.ComplaintDetails)?d.Problem:d.ComplaintDetails)</td><td>@if(!string.IsNullOrWhiteSpace(d.DeviceImagePath)){<a href="@d.DeviceImagePath" target="_blank"><img src="@d.DeviceImagePath" alt="صورة الجهاز" style="width:72px;height:72px;object-fit:cover;border-radius:8px;border:1px solid #d8e1ea" /></a>}else{<span class="small">—</span>}</td><td>@(string.IsNullOrWhiteSpace(d.FaultCause)?"—":d.FaultCause)</td><td>@(string.IsNullOrWhiteSpace(d.RepairAction)?"—":d.RepairAction)</td><td>@(string.IsNullOrWhiteSpace(d.MaintenanceRoute)?"—":d.MaintenanceRoute)</td><td>@(string.IsNullOrWhiteSpace(d.AssignedTechnicianName)?(string.IsNullOrWhiteSpace(d.MaintenanceTechnicianName)?"—":d.MaintenanceTechnicianName):d.AssignedTechnicianName)</td><td>@d.CurrentLocation</td><td><span class="pill @(DisplayStatus(d)=="مستبعد"?"red":DisplayStatus(d)=="تمت الصيانة محليًا"?"green":"blue")">@DisplayStatus(d)</span></td><td>@if(IsBranch&&d.CurrentStatus=="تمت الصيانة محليًا"&&!d.CustomerDeliveredAt.HasValue){<button class="btn green" @onclick="()=>DeliverLocal(d.Id)">✓ تسليم للعميل</button>}else{<span class="small">—</span>}</td><td><a class="btn outline" href="@($"/devices/{d.Id}/qr")">🖨 طباعة</a></td></tr>}</tbody></table></div>
@if(!string.IsNullOrWhiteSpace(Request.Notes)){<div class="panel"><b>ملاحظات:</b><p>@Request.Notes</p></div>}
}
@code{
[Parameter]public int RequestId{get;set;}ServiceRequest? Request;UserAccount? CurrentUser;bool IsBranch;bool IsIT;string RequestStatus=>RequestStatusHelper.Calculate(Request?.Devices);
bool CanPrepare=>Request is not null&&Request.Devices.Any(d=>d.CurrentLocation=="الفرع"&&!d.SentAt.HasValue&&!d.MaintenanceReceivedAt.HasValue&&string.IsNullOrWhiteSpace(d.DispatchBatchCode)&&d.Decision=="جاهز للإرسال");
bool CanCancel=>Request is not null&&Request.Devices.All(d=>d.CurrentLocation=="الفرع"&&!d.SentAt.HasValue&&!d.MaintenanceReceivedAt.HasValue&&string.IsNullOrWhiteSpace(d.DispatchBatchCode)&&d.AssignedTechnicianId==null&&d.CurrentStatus is not "جاري الصيانة محليًا");
protected override async Task OnParametersSetAsync(){var username=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db, username);IsBranch=CurrentUser?.Role=="مستخدم فرع";IsIT=CurrentUser?.Role is "مدير عام ARMS" or "مدير رئيسي";Request=await db.ServiceRequests.Include(x=>x.Devices).FirstOrDefaultAsync(x=>x.Id==RequestId);if(IsBranch&&Request is not null&&NormalizeBranch(Request.Branch)!=NormalizeBranch(CurrentUser!.Branch))Request=null;}
async Task CancelRequest(){if(!IsBranch||Request is null||!CanCancel)return;var ok=await JS.InvokeAsync<bool>("confirm",$"هل أنت متأكد من إلغاء الطلب {Request.RequestNumber} بالكامل؟");if(!ok)return;await using var db=await DbFactory.CreateDbContextAsync();var r=await db.ServiceRequests.Include(x=>x.Devices).FirstOrDefaultAsync(x=>x.Id==Request.Id);if(r is null)return;r.Status="ملغى";foreach(var d in r.Devices){d.Decision="ملغى";d.CurrentStatus="ملغى";d.CurrentLocation="الفرع";d.AssignedTechnicianId=null;d.AssignedTechnicianName="";}await db.SaveChangesAsync();Nav.NavigateTo($"/service-requests/{Request.Id}");}
async Task DeliverLocal(int id){if(!IsBranch||CurrentUser is null)return;await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.Include(x=>x.ServiceRequest).FirstOrDefaultAsync(x=>x.Id==id&&x.ServiceRequestId==RequestId);if(d is null||d.CurrentStatus!="تمت الصيانة محليًا"||d.CurrentLocation!="الفرع")return;d.CustomerDeliveredAt=DateTime.Now;d.CustomerDeliveredBy=CurrentUser.FullName;d.CurrentStatus="تم التسليم للعميل";d.CurrentLocation="الفرع";db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="تم التسليم للعميل",Location="الفرع",StartedAt=DateTime.Now,ChangedBy=CurrentUser.FullName,Notes="تسليم للعميل بعد الصيانة المحلية."});var r=await db.ServiceRequests.Include(x=>x.Devices).FirstOrDefaultAsync(x=>x.Id==RequestId);if(r is not null)r.Status=RequestStatusHelper.Calculate(r.Devices);await db.SaveChangesAsync();await OnParametersSetAsync();}
static string NormalizeBranch(string? value)=>(value??"").Trim().Replace("فرع ","").Replace("فرع","").Trim();
string DisplayStatus(ServiceDevice d){if(d.CurrentStatus=="تمت الصيانة محليًا")return "تمت الصيانة محليًا";if(d.CurrentStatus=="تعذر الصيانة المحلية")return "تعذر الصيانة المحلية";if(d.Decision=="مستبعد")return "مستبعد";if(d.Decision=="مستبدل")return "مستبدل";if(d.CustomerDeliveredAt.HasValue)return "تم التسليم للعميل";if(d.MaintenancePaused||d.CurrentStatus=="معلق")return "معلق";if(d.CurrentLocation=="في الطريق للصيانة"||d.CurrentLocation=="في الطريق للفرع")return "مع مندوب التوصيل";if(d.MaintenanceCompletedAt.HasValue)return "تمت الصيانة";if(d.MaintenanceStartedAt.HasValue)return "جاري الصيانة";if(d.MaintenanceReceivedAt.HasValue)return "انتظار";if(d.SentAt.HasValue)return "تم الإرسال";return d.CurrentStatus;}
}
