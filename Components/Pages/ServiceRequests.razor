@page "/service-requests"
@rendermode InteractiveServer
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
<PageTitle>طلبات الصيانة</PageTitle>
<div class="page-head"><div><h1>@(IsMaintenanceManager && !IsBranch && !IsTechnician ? "عرض الطلبات" : "طلبات الصيانة")</h1><p>بحث ومراجعة الطلبات حسب موقع الجهاز ومرحلة الدورة.</p></div>@if(IsBranch){<a class="btn primary" href="/service-requests/new">+ إنشاء طلب صيانة للعميل</a>}</div>
@if(IsBranch){<div class="panel"><div class="section-title">الشحن إلى المستودع</div><p class="small">إنشاء البوليصة وسند الإرسال يتم بواسطة مدير الصيانة. عند إنشائها ستظهر الأجهزة هنا في صفحة شحن أجهزة الصيانة لتأكيد التسليم فقط.</p><a class="btn outline" href="/branch/shipping">🚚 فتح بوالص الشحن</a></div>}
<div class="panel"><div class="filter-grid"><div class="field"><label>بحث</label><input @bind="Search" @bind:event="oninput" placeholder="رقم الطلب / كود الجهاز / العميل / الجوال" /></div><div class="field"><label>من تاريخ</label><input type="date" @bind="FromDate" /></div><div class="field"><label>إلى تاريخ</label><input type="date" @bind="ToDate" /></div><div class="field"><label>فرع المستخدم</label><input value="@Branch" readonly /></div><div class="field"><label>الحالة</label><select @bind="Status"><option value="">كل الحالات</option><option>جديد</option><option>في الطريق للصيانة</option><option>بانتظار بدء الصيانة</option><option>قيد الصيانة</option><option>قيد الصيانة محليًا</option><option>تمت الصيانة محليًا</option><option>جاهز للإرسال</option><option>معلق</option><option>مغلق</option><option>ملغى</option></select></div></div><div class="toolbar" style="margin-top:12px"><button class="btn primary" @onclick="Load">بحث / تطبيق الفلاتر</button><button class="btn outline" @onclick="Print">🖨 طباعة القائمة</button></div></div>
<div class="panel" id="service-requests-print"><img class="company-print-logo print-only" src="/images/company-logo.png" alt="الشركة"/><div class="print-only report-title">تقرير طلبات الصيانة</div><table><thead><tr>@if(IsBranch){<th class="no-print">تحديد</th>}<th>رقم الطلب</th><th>العميل</th><th>الجوال</th><th>الفرع</th><th>الأجهزة</th><th>أجهزة جاهزة للإرسال</th><th>الأولوية</th><th>الحالة</th><th>التاريخ</th><th>الإجراء</th></tr></thead><tbody>@foreach(var r in Items){var st=DisplayStatus(r);var ready=ReadyCount(r);<tr>@if(IsBranch){<td class="no-print"><input type="checkbox" checked="@SelectedIds.Contains(r.Id)" @onchange="e=>ToggleSelection(r.Id,(bool)e.Value!)" /></td>}<td>@r.RequestNumber</td><td>@r.CustomerName</td><td>@r.Phone</td><td>@r.Branch</td><td>@r.Devices.Count</td><td>@ready</td><td>@r.Priority</td><td><span class="pill @(st=="مغلق"?"green":st=="معلق"||st=="جاهز للإرسال"||st=="جاهز للإرسال للصيانة"?"yellow":st=="ملغى"?"red":"blue")">@st</span></td><td>@r.CreatedAt.ToString("yyyy-MM-dd")</td><td class="no-print"><a class="btn outline" href="/service-requests/@r.Id">فتح</a></td></tr>}</tbody></table></div>
@code {
 string Search="",Branch="الرياض",Status=""; bool IsBranch,IsTechnician; bool IsMaintenanceManager=>CurrentUser?.Role is "مشرف صيانة" or "مدير صيانة" or "مدير عام ARMS" or "مدير رئيسي"; bool IsIT=>ArmsAuth.IsSystemAdminRole(CurrentUser?.Role); UserAccount? CurrentUser; DateTime? FromDate,ToDate; List<ServiceRequest> Items=new(); HashSet<int> SelectedIds=new();
 protected override async Task OnInitializedAsync(){var username=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db, username);IsBranch=CurrentUser?.Role=="مستخدم فرع";IsTechnician=CurrentUser?.Role is "فني صيانة" or "فني متنقل";Branch=IsBranch?CurrentUser!.Branch:"الرياض";await Load();}
 async Task Load(){await using var db=await DbFactory.CreateDbContextAsync();var q=db.ServiceRequests.Include(x=>x.Devices).AsQueryable();if(!string.IsNullOrWhiteSpace(Search)){var s=Search.Trim();q=q.Where(x=>x.RequestNumber.Contains(s)||x.CustomerName.Contains(s)||x.Phone.Contains(s)||x.Devices.Any(d=>d.DeviceCode.Contains(s)||d.SerialNumber.Contains(s)));}if(IsBranch)q=q.Where(x=>x.Branch==Branch);if(IsTechnician)q=q.Where(x=>x.Devices.Any(d=>d.AssignedTechnicianId==CurrentUser!.Id));if(FromDate.HasValue)q=q.Where(x=>x.CreatedAt.Date>=FromDate.Value.Date);if(ToDate.HasValue)q=q.Where(x=>x.CreatedAt.Date<=ToDate.Value.Date);var list=await q.OrderByDescending(x=>x.Id).ToListAsync();Items=string.IsNullOrWhiteSpace(Status)?list:list.Where(x=>DisplayStatus(x)==Status).ToList();SelectedIds.IntersectWith(Items.Select(x=>x.Id));}
 int ReadyCount(ServiceRequest r)=>r.Devices.Count(d=>d.CurrentLocation=="الفرع"&&!d.SentAt.HasValue&&!d.MaintenanceReceivedAt.HasValue&&(d.Decision=="جاهز للإرسال"||d.CurrentStatus=="تعذر الصيانة المحلية")&&d.Decision!="مستبعد"&&d.Decision!="مستبدل"&&d.Decision!="مهلك");
 void ToggleSelection(int id,bool on){if(on)SelectedIds.Add(id);else SelectedIds.Remove(id);} void ClearSelection()=>SelectedIds.Clear();
 void OpenBulkDispatch(){if(SelectedIds.Count==0)return;var ids=string.Join(",",SelectedIds);Nav.NavigateTo($"/service-requests/bulk-dispatch?ids={Uri.EscapeDataString(ids)}");}
 string DisplayStatus(ServiceRequest r)=>RequestStatusHelper.Calculate(r.Devices); async Task Print()=>await JS.InvokeVoidAsync("window.print");
}
