@page "/settings"
@rendermode InteractiveServer
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
<PageTitle>الإعدادات</PageTitle>
<div class="page-head"><div><h1>الإعدادات</h1><p>إعدادات الحساب والمظهر ومعلومات النظام.</p></div></div>
@if(CurrentAccount is not null){
<div class="panel"><div class="section-title">بيانات الحساب</div><div class="form-grid"><div class="field"><label>اسم المستخدم</label><input value="@CurrentAccount.Username" readonly /></div><div class="field"><label>الاسم</label><input value="@CurrentAccount.FullName" readonly /></div><div class="field"><label>البريد الإلكتروني</label><input value="@CurrentAccount.Email" readonly /></div><div class="field"><label>رقم الجوال</label><input value="@CurrentAccount.Phone" readonly /></div><div class="field"><label>الفرع</label><input value="@CurrentAccount.Branch" readonly /></div><div class="field"><label>الدور</label><input value="@CurrentAccount.Role" readonly /></div></div><div class="actions-bottom"><a class="btn primary" href="/account">👤 إدارة حسابي وتغيير كلمة المرور</a></div></div>
<div class="panel"><div class="section-title">المظهر</div><div class="theme-switch"><button class="theme-choice @(Theme=="light"?"active":"")" @onclick='() => SetTheme("light")'>☀️ الوضع الفاتح</button><button class="theme-choice @(Theme=="dark"?"active":"")" @onclick='() => SetTheme("dark")'>🌙 الوضع الداكن</button><button class="theme-choice @(Theme=="system"?"active":"")" @onclick='() => SetTheme("system")'>🖥️ حسب الجهاز</button></div></div>
@if(IsMainManager){<div class="panel"><div class="section-title">إدارة النظام</div><p class="small">هذه الخيارات متاحة للمدير الرئيسي فقط.</p><div class="actions"><a class="btn primary" href="/admin">👥 فتح إدارة الفروع والمستخدمين</a><a class="btn outline" href="/device-catalog">▣ إدارة الأجهزة والملحقات</a></div></div>}
<div class="panel"><div class="section-title">بيانات الفرع</div><div class="form-grid"><div class="field"><label>اسم الفرع</label><input value="@CurrentAccount.Branch" readonly /></div><div class="field"><label>المدينة</label><input value="@BranchCity" readonly /></div><div class="field"><label>حساب الفرع</label><input value="حساب فرع واحد" readonly /></div></div><p class="small">لا يمكن لمستخدم الفرع تغيير الفرع. تغيير الفرع الافتراضي وإدارة ربط الفروع تتم من حساب المدير الرئيسي فقط.</p></div>
<div class="panel"><div class="section-title">معلومات النظام</div><div class="form-grid"><div class="field"><label>اسم النظام</label><input value="ARMS" readonly /></div><div class="field"><label>الإصدار</label><input value="V2.4.3" readonly /></div><div class="field"><label>نوع الحساب</label><input value="@CurrentAccount.Role" readonly /></div><div class="field"><label>حالة النظام</label><input value="تشغيلي" readonly /></div><div class="field full"><label>ملاحظات النسخة</label><textarea readonly>نسخة تشغيلية تشمل الاستلام وطلبات الصيانة والأجهزة والاعتماد والإرسال والتقارير والإشعارات وحساب المستخدم.</textarea></div></div></div>}
@if(!string.IsNullOrWhiteSpace(Message)){<div class="notice success-notice">@Message</div>}
@code{UserAccount? CurrentAccount;string Theme="light",BranchCity="الرياض",Message="";bool IsMainManager=>ArmsAuth.IsSystemAdminRole(CurrentAccount?.Role);protected override async Task OnInitializedAsync(){var username=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentAccount=await ArmsAuth.ResolveUserAsync(db, username);Theme=CurrentAccount?.Theme??"light";if(CurrentAccount is not null){var branch=await db.Branches.FirstOrDefaultAsync(x=>x.Name.Contains(CurrentAccount.Branch));BranchCity=branch?.City??CurrentAccount.Branch;}}async Task SetTheme(string theme){Theme=theme;await JS.InvokeVoidAsync("armsTheme.set",theme);if(CurrentAccount is not null){await using var db=await DbFactory.CreateDbContextAsync();var u=await db.UserAccounts.FindAsync(CurrentAccount.Id);if(u is not null){u.Theme=theme;await db.SaveChangesAsync();}}Message="تم حفظ المظهر.";}}
