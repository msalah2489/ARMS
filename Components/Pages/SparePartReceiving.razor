@page "/spare-parts/receiving"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
<PageTitle>استلام قطع الغيار</PageTitle>
@if(CurrentUser is null){<div class="empty">جارٍ تحميل الحساب...</div>}else if(!(CurrentUser.Role is "مدير رئيسي" or "مدير عام ARMS" or "مشرف صيانة" or "مدير صيانة")){<div class="notice danger-notice">هذه الصفحة متاحة لمشرف الصيانة ومدير الصيانة ومدير النظام.</div>}else{
<div class="page-head"><div><h1>سند استلام قطع الغيار</h1><p>زيادة المخزون لا تتم إلا من خلال سند موثق برقم وصورة.</p></div><a class="btn outline" href="/spare-parts">← المخزون</a></div>
@if(!string.IsNullOrWhiteSpace(Message)){<div class="notice @(Message.StartsWith("خطأ")?"danger-notice":"success-notice")">@Message</div>}
<div class="panel"><div class="form-grid"><div class="field"><label>رقم السند *</label><input @bind="ReferenceNumber" /></div><div class="field"><label>تاريخ الاستلام *</label><input type="datetime-local" @bind="MovementDate" /></div><div class="field"><label>المورد / الجهة</label><input @bind="Supplier" /></div><div class="field"><label>صورة السند *</label><InputFile OnChange="OnFile" accept="image/*" /></div></div></div>
<div class="panel"><div class="page-head"><div class="section-title">القطع المستلمة</div><button class="btn primary" @onclick="AddRow">+ إضافة قطعة</button></div><table><thead><tr><th>قطعة الغيار</th><th>الكود</th><th>الكمية</th><th></th></tr></thead><tbody>@foreach(var r in Rows){<tr><td><select @bind="r.PartId"><option value="0">اختر القطعة</option>@foreach(var p in Parts){<option value="@p.Id">@p.Name</option>}</select></td><td>@Parts.FirstOrDefault(x=>x.Id==r.PartId)?.Code</td><td><input type="number" min="1" @bind="r.Quantity" /></td><td><button class="btn small danger" @onclick="()=>Rows.Remove(r)">حذف</button></td></tr>}</tbody></table><div class="actions-bottom"><button class="btn green" @onclick="Save">حفظ سند الاستلام</button></div></div>}
@code{
UserAccount? CurrentUser;List<SparePart> Parts=new();List<ReceiveRow> Rows=new(){new()};string ReferenceNumber="",Supplier="",Message="";DateTime MovementDate=DateTime.Now;IBrowserFile? File;
protected override async Task OnInitializedAsync(){var u=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db, u);Parts=await db.SpareParts.Where(x=>x.IsActive).OrderBy(x=>x.Name).ToListAsync();}
void AddRow()=>Rows.Add(new ReceiveRow());void OnFile(InputFileChangeEventArgs e)=>File=e.File;
async Task Save(){Message="";if(string.IsNullOrWhiteSpace(ReferenceNumber)||File is null||Rows.All(x=>x.PartId==0||x.Quantity<=0)){Message="خطأ: رقم السند وصورته وقطعة واحدة صحيحة على الأقل مطلوبة.";return;}var uploadError=UploadGuard.Validate(File);if(uploadError is not null){Message=uploadError;return;}var dir=Path.Combine(Env.WebRootPath,"uploads","spare-receipts");Directory.CreateDirectory(dir);var path=Path.Combine(dir,$"{Guid.NewGuid()}{UploadGuard.SafeExtension(File)}");await using(var fs=System.IO.File.Create(path)){await File.OpenReadStream(UploadGuard.MaxFileSizeBytes).CopyToAsync(fs);}await using var db=await DbFactory.CreateDbContextAsync();var img="/uploads/spare-receipts/"+Path.GetFileName(path);foreach(var row in Rows.Where(x=>x.PartId>0&&x.Quantity>0)){var part=await db.SpareParts.FindAsync(row.PartId);if(part is null)continue;part.StockQuantity+=row.Quantity;db.SparePartMovements.Add(new SparePartMovement{SparePartId=part.Id,MovementType="استلام",Quantity=row.Quantity,MovementDate=MovementDate,ReferenceNumber=ReferenceNumber.Trim(),ReferenceImagePath=img,Location="فرع الصيانة",Notes=Supplier.Trim()});}await db.SaveChangesAsync();Message="تم حفظ سند الاستلام وزيادة المخزون.";ReferenceNumber="";Supplier="";File=null;Rows=new(){new()};}
class ReceiveRow{public int PartId{get;set;}public int Quantity{get;set;}=1;}
}
