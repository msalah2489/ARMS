@page "/spare-parts"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
<PageTitle>قطع الغيار والمخزون</PageTitle>
@if(CurrentUser is null){<div class="empty">جارٍ تحميل الحساب...</div>}else if(!ArmsAuth.IsSystemAdminRole(CurrentUser.Role)){<div class="notice danger-notice">هذه الصفحة متاحة لمدير النظام (مدير IT) فقط.</div>}else{
<div class="page-head"><div><h1>قطع الغيار والمخزون</h1><p>إدارة القطع، الاستلام، الرصيد وحركة الاستهلاك.</p></div></div>
@if(!string.IsNullOrWhiteSpace(Message)){<div class="notice @(Message.StartsWith("خطأ")?"danger-notice":"success-notice")">@Message</div>}
<div class="panel"><div class="page-head"><h2>فلترة المخزون</h2><button class="btn primary" @onclick="NewPart">+ إضافة قطعة غيار</button></div><div class="filter-grid"><div class="field"><label>قطع الغيار</label><select @bind="PartFilter"><option value="">كل القطع</option>@foreach(var p in Parts.OrderBy(x=>x.Name)){<option value="@p.Id">@p.Name @(string.IsNullOrWhiteSpace(p.Code)?"":"— "+p.Code)</option>}</select></div><div class="field"><label>الأجهزة / الموديلات</label><select @bind="ModelFilter"><option value="">كل الأجهزة</option>@foreach(var m in Models.OrderBy(x=>x.Name)){<option value="@m.Name">@m.Name</option>}</select></div><div class="field"><label>الحالة</label><select @bind="ActiveFilter"><option value="">الكل</option><option value="true">نشط</option><option value="false">موقوف</option></select></div></div></div>
@if(Editor is not null){<div class="panel"><div class="section-title">إضافة / تعديل قطعة غيار</div><div class="form-grid"><div class="field"><label>اسم القطعة *</label><input @bind="Editor.Name" /></div><div class="field"><label>كود القطعة</label><input @bind="Editor.Code" /></div><div class="field"><label>اللون (اختياري)</label><input @bind="Editor.Color" /></div><div class="field"><label>الموديل المرتبط</label><select @bind="Editor.CompatibleDeviceModel"><option value="">كل الأجهزة</option>@foreach(var m in Models.Where(x=>x.IsActive).OrderBy(x=>x.Name)){<option value="@m.Name">@m.Name</option>}</select></div><div class="field"><label>الرصيد</label><input type="number" min="0" @bind="Editor.StockQuantity" /></div><div class="field"><label>الحالة</label><select value="@(Editor.IsActive?"true":"false")" @onchange="SetActive"><option value="true">نشط</option><option value="false">موقوف</option></select></div></div><div class="actions-bottom"><button class="btn green" @onclick="Save">حفظ</button><button class="btn gray" @onclick="()=>Editor=null">إلغاء</button></div></div>}
<div class="panel"><div class="section-title">المخزون</div><div class="table-wrap"><table><thead><tr><th @onclick="SortName">القطعة @SortIcon("Name")</th><th @onclick="SortCode">الكود @SortIcon("Code")</th><th @onclick="SortColor">اللون @SortIcon("Color")</th><th @onclick="SortModel">الجهاز / الموديل @SortIcon("Model")</th><th @onclick="SortStock">الرصيد @SortIcon("Stock")</th><th @onclick="SortActive">الحالة @SortIcon("Active")</th><th>الإجراء</th></tr></thead><tbody>@foreach(var p in FilteredParts){<tr><td><b>@p.Name</b></td><td>@(string.IsNullOrWhiteSpace(p.Code)?"—":p.Code)</td><td>@(string.IsNullOrWhiteSpace(p.Color)?"—":p.Color)</td><td>@(string.IsNullOrWhiteSpace(p.CompatibleDeviceModel)?"كل الأجهزة":p.CompatibleDeviceModel)</td><td>@p.StockQuantity</td><td>@(p.IsActive?"نشط":"موقوف")</td><td><button class="btn small" @onclick="()=>Edit(p)">تعديل</button> <button class="btn small" @onclick="()=>Toggle(p)">@(p.IsActive?"إيقاف":"تفعيل")</button></td></tr>}</tbody></table></div></div>
<div class="panel"><div class="page-head"><div class="section-title">استلام قطع غيار</div><a class="btn outline" href="/spare-parts/receiving">📥 تسجيل سند استلام</a></div><p class="small">كل زيادة في المخزون يجب أن تكون مرتبطة بسند استلام ورقم وصورة.</p></div>
}
@code{
UserAccount? CurrentUser; List<SparePart> Parts=new(); List<DeviceModel> Models=new(); SparePart? Editor; string Message="",PartFilter="",ModelFilter="",ActiveFilter="",SortColumn="Name"; bool SortAsc=true;
IEnumerable<SparePart> FilteredParts{get{IEnumerable<SparePart> q=Parts;if(int.TryParse(PartFilter,out var id))q=q.Where(x=>x.Id==id);if(!string.IsNullOrWhiteSpace(ModelFilter))q=q.Where(x=>string.IsNullOrWhiteSpace(x.CompatibleDeviceModel)||x.CompatibleDeviceModel==ModelFilter);if(ActiveFilter=="true")q=q.Where(x=>x.IsActive);if(ActiveFilter=="false")q=q.Where(x=>!x.IsActive);return SortColumn switch{"Code"=>(SortAsc?q.OrderBy(x=>x.Code):q.OrderByDescending(x=>x.Code)),"Color"=>(SortAsc?q.OrderBy(x=>x.Color):q.OrderByDescending(x=>x.Color)),"Model"=>(SortAsc?q.OrderBy(x=>x.CompatibleDeviceModel):q.OrderByDescending(x=>x.CompatibleDeviceModel)),"Stock"=>(SortAsc?q.OrderBy(x=>x.StockQuantity):q.OrderByDescending(x=>x.StockQuantity)),"Active"=>(SortAsc?q.OrderBy(x=>x.IsActive):q.OrderByDescending(x=>x.IsActive)),_=>(SortAsc?q.OrderBy(x=>x.Name):q.OrderByDescending(x=>x.Name))};}}
protected override async Task OnAfterRenderAsync(bool first){if(!first)return;var u=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db, u);await Load();await InvokeAsync(StateHasChanged);}
async Task Load(){await using var db=await DbFactory.CreateDbContextAsync();Parts=await db.SpareParts.ToListAsync();Models=await db.DeviceModels.ToListAsync();}
void SortBy(string c){if(SortColumn==c)SortAsc=!SortAsc;else{SortColumn=c;SortAsc=true;}}
void SortName()=>SortBy("Name"); void SortCode()=>SortBy("Code"); void SortColor()=>SortBy("Color"); void SortModel()=>SortBy("Model"); void SortStock()=>SortBy("Stock"); void SortActive()=>SortBy("Active");
string SortIcon(string c)=>SortColumn==c?(SortAsc?"↑":"↓"):"↕";
void NewPart()=>Editor=new SparePart{IsActive=true};void Edit(SparePart p)=>Editor=new SparePart{Id=p.Id,Name=p.Name,Code=p.Code,Color=p.Color,CompatibleDeviceModel=p.CompatibleDeviceModel,StockQuantity=p.StockQuantity,IsActive=p.IsActive};void SetActive(ChangeEventArgs e){if(Editor is not null)Editor.IsActive=e.Value?.ToString()=="true";}
async Task Save(){if(Editor is null)return;Editor.Name=Editor.Name.Trim();Editor.Code=Editor.Code.Trim();Editor.Color=Editor.Color.Trim();Editor.CompatibleDeviceModel=Editor.CompatibleDeviceModel.Trim();if(string.IsNullOrWhiteSpace(Editor.Name)){Message="خطأ: اسم القطعة إجباري.";return;}if(Editor.StockQuantity<0){Message="خطأ: الرصيد لا يمكن أن يكون سالبًا.";return;}await using var db=await DbFactory.CreateDbContextAsync();if(Editor.Id==0)db.SpareParts.Add(Editor);else{var x=await db.SpareParts.FindAsync(Editor.Id);if(x is null)return;x.Name=Editor.Name;x.Code=Editor.Code;x.Color=Editor.Color;x.CompatibleDeviceModel=Editor.CompatibleDeviceModel;x.StockQuantity=Editor.StockQuantity;x.IsActive=Editor.IsActive;}await db.SaveChangesAsync();Editor=null;Message="تم حفظ قطعة الغيار.";await Load();}
async Task Toggle(SparePart p){await using var db=await DbFactory.CreateDbContextAsync();var x=await db.SpareParts.FindAsync(p.Id);if(x is null)return;x.IsActive=!x.IsActive;await db.SaveChangesAsync();Message="تم تحديث حالة القطعة.";await Load();}
}
