@page "/technician"
@rendermode InteractiveServer
@using System.Text.Json
@inject IDbContextFactory<ArmsDbContext> DbFactory
@inject IJSRuntime JS
<PageTitle>عمل الفني</PageTitle>

<div class="page-head"><div><h1>@(IsMobileTechnician ? "مساحة عمل الفني المتنقل" : "مساحة عمل الفني")</h1><p>@(IsMobileTechnician ? "تنفيذ الصيانة داخل الفروع مع بقاء الجهاز في موقعه." : "استلام الجهاز، تحديد حالته، الصيانة والاختبارات ثم إنهاء العملية.")</p></div></div>
@if(CurrentUser is null){<div class="empty">جارٍ تحميل الحساب...</div>}else{
<div class="stats">@if(!IsMobileTechnician){<div class="stat"><span>بانتظار الصيانة</span><b>@Available.Count</b></div>}<div class="stat"><span>أجهزتي الحالية</span><b>@Mine.Count</b></div><div class="stat"><span>اختبارات مطلوبة</span><b>@TestsPending</b></div></div>

@if(!IsMobileTechnician){<div class="panel"><div class="section-title">أجهزة بانتظار الصيانة</div>
@if(Mine.Any()){<div class="notice info-notice">لديك جهاز قيد العمل حاليًا. الأجهزة الأخرى تظل متاحة لباقي الفنيين.</div>}else if(!Available.Any()){<div class="empty">لا توجد أجهزة متاحة حاليًا.</div>}else{
<table><thead><tr><th>الجهاز</th><th>الموديل</th><th>السيريال</th><th>الطلب</th><th>شكوى العميل</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody>
@foreach(var d in Available){<tr><td><b>@d.DeviceCode</b>@if(d.ServiceRequest?.Priority=="عاجل"){<span class="urgent-badge">عاجل</span>} @if(IsLate(d)){<span class="urgent-badge late-badge">متأخر</span>}</td><td>@d.Model</td><td>@d.SerialNumber</td><td>@d.ServiceRequest?.RequestNumber</td><td>@(string.IsNullOrWhiteSpace(d.ComplaintDetails)?d.Problem:d.ComplaintDetails)</td><td><span class="pill yellow">انتظار</span></td><td><button class="btn primary" @onclick="()=>OpenReceive(d.Id)">استلام الجهاز</button></td></tr>}
</tbody></table>}}
</div>}

<div class="panel"><div class="section-title">أجهزتي الحالية</div>
@if(!Mine.Any()){<div class="empty">لا توجد أجهزة تعمل عليها حاليًا.</div>}else foreach(var d in Mine){var tests=GetTests(d);<div class="tech-device">
<div class="tech-device-head"><div><b>@d.DeviceCode</b><span class="small"> @d.Model — @d.SerialNumber</span><div class="notice info-notice" style="margin-top:8px">🗣️ <b>شكوى العميل:</b> @(string.IsNullOrWhiteSpace(d.ComplaintDetails)?d.Problem:d.ComplaintDetails)</div></div><span class="pill yellow">@d.CurrentStatus</span> @if(IsLate(d)){<span class="urgent-badge late-badge">متأخر</span>}</div>
@if(IsMobileTechnician && d.CurrentStatus=="جاهز للصيانة"){<div class="actions-bottom"><button class="btn primary" @onclick="()=>AcceptLocalTask(d.Id)">✓ استلام وبدء الصيانة</button></div>}@if(d.MaintenanceRoute=="صيانة محلية"){<div class="notice info-notice">📍 الموقع الحالي: <b>@d.ServiceRequest?.Branch</b> — الجهاز يظل في الفرع أثناء الصيانة المحلية.</div>}
@if(d.TechnicianExternalCondition=="به تلفيات"){<div class="notice">تلفيات عند الاستلام: @d.TechnicianDamageTypes</div>}
@if(d.TechnicianDecision=="يعمل بدون مشكلة"){
<div class="notice">تم تسجيل أن الجهاز يعمل بدون مشكلة. يجب إتمام اختبارات التحقق قبل الإنهاء.</div>
}
@if(d.TechnicianDecision=="بدء الصيانة"){
<div class="notice">الصيانة جارية. بعد الإصلاح أكمل اختبارات الإنهاء ثم بيانات الإصلاح.</div>
}
<div class="test-grid"><div class="section-title">اختبارات إنهاء الصيانة</div>
@foreach(var t in tests){<div class="test-row"><div><b>@t.Name</b><div class="small">اختبار إلزامي</div></div><div>
@if(t.StartedAt is null){<button class="btn outline" @onclick="()=>StartTest(d.Id,t.Name)">بدء الاختبار</button>}
else if(t.CompletedAt is null){<button class="btn green" @onclick="()=>SetTestResult(d.Id,t.Name,true)">✓ يعمل</button><button class="btn danger" style="margin-right:6px" @onclick="()=>SetTestResult(d.Id,t.Name,false)">✕ لا يعمل</button>}
else{<button class="btn @(t.Works==true?"green":"danger")" @onclick="()=>ResetTest(d.Id,t.Name)">@(t.Works==true?"✓ يعمل":"✕ لا يعمل")</button><span class="small" style="margin-right:8px">اضغط لتعديل النتيجة</span>}
</div></div>}
</div>
@if(tests.All(x=>x.CompletedAt.HasValue)){
<div class="panel" style="margin-top:14px"><div class="section-title">بيانات إنهاء العملية</div>
@if(d.TechnicianDecision=="بدء الصيانة"){
<div class="notice info-notice">الحقول بعلامة * إلزامية عند اختيار «بدء الصيانة».</div>
<div class="form-grid"><div><label>سبب العطل *</label><input @bind="d.FaultCause" /></div><div><label>الإجراء الذي تم *</label><input @bind="d.RepairAction" /></div></div>
<div style="margin-top:10px"><label>قطع الغيار المستخدمة (اختياري)</label><div><label><input type="checkbox" checked="@(d.ConsumedParts=="لم يتم استخدام قطع غيار")" @onchange="e=>SetNoParts(d,(bool)e.Value!)" /> لم يتم استخدام قطع غيار</label></div>@if(d.ConsumedParts!="لم يتم استخدام قطع غيار"){var partsForDevice=GetPartsForDevice(d);if(partsForDevice.Any()){@foreach(var part in partsForDevice){<div class="field-row" style="margin-top:8px"><div><b>@part.Name</b>@if(!string.IsNullOrWhiteSpace(part.Color)){<span class="small"> — @part.Color</span>}<div class="small">الرصيد: @part.StockQuantity</div></div><input type="number" min="0" max="@part.StockQuantity" value="@GetPartQty(d.Id,part.Id)" @onchange="e=>SetPartQty(d.Id,part.Id,e.Value?.ToString())" style="max-width:120px" /></div>}}else{<div class="small">لا توجد قطع غيار نشطة مرتبطة بهذا الجهاز أو متاحة بالمخزون.</div>}}</div>
}
@if(GetAccessories(d).Any()){
<div style="margin-top:10px"><label>الملحقات التي تم إرجاعها مع الجهاز</label><div class="check-grid">@foreach(var a in GetAccessories(d)){<div><label><input type="checkbox" checked="@HasReturnedAccessory(d,a)" @onchange="e=>ToggleReturnedAccessory(d,a,(bool)e.Value!)" /> @a</label>@if(!HasReturnedAccessory(d,a)){<input style="margin-top:6px" placeholder="سبب عدم إرجاع الملحق — إلزامي" value="@GetAccessoryReason(d,a)" @oninput="e=>SetAccessoryReason(d,a,e.Value?.ToString() ?? string.Empty)" />}</div>}</div></div>}
<div style="margin-top:10px"><label>النتيجة النهائية *</label><select @bind="d.MaintenanceResult"><option value="">-- اختر النتيجة --</option><option>تم الإصلاح — الجهاز يعمل</option><option>لم يحتج صيانة — يعمل</option><option>ما زالت المشكلة قائمة</option><option>غير قابل للإصلاح</option></select></div>
@{
var canComplete = CanComplete(d, tests);
}
<div class="actions-bottom">
<button class="btn @(canComplete ? "green" : "outline")" disabled="@(!canComplete)" title="@(canComplete ? "يمكن إنهاء العملية" : "أكمل الاختبارات المطلوبة واختر النتيجة النهائية والبيانات الإلزامية")" aria-disabled="@(!canComplete)" @onclick="()=>CompleteMaintenance(d)">✓ إنهاء العملية</button>
@if(d.MaintenanceRoute=="صيانة محلية"){<button class="btn danger" @onclick="()=>OpenLocalFailure(d.Id)">⚠️ تعذر الصيانة المحلية — إرسال للصيانة</button>}else{<button class="btn danger" @onclick="()=>OpenPause(d.Id)">تعليق الصيانة</button>}
</div>
</div>}
else{<div class="actions-bottom">@if(d.MaintenanceRoute=="صيانة محلية"){<button class="btn danger" @onclick="()=>OpenLocalFailure(d.Id)">⚠️ تعذر الصيانة المحلية — إرسال للصيانة</button>}else{<button class="btn danger" @onclick="()=>OpenPause(d.Id)">تعليق الصيانة</button>}</div>}
</div>}
</div>
}
@if(Message!=""){<div class="notice @(Message.StartsWith("خطأ")?"danger-notice":"success-notice")">@Message</div>}}

@if(ReceiveDevice is not null){
<div class="modal-backdrop"><div class="modal"><h2>استلام الجهاز</h2><p><b>@ReceiveDevice.DeviceCode</b> — @ReceiveDevice.Model</p><div class="notice info-notice"><b>شكوى العميل:</b> @(string.IsNullOrWhiteSpace(ReceiveDevice.ComplaintDetails)?ReceiveDevice.Problem:ReceiveDevice.ComplaintDetails)</div>
<label>الحالة الخارجية — إجباري</label><select @bind="ReceiveCondition"><option value="">-- اختر --</option><option>سليم</option><option>به تلفيات</option></select>
@if(ReceiveCondition=="به تلفيات"){
<label style="margin-top:10px">نوع التلفيات — يمكن اختيار أكثر من نوع</label>
<div class="check-grid">@foreach(var x in DamageOptions){<label><input type="checkbox" checked="@SelectedDamage.Contains(x)" @onchange="e=>ToggleDamage(x,(bool)e.Value!)" /> @x</label>}</div>
<label style="margin-top:10px">ملاحظة التلفيات</label><textarea @bind="DamageNotes"></textarea>}
<label style="margin-top:10px">حالة الجهاز — إجباري</label><select @bind="ReceiveDecision"><option value="">-- اختر --</option><option>يعمل بدون مشكلة</option><option>بدء الصيانة</option></select>
<div class="actions-bottom"><button class="btn primary" @onclick="ConfirmReceive">متابعة</button><button class="btn outline" @onclick="CloseReceive">إلغاء</button></div></div></div>}

@if(LocalFailureDeviceId is not null){
<div class="modal-backdrop"><div class="modal"><h2>تعذر الصيانة المحلية</h2><p>سيبقى الجهاز في الفرع، وسيصبح متاحًا لمستخدم الفرع لإرساله إلى مركز الصيانة.</p>
<label>سبب تعذر الصيانة المحلية *</label><textarea @bind="LocalFailureReason" placeholder="مثال: يحتاج أدوات متخصصة أو قطعة غير متوفرة"></textarea>
<div class="actions-bottom"><button class="btn danger" @onclick="ConfirmLocalFailure">تأكيد وإعادة الجهاز للفرع</button><button class="btn outline" @onclick="CloseLocalFailure">إلغاء</button></div></div></div>}

@if(PauseDeviceId is not null){
<div class="modal-backdrop"><div class="modal"><h2>تعليق الصيانة</h2><p>اختر سبب التعليق، ويمكن للمشرف لاحقًا إعادة الجهاز للفني لاستكمال الصيانة.</p>
<label>سبب التعليق — إجباري</label><select @bind="PauseReason"><option value="">-- اختر السبب --</option><option>عدم توفر قطع غيار</option><option>تحويل للمشرف</option><option>يحتاج إعادة فحص</option><option>يحتاج موافقة المدير</option><option>عطل غير قابل للإصلاح</option><option>مراجعة خدمة العملاء</option><option>سبب آخر</option></select>
@if(PauseReason=="سبب آخر"){<label style="margin-top:10px">تفاصيل السبب — إجباري</label><textarea @bind="PauseNotes"></textarea>}
<div class="actions-bottom"><button class="btn danger" @onclick="ConfirmPause">تأكيد التعليق</button><button class="btn outline" @onclick="ClosePause">إلغاء</button></div></div></div>}

@code {
UserAccount? CurrentUser; List<ServiceDevice> Available=new(),Mine=new(); List<SparePart> SpareParts=new(); Dictionary<int,Dictionary<int,int>> PartSelections=new(); int TestsPending; string Message="";
ServiceDevice? ReceiveDevice; string ReceiveCondition="",ReceiveDecision="",DamageNotes=""; HashSet<string> SelectedDamage=new(); int? PauseDeviceId; string PauseReason="",PauseNotes=""; int? LocalFailureDeviceId; string LocalFailureReason=""; bool IsMobileTechnician => CurrentUser?.Role=="فني متنقل";
Dictionary<int,HashSet<string>> ReturnedSelections=new();
string[] DamageOptions={"كسر","تسريب","خدوش/ضربات","جزء مفقود","تلف الكابل/الفيشة","تلف الشاشة/الهيكل","أخرى"};
static bool IsLate(ServiceDevice d)=>d.MaintenanceStartedAt.HasValue && !d.MaintenanceCompletedAt.HasValue && DateTime.Now-d.MaintenanceStartedAt.Value>=TimeSpan.FromHours(24);
protected override async Task OnInitializedAsync(){var username=await JS.InvokeAsync<string>("armsTheme.getUser");await using var db=await DbFactory.CreateDbContextAsync();CurrentUser=await ArmsAuth.ResolveUserAsync(db, username);await Load();}
async Task Load(){if(CurrentUser is null)return;await using var db=await DbFactory.CreateDbContextAsync();SpareParts=await db.SpareParts.Where(x=>x.IsActive).OrderBy(x=>x.Name).ThenBy(x=>x.Color).ToListAsync();IQueryable<ServiceDevice> mineQ=db.ServiceDevices.Include(x=>x.ServiceRequest).Where(x=>x.AssignedTechnicianId==CurrentUser.Id&&(x.CurrentStatus=="جاري الصيانة"||x.CurrentStatus=="فحص بدون صيانة"||x.CurrentStatus=="جاري الصيانة محليًا"||x.CurrentStatus=="جاهز للصيانة"));if(IsMobileTechnician)mineQ=mineQ.Where(x=>x.MaintenanceRoute=="صيانة محلية"&&x.CurrentLocation==x.ServiceRequest!.Branch);else mineQ=mineQ.Where(x=>x.MaintenanceRoute!="صيانة محلية");Mine=await mineQ.OrderBy(x=>x.TechnicianReceivedAt).ToListAsync();
if(IsMobileTechnician||Mine.Any()) Available=new();
else {
 var waiting=db.ServiceDevices.Include(x=>x.ServiceRequest).Where(x=>x.CurrentLocation=="مركز الصيانة"&&x.CurrentStatus=="انتظار"&&x.AssignedTechnicianId==null&&x.Decision!="مستبعد");
 var urgentWaiting=await waiting.Where(x=>x.ServiceRequest!=null&&x.ServiceRequest.Priority=="عاجل").OrderBy(x=>x.Id).ToListAsync();
 Available=urgentWaiting.Any()?urgentWaiting:await waiting.OrderBy(x=>x.Id).ToListAsync();
}
TestsPending=Mine.Sum(x=>GetTests(x).Count(t=>!t.CompletedAt.HasValue));}
void OpenReceive(int id){ReceiveDevice=Available.FirstOrDefault(x=>x.Id==id);ReceiveCondition="";ReceiveDecision="";DamageNotes="";SelectedDamage.Clear();}
void CloseReceive(){ReceiveDevice=null;}
void ToggleDamage(string x,bool on){if(on)SelectedDamage.Add(x);else SelectedDamage.Remove(x);}
async Task ConfirmReceive(){if(ReceiveDevice is null||CurrentUser is null)return;if(string.IsNullOrWhiteSpace(ReceiveCondition)||string.IsNullOrWhiteSpace(ReceiveDecision)){Message="خطأ: يجب اختيار حالة الجهاز وقرار الفني.";return;}if(ReceiveCondition=="به تلفيات"&&!SelectedDamage.Any()){Message="خطأ: يجب تحديد نوع التلفيات.";return;}await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.FirstOrDefaultAsync(x=>x.Id==ReceiveDevice.Id&&x.CurrentStatus=="انتظار"&&x.AssignedTechnicianId==null);if(d is null){Message="خطأ: الجهاز لم يعد متاحًا.";ReceiveDevice=null;await Load();return;}d.TechnicianReceivedAt=DateTime.Now;d.TechnicianExternalCondition=ReceiveCondition;d.TechnicianDamageTypes=ReceiveCondition=="به تلفيات"?string.Join("، ",SelectedDamage)+(string.IsNullOrWhiteSpace(DamageNotes)?"":" — "+DamageNotes):"";d.TechnicianDecision=ReceiveDecision;d.AssignedTechnicianId=CurrentUser.Id;d.AssignedTechnicianName=CurrentUser.FullName;d.MaintenanceTechnicianName=CurrentUser.FullName;d.MaintenanceTestsJson=JsonSerializer.Serialize(Defaults(d.Model));if(ReceiveDecision=="بدء الصيانة"){d.MaintenanceStartedAt=DateTime.Now;d.CurrentStatus="جاري الصيانة";}else d.CurrentStatus="فحص بدون صيانة";db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status=d.CurrentStatus,Location="مركز الصيانة",StartedAt=DateTime.Now,ChangedBy=CurrentUser.FullName,Notes=$"استلام الفني: {ReceiveCondition}; القرار: {ReceiveDecision}"});await db.SaveChangesAsync();ReceiveDevice=null;Message="تم استلام الجهاز وتسجيل حالته.";await Load();}
List<string> GetAccessories(ServiceDevice d)=>d.Accessories.Split(';',StringSplitOptions.RemoveEmptyEntries).Select(x=>x.Trim()).Where(x=>!string.IsNullOrWhiteSpace(x)&&x!="الجهاز").Distinct().ToList();
HashSet<string> ReturnedSet(ServiceDevice d){if(!ReturnedSelections.TryGetValue(d.Id,out var set)){set=new HashSet<string>(d.ReturnedAccessories.Split(';',StringSplitOptions.RemoveEmptyEntries));ReturnedSelections[d.Id]=set;}return set;}
bool HasReturnedAccessory(ServiceDevice d,string a)=>ReturnedSet(d).Contains(a);
Dictionary<string,string> AccessoryReasons(ServiceDevice d){try{return JsonSerializer.Deserialize<Dictionary<string,string>>(d.AccessoryReturnReasons)??new();}catch{return new();}}
string GetAccessoryReason(ServiceDevice d,string a)=>AccessoryReasons(d).TryGetValue(a,out var r)?r:"";
void SetAccessoryReason(ServiceDevice d,string a,string reason){var map=AccessoryReasons(d);map[a]=reason;d.AccessoryReturnReasons=JsonSerializer.Serialize(map);}
bool AccessoriesValid(ServiceDevice d){foreach(var a in GetAccessories(d))if(!HasReturnedAccessory(d,a)&&string.IsNullOrWhiteSpace(GetAccessoryReason(d,a)))return false;return true;}

void SetNoParts(ServiceDevice d,bool on){d.ConsumedParts=on?"لم يتم استخدام قطع غيار":string.Empty;}
void ToggleReturnedAccessory(ServiceDevice d,string a,bool on){var set=ReturnedSet(d);if(on)set.Add(a);else set.Remove(a);}
List<TestItem> GetTests(ServiceDevice d){if(!string.IsNullOrWhiteSpace(d.MaintenanceTestsJson))try{return JsonSerializer.Deserialize<List<TestItem>>(d.MaintenanceTestsJson)??Defaults(d.Model);}catch{}return Defaults(d.Model);}
List<TestItem> Defaults(string m)=>m.Contains("500")?new(){new("تشغيل الجهاز",0),new("اختبار الرش",90),new("الإضاءة",0),new("التسريب",120),new("الفحص النهائي",60)}:new(){new("تشغيل الجهاز",0),new("اختبار الرش",60),new("الإضاءة",0),new("التسريب",90),new("الفحص النهائي",45)};
async Task StartTest(int id,string name){await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.FirstOrDefaultAsync(x=>x.Id==id&&x.AssignedTechnicianId==CurrentUser!.Id);if(d is null)return;var tests=GetTests(d);var t=tests.FirstOrDefault(x=>x.Name==name);if(t is null||t.StartedAt.HasValue)return;t.StartedAt=DateTime.Now;d.MaintenanceTestsJson=JsonSerializer.Serialize(tests);await db.SaveChangesAsync();await Load();}
async Task SetTestResult(int id,string name,bool works){await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.FirstOrDefaultAsync(x=>x.Id==id&&x.AssignedTechnicianId==CurrentUser!.Id);if(d is null)return;var tests=GetTests(d);var t=tests.FirstOrDefault(x=>x.Name==name);if(t is null||!t.StartedAt.HasValue||t.CompletedAt.HasValue)return;t.Works=works;t.CompletedAt=DateTime.Now;d.MaintenanceTestsJson=JsonSerializer.Serialize(tests);await db.SaveChangesAsync();await Load();}
List<SparePart> GetPartsForDevice(ServiceDevice d)=>SpareParts.Where(p=>string.IsNullOrWhiteSpace(p.CompatibleDeviceModel)||p.CompatibleDeviceModel==d.Model).ToList();
int GetPartQty(int deviceId,int partId)=>PartSelections.TryGetValue(deviceId,out var map)&&map.TryGetValue(partId,out var qty)?qty:0;
void SetPartQty(int deviceId,int partId,string? raw){if(!PartSelections.TryGetValue(deviceId,out var map)){map=new();PartSelections[deviceId]=map;}if(!int.TryParse(raw,out var qty))qty=0;qty=Math.Max(0,qty);var part=SpareParts.FirstOrDefault(x=>x.Id==partId);if(part is not null)qty=Math.Min(qty,part.StockQuantity);if(qty==0)map.Remove(partId);else map[partId]=qty;}
string BuildConsumedParts(ServiceDevice d){if(d.ConsumedParts=="لم يتم استخدام قطع غيار")return d.ConsumedParts;if(!PartSelections.TryGetValue(d.Id,out var map)||map.Count==0)return "لم يتم استخدام قطع غيار";return string.Join("; ",map.Select(k=>{var p=SpareParts.FirstOrDefault(x=>x.Id==k.Key);return p is null?"":$"{p.Name}{(string.IsNullOrWhiteSpace(p.Color)?"":" - "+p.Color)} | {k.Value}";}).Where(x=>!string.IsNullOrWhiteSpace(x)));}

bool CanComplete(ServiceDevice d,List<TestItem> tests){if(tests is null||tests.Count==0)return false;if(tests.Any(x=>!x.CompletedAt.HasValue))return false;if(string.IsNullOrWhiteSpace(d.MaintenanceResult))return false;if(d.TechnicianDecision=="بدء الصيانة"){if(string.IsNullOrWhiteSpace(d.FaultCause)||string.IsNullOrWhiteSpace(d.RepairAction))return false;}if(!AccessoriesValid(d))return false;return true;}
async Task ResetTest(int id,string name){await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.FirstOrDefaultAsync(x=>x.Id==id&&x.AssignedTechnicianId==CurrentUser!.Id);if(d is null)return;var tests=GetTests(d);var t=tests.FirstOrDefault(x=>x.Name==name);if(t is null)return;t.CompletedAt=null;t.Works=null;t.StartedAt=DateTime.Now;d.MaintenanceTestsJson=JsonSerializer.Serialize(tests);await db.SaveChangesAsync();await Load();}
async Task CompleteMaintenance(ServiceDevice ui){await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.FirstOrDefaultAsync(x=>x.Id==ui.Id&&x.AssignedTechnicianId==CurrentUser!.Id);if(d is null)return;d.FaultCause=ui.FaultCause;d.RepairAction=ui.RepairAction;d.ConsumedParts=BuildConsumedParts(ui);d.MaintenanceResult=ui.MaintenanceResult;
if(d.TechnicianDecision=="بدء الصيانة"&&d.ConsumedParts!="لم يتم استخدام قطع غيار"&&PartSelections.TryGetValue(d.Id,out var selectedParts)&&selectedParts.Count>0){foreach(var sel in selectedParts){var part=await db.SpareParts.FirstOrDefaultAsync(x=>x.Id==sel.Key&&x.IsActive);if(part is null||part.StockQuantity<sel.Value){Message=$"خطأ: الرصيد غير كافٍ للقطعة المطلوبة.";return;}}}d.ReturnedAccessories=string.Join(";",ReturnedSet(ui));d.AccessoryReturnReasons=ui.AccessoryReturnReasons;var tests=GetTests(d);if(tests.Any(x=>!x.CompletedAt.HasValue)){Message="خطأ: يجب إكمال جميع الاختبارات أولاً.";return;}if(!AccessoriesValid(d)){Message="خطأ: يجب تسجيل سبب لكل ملحق لم يتم إرجاعه.";return;}if(string.IsNullOrWhiteSpace(d.MaintenanceResult)){Message="خطأ: يجب اختيار النتيجة النهائية.";return;}if(d.TechnicianDecision=="بدء الصيانة"&&(string.IsNullOrWhiteSpace(d.FaultCause)||string.IsNullOrWhiteSpace(d.RepairAction))){Message="خطأ: يجب تسجيل سبب العطل والإجراء قبل إنهاء الصيانة.";return;}if(d.TechnicianDecision=="بدء الصيانة"&&string.IsNullOrWhiteSpace(d.ConsumedParts))d.ConsumedParts="لم يتم استخدام قطع غيار";if(string.IsNullOrWhiteSpace(d.MaintenanceTechnicianName))d.MaintenanceTechnicianName=CurrentUser.FullName;d.MaintenanceCompletedAt=DateTime.Now;var failedTests=tests.Where(x=>x.Works==false).Select(x=>x.Name).ToList();if(d.MaintenanceRoute=="صيانة محلية"){if(failedTests.Any()||d.MaintenanceResult=="غير قابل للإصلاح"||d.MaintenanceResult=="ما زالت المشكلة قائمة"){d.CurrentStatus="تعذر الصيانة المحلية";d.CurrentLocation=d.ServiceRequest?.Branch??"الفرع";d.LocalMaintenanceFailureReason=failedTests.Any()?"فشل اختبارات إلزامية: "+string.Join("، ",failedTests):d.MaintenanceResult;d.AssignedTechnicianId=null;d.AssignedTechnicianName="";d.MaintenancePaused=false;d.Decision="جاهز للإرسال";db.Notifications.Add(new Notification{Message=$"تعذر إصلاح الجهاز {d.DeviceCode} محليًا. الجهاز موجود بالفرع وجاهز لإرساله لمركز الصيانة.",TargetUrl=$"/service-requests/{d.ServiceRequestId}",Type="warning"});}else{d.CurrentStatus="تمت الصيانة محليًا";d.CurrentLocation=d.ServiceRequest?.Branch??"الفرع";d.LocalMaintenanceCompletedAt=DateTime.Now;d.AssignedTechnicianId=null;d.AssignedTechnicianName="";d.Decision="صيانة محلية مكتملة";}}else if(d.MaintenanceResult=="غير قابل للإصلاح"||d.MaintenanceResult=="ما زالت المشكلة قائمة"){d.MaintenanceCompletedAt=null;d.CurrentStatus="معلق";d.CurrentLocation="مركز الصيانة";d.MaintenancePaused=true;d.MaintenancePauseReason=d.MaintenanceResult=="غير قابل للإصلاح"?"الفني أفاد أن الجهاز غير قابل للإصلاح — بانتظار قرار المشرف":"الفني أفاد أن المشكلة ما زالت قائمة بعد الصيانة — بانتظار قرار المشرف";d.AssignedTechnicianId=null;d.AssignedTechnicianName="";db.Notifications.Add(new Notification{Message=d.MaintenanceResult=="غير قابل للإصلاح"?$"الفني {CurrentUser!.FullName} أفاد أن الجهاز {d.DeviceCode} غير قابل للإصلاح. الجهاز عاد للمشرف لاتخاذ القرار: استبدال أو إعادة للفني أو إرجاع للفرع بدون صيانة.":$"الفني {CurrentUser!.FullName} أفاد أن مشكلة الجهاز {d.DeviceCode} ما زالت قائمة رغم الصيانة. الجهاز عاد للمشرف لاتخاذ القرار.",TargetUrl="/service-requests/receiving",Type="warning"});}else if(failedTests.Any()){d.CurrentStatus="معلق";d.CurrentLocation="مركز الصيانة";d.MaintenancePaused=true;d.MaintenancePauseReason="فشل اختبارات إلزامية: "+string.Join("، ",failedTests);d.AssignedTechnicianId=null;d.AssignedTechnicianName="";db.Notifications.Add(new Notification{Message=$"الجهاز {d.DeviceCode} انتهت أعماله لكن توجد اختبارات غير ناجحة ويحتاج قرار المشرف: {string.Join("، ",failedTests)}",TargetUrl="/service-requests/receiving",Type="warning"});}else{d.CurrentStatus="جاهز للإرسال";d.CurrentLocation="مستودع الأجهزة الجاهزة للإرجاع";d.AssignedTechnicianId=null;d.AssignedTechnicianName="";}var postponed=await db.ServiceDevices.Where(x=>x.ServiceRequestId==d.ServiceRequestId&&x.Decision=="مؤجل للإرسال").ToListAsync();foreach(var p in postponed)p.Decision="جاهز للإرسال";if(!failedTests.Any()&&d.MaintenanceRoute!="صيانة محلية"){d.CurrentLocation="مستودع الأجهزة الجاهزة للإرجاع";}if(d.TechnicianDecision=="بدء الصيانة"&&!d.SparePartsDeducted&&PartSelections.TryGetValue(d.Id,out var finalParts)&&finalParts.Count>0){foreach(var sel in finalParts){var part=await db.SpareParts.FirstOrDefaultAsync(x=>x.Id==sel.Key);if(part is null||part.StockQuantity<sel.Value){Message=$"خطأ: تغيّر رصيد إحدى القطع قبل الحفظ ولم يعد كافيًا. أعد المحاولة.";return;}part.StockQuantity-=sel.Value;db.SparePartUsages.Add(new SparePartUsage{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,SparePartId=part.Id,Quantity=sel.Value,TechnicianName=d.MaintenanceTechnicianName,UsedAt=DateTime.Now});db.SparePartMovements.Add(new SparePartMovement{SparePartId=part.Id,MovementType="استهلاك",Quantity=sel.Value,MovementDate=DateTime.Now,Location=d.ServiceRequest?.Branch??"مركز الصيانة",TechnicianName=d.MaintenanceTechnicianName,ServiceDeviceId=d.Id,DeviceModel=d.Model,DeviceCode=d.DeviceCode,Notes=$"استهلاك أثناء صيانة الطلب {d.ServiceRequestId}."});}d.SparePartsDeducted=true;}
var request=await db.ServiceRequests.Include(x=>x.Devices).FirstOrDefaultAsync(x=>x.Id==d.ServiceRequestId);if(request is not null){if(d.MaintenanceRoute=="صيانة محلية"&&failedTests.Any()){request.ApprovedAt=null;request.DispatchReportPrintedAt=null;}request.Status=RequestStatusHelper.Calculate(request.Devices);}db.DeviceStatusHistories.Where(x=>x.ServiceDeviceId==d.Id&&x.EndedAt==null&&(x.Status=="جاري الصيانة"||x.Status=="فحص بدون صيانة"||x.Status=="جاري الصيانة محليًا")).ToList().ForEach(x=>x.EndedAt=DateTime.Now);db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status=d.CurrentStatus,Location=d.CurrentLocation,StartedAt=DateTime.Now,ChangedBy=CurrentUser!.FullName,Notes=$"النتيجة: {d.MaintenanceResult}; العطل: {d.FaultCause}; الإجراء: {d.RepairAction}; القطع: {d.ConsumedParts}"});await db.SaveChangesAsync();Message=d.MaintenanceRoute=="صيانة محلية"?(failedTests.Any()?"تعذر الإصلاح محليًا وتمت إعادة الجهاز للفرع ليكون جاهزًا للإرسال إلى مركز الصيانة.":"تمت الصيانة محليًا والجهاز ما زال في الفرع وجاهز لتسليمه للعميل."):d.MaintenanceResult=="غير قابل للإصلاح"?"تم تسجيل أن الجهاز غير قابل للإصلاح وتحويله إلى المشرف لاتخاذ القرار. لم يتم إنهاء دورة الجهاز بعد.":d.MaintenanceResult=="ما زالت المشكلة قائمة"?"تم تسجيل أن المشكلة ما زالت قائمة وتحويل الجهاز إلى المشرف لاتخاذ القرار. لم يتم إنهاء دورة الجهاز بعد.":(failedTests.Any()?"تم إنهاء عمل الفني وتحويل الجهاز للمشرف بسبب فشل اختبار إلزامي.":"تم إنهاء العملية ونقل الجهاز إلى مستودع الأجهزة الجاهزة للإرسال.");await Load();}
async Task AcceptLocalTask(int id){if(!IsMobileTechnician||CurrentUser is null)return;await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.Include(x=>x.ServiceRequest).FirstOrDefaultAsync(x=>x.Id==id&&x.AssignedTechnicianId==CurrentUser.Id&&x.MaintenanceRoute=="صيانة محلية"&&x.CurrentStatus=="جاهز للصيانة");if(d is null){Message="خطأ: المهمة لم تعد متاحة.";await Load();return;}var now=DateTime.Now;d.TechnicianReceivedAt=now;d.MaintenanceStartedAt=now;d.TechnicianDecision="بدء الصيانة";d.MaintenanceTechnicianName=CurrentUser.FullName;d.CurrentStatus="جاري الصيانة محليًا";d.MaintenanceTestsJson=JsonSerializer.Serialize(Defaults(d.Model));db.DeviceStatusHistories.Where(x=>x.ServiceDeviceId==d.Id&&x.EndedAt==null&&x.Status=="جاهز للصيانة").ToList().ForEach(x=>x.EndedAt=now);db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="جاري الصيانة محليًا",Location=d.ServiceRequest?.Branch??"الفرع",StartedAt=now,ChangedBy=CurrentUser.FullName,Notes="استلام الفني المتنقل للجهاز وبدء الصيانة."});await db.SaveChangesAsync();Message="تم استلام الجهاز وبدء الصيانة.";await Load();}
void OpenLocalFailure(int id){LocalFailureDeviceId=id;LocalFailureReason="";}
void CloseLocalFailure(){LocalFailureDeviceId=null;LocalFailureReason="";}
async Task ConfirmLocalFailure(){if(LocalFailureDeviceId is null||string.IsNullOrWhiteSpace(LocalFailureReason)){Message="خطأ: يجب تسجيل سبب تعذر الصيانة المحلية.";return;}await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.Include(x=>x.ServiceRequest).FirstOrDefaultAsync(x=>x.Id==LocalFailureDeviceId&&x.AssignedTechnicianId==CurrentUser!.Id);if(d is null||d.MaintenanceRoute!="صيانة محلية")return;d.CurrentLocation=d.ServiceRequest?.Branch??"الفرع";d.CurrentStatus="تعذر الصيانة المحلية";d.LocalMaintenanceFailureReason=LocalFailureReason;d.MaintenancePaused=false;d.AssignedTechnicianId=null;d.AssignedTechnicianName="";d.Decision="جاهز للإرسال";db.DeviceStatusHistories.Where(x=>x.ServiceDeviceId==d.Id&&x.EndedAt==null).ToList().ForEach(x=>x.EndedAt=DateTime.Now);db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="تعذر الصيانة المحلية",Location=d.CurrentLocation,StartedAt=DateTime.Now,ChangedBy=CurrentUser!.FullName,Notes="سبب تعذر الصيانة المحلية: "+LocalFailureReason});var req=await db.ServiceRequests.Include(x=>x.Devices).FirstOrDefaultAsync(x=>x.Id==d.ServiceRequestId);if(req is not null){req.ApprovedAt=null;req.DispatchReportPrintedAt=null;req.Status=RequestStatusHelper.Calculate(req.Devices);}db.Notifications.Add(new Notification{Message=$"تعذر إصلاح الجهاز {d.DeviceCode} محليًا وهو الآن جاهز بالفرع لإرساله إلى مركز الصيانة.",TargetUrl=$"/service-requests/{d.ServiceRequestId}",Type="warning"});await db.SaveChangesAsync();CloseLocalFailure();Message="تمت إعادة الجهاز للفرع وتجهيزه للإرسال إلى مركز الصيانة.";await Load();}
void OpenPause(int id){PauseDeviceId=id;PauseReason="";PauseNotes="";}
void ClosePause(){PauseDeviceId=null;PauseReason="";PauseNotes="";}
async Task ConfirmPause(){if(PauseDeviceId is null||CurrentUser is null)return;if(string.IsNullOrWhiteSpace(PauseReason)){Message="خطأ: يجب اختيار سبب تعليق الصيانة.";return;}if(PauseReason=="سبب آخر"&&string.IsNullOrWhiteSpace(PauseNotes)){Message="خطأ: يجب كتابة تفاصيل السبب.";return;}await PauseMaintenance(PauseDeviceId.Value,PauseReason,PauseNotes);ClosePause();}
async Task PauseMaintenance(int id,string reason="",string notes=""){await using var db=await DbFactory.CreateDbContextAsync();var d=await db.ServiceDevices.FirstOrDefaultAsync(x=>x.Id==id&&x.AssignedTechnicianId==CurrentUser!.Id);if(d is null)return;d.CurrentStatus="معلق";d.MaintenancePaused=true;d.AssignedTechnicianId=null;d.AssignedTechnicianName="";db.DeviceStatusHistories.Where(x=>x.ServiceDeviceId==d.Id&&x.EndedAt==null).ToList().ForEach(x=>x.EndedAt=DateTime.Now);db.DeviceStatusHistories.Add(new DeviceStatusHistory{ServiceDeviceId=d.Id,ServiceRequestId=d.ServiceRequestId,Status="معلق",Location="مركز الصيانة",StartedAt=DateTime.Now,ChangedBy=CurrentUser.FullName,Notes=$"سبب التعليق: {reason}"+(string.IsNullOrWhiteSpace(notes)?"":$" — {notes}")});var request=await db.ServiceRequests.FindAsync(d.ServiceRequestId);if(request is not null)request.Status="معلق - بانتظار قرار المشرف";db.Notifications.Add(new Notification{Message=$"الجهاز {d.DeviceCode} تم تعليق صيانته بسبب: {reason} ويحتاج قرار المشرف.",TargetUrl="/service-requests/receiving",Type="warning"});await db.SaveChangesAsync();Message="تم تعليق الصيانة وتحويل الجهاز لقرار المشرف.";await Load();}
